# ----------------------------------------------------------------------------
# Virya merch shop — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.development` (local) and set the same keys in the
# Netlify dashboard (Site settings → Environment variables) for production.
# `.env*` is git-ignored — never commit real secrets.
#
# PUBLIC_ prefixed vars are exposed to the browser by Astro (public values only).
# Everything else is server-side (Astro / Netlify Functions) and stays secret.

# --- Stripe -----------------------------------------------------------------
# Dashboard → Developers → API keys. Use sk_test_/pk_test_ until you go live.
STRIPE_SECRET_KEY=sk_test_xxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Required. Signing secret for this endpoint from Stripe CLI or the dashboard.
# Unsigned webhook requests are always rejected.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- InPost -----------------------------------------------------------------
# ShipX API token (server-side; used to create shipments after payment).
INPOST_SHIPX_TOKEN=
# Geowidget token (exposed to the browser to render the Paczkomat map).
# MUST be a dedicated *Geowidget* token from InPost ManageR (Tokeny do Geowidgetu).
# A ShipX API token will NOT work here — the map shows "Token nieprawidłowy".
PUBLIC_INPOST_GEOWIDGET_TOKEN=
# Your InPost organization id. If set, shipments are created automatically.
# Leave empty to instead create labels manually in InPost ManageR.
INPOST_ORGANIZATION_ID=
# ShipX environment: "production" (default) or "sandbox".
INPOST_ENV=production

# --- Order notification email (nodemailer + Gmail SMTP) ---------------------
# The Gmail account orders are sent FROM and TO. Generate an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=virya.crew@gmail.com
GMAIL_APP_PASSWORD=
# Where order notifications are delivered (defaults to GMAIL_USER if unset).
ORDER_EMAIL_TO=virya.crew@gmail.com

# --- Site -------------------------------------------------------------------
# Public base URL, used to build Stripe success/cancel redirect URLs.
SITE_URL=http://localhost:4321

# --- Bandsintown ------------------------------------------------------------
# App id for the shows feed. Has a working default; override if you have your own.
BANDSINTOWN_APP_ID=

# --- VIRYA Area -------------------------------------------------------------
# Server-only catalogue of physical drops. Exact coordinates and secrets must
# never use a PUBLIC_ prefix. A drop is invisible to claims until it is listed
# here and inside its optional activation window.
# Generate each secret with: openssl rand -hex 24
# AREA_LIVE_DROPS_JSON={"wro-001":{"secret":"replace-with-at-least-24-random-characters","lat":51.1079,"lng":17.0385,"radiusMeters":100,"maxClaims":25,"startsAt":"2026-08-01T10:00:00+02:00","endsAt":"2026-08-03T22:00:00+02:00"}}
AREA_LIVE_DROPS_JSON={}
