# ----------------------------------------------------------------------------
# Virya merch shop — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.development` (local) and set the same keys in the
# Netlify dashboard (Site settings → Environment variables) for production.
# `.env*` is git-ignored — never commit real secrets.
#
# PUBLIC_ prefixed vars are exposed to the browser by Astro (public values only).
# Everything else is server-side (Astro / Netlify Functions) and stays secret.

# --- Stripe -----------------------------------------------------------------
# Dashboard → Developers → API keys. Use sk_test_/pk_test_ until you go live.
STRIPE_SECRET_KEY=sk_test_xxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Required. Signing secret for this endpoint from Stripe CLI or the dashboard.
# Unsigned webhook requests are always rejected.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- InPost -----------------------------------------------------------------
# ShipX API token (server-side; used to create shipments after payment).
INPOST_SHIPX_TOKEN=
# Geowidget token (exposed to the browser to render the Paczkomat map).
# MUST be a dedicated *Geowidget* token from InPost ManageR (Tokeny do Geowidgetu).
# A ShipX API token will NOT work here — the map shows "Token nieprawidłowy".
PUBLIC_INPOST_GEOWIDGET_TOKEN=
# Your InPost organization id. If set, shipments are created automatically.
# Leave empty to instead create labels manually in InPost ManageR.
INPOST_ORGANIZATION_ID=
# ShipX environment: "production" (default) or "sandbox".
INPOST_ENV=production

# --- Order notification email (nodemailer + Gmail SMTP) ---------------------
# The Gmail account orders are sent FROM and TO. Generate an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=virya.crew@gmail.com
GMAIL_APP_PASSWORD=
# Where order notifications are delivered (defaults to GMAIL_USER if unset).
ORDER_EMAIL_TO=virya.crew@gmail.com

# --- Virya Signal transactional email --------------------------------------
# Recommended for production: MAIL_PROVIDER=resend with a verified sending
# subdomain (for example signal.virya.music). Gmail remains a local/fallback
# transport. SIGNAL_MAIL_FROM must belong to a domain verified by the provider.
MAIL_PROVIDER=auto
RESEND_API_KEY=
SIGNAL_MAIL_FROM=hello@signal.virya.music
SIGNAL_MAIL_REPLY_TO=kontakt@virya.music

# --- Site -------------------------------------------------------------------
# Public base URL, used to build Stripe success/cancel redirect URLs.
SITE_URL=http://localhost:4321

# --- Bandsintown ------------------------------------------------------------
# App id for the shows feed. Has a working default; override if you have your own.
BANDSINTOWN_APP_ID=

# --- VIRYA Area -------------------------------------------------------------
# Server-only catalogue of live GPS zones. Exact coordinates must never use a
# PUBLIC_ prefix. A drop is claimable only while listed here and inside its
# optional activation window.
# AREA_LIVE_DROPS_JSON={"wro-001":{"lat":51.1079,"lng":17.0385,"radiusMeters":80,"maxClaims":25,"startsAt":"2026-08-01T10:00:00+02:00","endsAt":"2026-08-03T22:00:00+02:00"}}
AREA_LIVE_DROPS_JSON={}

# Optional free-admission rewards redeemable with VIRYA Area Credits. The pool
# defaults to the first-party ticket pool `paid-tickets`. The supplied e-mail
# must already belong to an active Virya Signal fan.
# AREA_TICKET_REWARDS_JSON={"gig-example":{"poolSlug":"paid-tickets","credits":1,"title":"Virya live — Wrocław","startsAt":"2026-10-10T19:00:00+02:00","active":true}}
AREA_TICKET_REWARDS_JSON={}

# Required for magic-link sessions and signed player identities. Generate with:
# openssl rand -hex 32
AREA_AUTH_SECRET=

# Optional dedicated HMAC secret for anonymous Signal feedback rate limiting.
# When omitted, AREA_AUTH_SECRET is reused. The raw client address is never
# persisted by application code. Generate with: openssl rand -hex 32
SIGNAL_FEEDBACK_RATE_SECRET=

# Optional dedicated HMAC secret for short-lived GPS challenges. When omitted,
# AREA_AUTH_SECRET is reused. In production prefer a separate 32+ byte secret.
# openssl rand -hex 32
AREA_CHALLENGE_SECRET=

# Public Virya Signal API (no privileged keys belong in PUBLIC_* variables)
PUBLIC_CROWDRELAY_API_URL=https://signal-api.virya.music/v1/

# --- Virya staff concert QR panel ------------------------------------------
# Server-only CrowdRelay admin key. It is used by Netlify Functions and is
# never sent to the browser. Must match CrowdRelay CROWDRELAY_ADMIN_API_KEY.
CROWDRELAY_ADMIN_API_KEY=

# Server-only CrowdRelay staff key used only to mint the current Virya Signal
# compatibility pairing QR after password authentication. It must match
# CrowdRelay CROWDRELAY_STAFF_API_KEY and must never use a PUBLIC_* prefix.
CROWDRELAY_STAFF_API_KEY=

# Server-only key used for Stripe ticket reconciliation. Must match
# CrowdRelay CROWDRELAY_COMMERCE_API_KEY; never expose it as PUBLIC_*.
CROWDRELAY_COMMERCE_API_KEY=
# SHA-256 of the staff-panel password, lowercase hex. Generate without putting
# the plaintext password in shell history:
# read -s QR_PASSWORD; printf %s "$QR_PASSWORD" | shasum -a 256
STAFF_QR_PASSWORD_SHA256=
# Independent 32+ byte secret signing the 12-hour HttpOnly staff session.
# openssl rand -hex 32
STAFF_QR_SESSION_SECRET=

# --- CrowdRelay → Virya signed webhook --------------------------------------
# Shared HMAC secret used by CrowdRelay to sign fan confirmation events and by
# Virya to verify them. Generate once with: openssl rand -hex 32
# Store the same value in Netlify and CrowdRelay; never expose it as PUBLIC_*.
CROWDRELAY_WEBHOOK_SECRET=

# n8n → Virya generic CrowdRelay template mailer. Generate a separate
# random 32+ byte value and store the same value in n8n as
# CROWDRELAY_MAILER_TOKEN. Never expose it as PUBLIC_*.
CROWDRELAY_MAILER_API_KEY=

# Canonical public site URL used in confirmation and account emails.
PUBLIC_SITE_URL=https://virya.music

# n8n → Virya ticket mail adapter. Use a random 32+ byte value and store the
# same secret in the n8n HTTP Header Auth credential. Never expose as PUBLIC_*.
VIRYA_TICKET_MAILER_API_KEY=
