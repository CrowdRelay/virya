{
  "name": "virya-website",
  "private": true,
  "description": "Static-first Astro site for Virya: music, merch, fan Signal, AREA field game and concert operations.",
  "version": "1.0.0",
  "author": "Virya <virya.crew@gmail.com>",
  "type": "module",
  "bugs": {
    "url": "https://github.com/CrowdRelay/virya"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.1",
    "@astrojs/preact": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/blobs": "^10.7.13",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "nodemailer": "^9.0.5",
    "preact": "^10.29.8",
    "qrcode-generator": "2.0.4",
    "stripe": "^22.5.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "homepage": "https://www.virya.music",
  "keywords": [
    "virya",
    "modern metal",
    "astro",
    "preact",
    "stripe",
    "crowdrelay",
    "geolocation",
    "pwa"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowdRelay/virya.git"
  },
  "scripts": {
    "gen:placeholders": "node scripts/gen-placeholders.mjs",
    "predev": "node scripts/gen-placeholders.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/gen-placeholders.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro dev",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,json,md}\"",
    "check": "tsc --noEmit",
    "audit:area": "node scripts/audit-area.mjs",
    "test": "npm run check && npm run test:unit && npm run audit:assets && npm run audit:area && npm run audit:signal && npm run audit:admin && npm run audit:live && npm run audit:ui && npm run audit:v2 && npm run audit:lighthouse && npm run audit:ci && npm run audit:size && npm run audit:bff && npm run audit:rum && npm run audit:release && npm run audit:jsonld && npm run audit:i18n && npm run audit:merch-pickup && npm run audit:synesthesia-fallback && npm run audit:gates",
    "audit:signal": "node scripts/audit-signal.mjs",
    "audit:admin": "node scripts/audit-admin.mjs",
    "audit:live": "node scripts/audit-live.mjs",
    "test:unit": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "audit:assets": "node scripts/audit-assets.mjs",
    "budget:build": "node scripts/check-build-budget.mjs dist",
    "quality": "npm test && npm run build && npm run budget:build",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:ci": "python3 scripts/check-ci-policy.py",
    "audit:size": "python3 scripts/source-size-ratchet.py",
    "audit:bff": "node scripts/check-api-route-budget.mjs",
    "audit:rum": "node scripts/audit-rum.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:jsonld": "node scripts/audit-json-ld.mjs",
    "audit:i18n": "node scripts/audit-i18n-parity.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "audit:v2": "node scripts/audit-v2.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:merch-pickup": "node scripts/test-merch-event-pickup.mjs",
    "audit:synesthesia-fallback": "python3 scripts/test_synesthesia_signal_fallback_contract.py",
    "audit:gates": "node scripts/check-contract-gate-coverage.mjs"
  },
  "overrides": {
    "ipx": {
      "sharp": "0.35.3"
    }
  }
}
