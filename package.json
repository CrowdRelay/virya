{
  "name": "virya-website",
  "private": true,
  "description": "Static-first Astro site for Virya: music, merch, fan Signal, AREA field game and concert operations.",
  "version": "1.0.0",
  "author": "Virya <virya.crew@gmail.com>",
  "type": "module",
  "bugs": {
    "url": "https://github.com/CrowdRelay/virya"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.1",
    "@astrojs/preact": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/blobs": "^10.7.13",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "nodemailer": "^9.0.5",
    "preact": "^10.29.8",
    "qrcode-generator": "2.0.4",
    "stripe": "^22.5.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  },
  "homepage": "https://www.virya.music",
  "keywords": [
    "virya",
    "modern metal",
    "astro",
    "preact",
    "stripe",
    "crowdrelay",
    "geolocation",
    "pwa"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowdRelay/virya.git"
  },
  "scripts": {
    "gen:placeholders": "node scripts/gen-placeholders.mjs",
    "predev": "node scripts/gen-placeholders.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/gen-placeholders.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro dev",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,json,md}\"",
    "check": "tsc --noEmit",
    "test": "npm run check && npm run test:unit",
    "test:unit": "node --no-warnings=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "quality": "npm test && npm run security:audit && npm run build",
    "security:audit": "node scripts/audit-dependencies.mjs"
  },
  "overrides": {
    "ipx": {
      "sharp": "0.35.3"
    }
  }
}
