---
---

<div class="absolute inset-0 z-0 overflow-hidden">
  <video
    id="hero-video"
    class="absolute inset-0 w-full h-full object-cover"
    muted
    loop
    playsinline
    poster="/poster.webp"
    preload="none"
    fetchpriority="low"
    aria-hidden="true"
  >
    <source src="/rise.webm" type="video/webm" />
    <source src="/rise.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-black/60" aria-hidden="true"></div>
</div>

<script>
  function initHeroVideo() {
    const video = document.getElementById("hero-video") as HTMLVideoElement | null
    if (!video || video.dataset.viryaInitialized === "true") return
    video.dataset.viryaInitialized = "true"
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return

    const connection = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string }
    }).connection
    if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? "")) return

    let started = false
    const startVideo = () => {
      if (started || !video.isConnected) return
      if (document.visibilityState !== "visible") {
        document.addEventListener("visibilitychange", startVideo, { once: true })
        return
      }
      started = true
      video.muted = true
      const tryPlay = () => video.play().catch(() => {})
      if (video.readyState >= 2) {
        tryPlay()
      } else {
        video.load()
        video.addEventListener("loadeddata", tryPlay, { once: true })
      }
    }

    // Give the static poster + hero copy two paint opportunities before the
    // large decorative video starts competing for decode/network resources.
    requestAnimationFrame(() => requestAnimationFrame(startVideo))
  }

  initHeroVideo()
  document.addEventListener("astro:page-load", initHeroVideo)
</script>
