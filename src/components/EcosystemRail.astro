---
import { lp, type Lang } from "../i18n/t"
const { lang = "en", active = "signal" } = Astro.props as { lang?: Lang; active?: "live" | "signal" | "area" | "merch" }
const copy = lang === "pl" ? {
  eyebrow: "Jeden ekosystem Viryi",
  title: "Koncert nie kończy się na bilecie.",
  body: "Bilet, Sygnał, polecenia, Gra i merch korzystają z jednego profilu fana i jednej historii aktywności.",
  items: [
    ["live", "Koncerty i bilety", "Kup wejściówkę albo zaznacz zainteresowanie.", lp(lang, "/signal/#events")],
    ["signal", "Mój Sygnał", "Miasta, polecenia, wejściówki i prywatny profil.", lp(lang, "/my-signal/")],
    ["area", "Gra Virya", "Odkrywaj sygnały i wymieniaj kredyty na nagrody.", lp(lang, "/area/")],
    ["merch", "Merch", "Albumy i rzeczy, które możesz odblokować w ekosystemie.", lp(lang, "/merch/")],
  ],
} : {
  eyebrow: "One Virya ecosystem",
  title: "The show does not end at the ticket.",
  body: "Tickets, Signal, referrals, AREA and merch share one fan profile and one activity history.",
  items: [
    ["live", "Shows & tickets", "Buy a pass or register your interest.", lp(lang, "/signal/#events")],
    ["signal", "My Signal", "Cities, referrals, passes and your private profile.", lp(lang, "/my-signal/")],
    ["area", "Virya AREA", "Find signals and exchange credits for rewards.", lp(lang, "/area/")],
    ["merch", "Merch", "Albums and items unlocked across the ecosystem.", lp(lang, "/merch/")],
  ],
}
---
<section aria-labelledby="virya-ecosystem-title" class="border-y border-white/5 bg-black/35 px-4 py-14 sm:px-6 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <p class="text-[10px] font-black uppercase tracking-[.32em] text-amber-400">{copy.eyebrow}</p>
    <div class="mt-3 grid gap-4 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
      <div><h2 id="virya-ecosystem-title" class="text-3xl font-black tracking-tight text-white sm:text-4xl">{copy.title}</h2><p class="mt-3 max-w-xl text-sm leading-6 text-zinc-400">{copy.body}</p></div>
      <nav aria-label={copy.eyebrow} class="grid gap-2 sm:grid-cols-2">
        {copy.items.map(([key, label, description, href]) => (
          <a href={href} aria-current={active === key ? "page" : undefined} class:list={["group rounded-2xl border p-4 transition", active === key ? "border-amber-400/45 bg-amber-400/10" : "border-white/8 bg-zinc-900/60 hover:border-white/20 hover:bg-zinc-900"]}>
            <span class:list={["text-sm font-black", active === key ? "text-amber-200" : "text-white"]}>{label}</span>
            <span class="mt-1 block text-xs leading-5 text-zinc-500 group-hover:text-zinc-400">{description}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>
