---
import { SIGNAL_COPY } from "../data/signalCopy"
import { lp, type Lang } from "../i18n/t"

interface Props {
  lang?: Lang
}

const { lang = "en" } = Astro.props
const copy = SIGNAL_COPY[lang].manager
---

<section class="virya-panel border-amber-400/25 bg-amber-400/[.035] p-5 sm:p-7">
  <p class="virya-eyebrow">{copy.eyebrow}</p>
  <h2 class="mt-3 text-2xl font-black uppercase leading-tight tracking-tight text-white sm:text-3xl">{copy.heading}</h2>
  <p class="mt-4 text-sm leading-relaxed text-zinc-300 text-justify mobile-justify">{copy.body}</p>

  <div class="mt-7 grid gap-px border border-zinc-800 bg-zinc-800 sm:grid-cols-2">
    {copy.points.map((point, index) => (
      <div class="bg-zinc-950 p-4">
        <p class="font-mono text-[8px] font-black tracking-[.2em] text-amber-400">0{index + 1}</p>
        <h3 class="mt-3 text-sm font-black uppercase tracking-widest text-white">{point.title}</h3>
        <p class="mt-2 text-xs leading-relaxed text-zinc-400">{point.body}</p>
      </div>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a href={lp(lang, "/signal/")} class="virya-button virya-button--primary">
      {copy.signal}
    </a>
    <a href={lp(lang, "/area/")} class="virya-button virya-button--secondary">
      {copy.area}
    </a>
  </div>
</section>
