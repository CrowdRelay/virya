---
import { AREA_DROPS as FALLBACK_AREA_DROPS } from "../data/area"
import { getPublicAreaDrops } from "../server/crowdrelayArea"
import { AREA_COPY } from "../data/areaCopy"
import { SIGNAL_COPY } from "../data/signalCopy"
import { lp, type Lang } from "../i18n/t"
import AreaTicketRewards from "./preact/area/AreaTicketRewards"
import EcosystemRail from "./EcosystemRail.astro"

interface Props {
  lang?: Lang
}

const { lang = "en" } = Astro.props
const copy = AREA_COPY[lang] ?? AREA_COPY.en
const signalCopy = SIGNAL_COPY[lang] ?? SIGNAL_COPY.en
let areaDrops = FALLBACK_AREA_DROPS
let activeDropIds = new Set<string>()
try {
  const backendDrops = await getPublicAreaDrops()
  if (backendDrops.length > 0) {
    areaDrops = backendDrops
    activeDropIds = new Set(
      backendDrops
        .filter(drop => drop.active && !drop.full)
        .map(drop => drop.id),
    )
  }
} catch (error) {
  console.warn("[area-page] using the build-safe AREA catalogue fallback", error)
}
const firstDrop =
  areaDrops.find(drop => activeDropIds.has(drop.id)) ??
  areaDrops[0] ??
  FALLBACK_AREA_DROPS[0]
const clientCopy = {
  live: copy.map.live,
  signal: copy.map.signal,
  claimed: copy.map.claimed,
  encrypted: copy.map.encrypted,
  coordinates: copy.map.coordinates,
  locationWorking: copy.map.locationWorking,
  locationDenied: copy.map.locationDenied,
  noLiveSignal:
    lang === "pl"
      ? "Teraz nie ma aktywnego sygnału. Wróć później — nie musisz niczego szukać na własną rękę."
      : "There is no live signal now. Come back later; do not search on your own.",
  nearestTemplate:
    lang === "pl"
      ? "{city} to Twój najbliższy sygnał — około {distance}."
      : "{city} is your nearest signal — about {distance} away.",
  claimWorking: copy.claim.working,
  claimCollecting: copy.claim.collecting,
  claimSuccess: copy.claim.success,
  claimAlready: copy.claim.already,
  claimGenericError: copy.claim.genericError,
  claimInactive: copy.claim.inactive,
  claimInvalidCode: copy.claim.invalidCode,
  claimAccuracy: copy.claim.accuracy,
  claimSamples: copy.claim.samples,
  claimOutside: copy.claim.outside,
  claimFull: copy.claim.full,
  claimRateLimited: copy.claim.rateLimited,
  claimAccountRequired: copy.claim.accountRequired,
  claimAccountCta: copy.claim.accountCta,
  claimAccountChecking: copy.claim.accountChecking,
  profileRequestWorking: copy.profile.requestWorking,
  profileRequestSent: copy.profile.requestSent,
  profileRequestError: copy.profile.requestError,
  profileVerifying: copy.profile.verifying,
  profileVerifySuccess: copy.profile.verifySuccess,
  profileVerifyError: copy.profile.verifyError,
  profileSignedInAs: copy.profile.signedInAs,
  profileSignOut: copy.profile.signOut,
  profileSignOutWorking: copy.profile.signOutWorking,
  profileSignOutError: copy.profile.signOutError,
  profileUnavailable: copy.profile.unavailable,
  walletLoading: copy.collection.loading,
  walletUnit: copy.collection.walletUnit,
  walletValue: copy.collection.walletValue,
  voucherButton: copy.collection.voucherButton,
  voucherWorking: copy.collection.voucherWorking,
  voucherEmpty: copy.collection.voucherEmpty,
  voucherSuccess: copy.collection.voucherSuccess,
  voucherError: copy.collection.voucherError,
  codeBenefit: copy.collection.codeBenefit,
  codeIssued: copy.collection.codeIssued,
  codeReserved: copy.collection.codeReserved,
  codeRedeemed: copy.collection.codeRedeemed,
  copyCode: copy.collection.copyCode,
  copied: copy.collection.copied,
  useInStore: lang === "pl" ? "Użyj w sklepie" : "Use in store",
  shareGeneric: copy.share.generic,
  shareClaimedTemplate:
    lang === "pl"
      ? "Namierzyłem sygnał VIRYA Area w {city} i odblokowałem „{line}”. Kto łapie następny? #ViryaArea #StayMad"
      : "I locked a VIRYA Area signal in {city} and unlocked “{line}”. Who catches the next one? #ViryaArea #StayMad",
  shareCopied: copy.share.copied,
  shareTitle: "VIRYA Area",
  locked: copy.collection.locked,
  unlocked: copy.collection.unlocked,
  recoveredOn: copy.collection.recoveredOn,
  editionNumber: copy.collection.editionNumber,
  riddle: copy.collection.riddle,
  artworkAlt: copy.collection.artworkAlt,
  artworkPending: copy.collection.artworkPending,
  communityProgress: copy.community.progress,
  communityLoading: copy.community.loading,
  communityUnavailable: copy.community.unavailable,
  communityComplete: copy.community.complete,
}
const safeClientCopy = JSON.stringify(clientCopy).replace(/</g, "\\u003c")
---

<main id="main-content" class="flex-1">
  <div data-area-experience data-lang={lang} data-signal-url={lp(lang, "/signal/")} data-merch-url={lp(lang, "/merch/")} class="area-experience min-w-0 overflow-x-clip">
    <script type="application/json" data-area-copy set:html={safeClientCopy}></script>

    <header class="area-hero relative flex min-h-[88svh] items-center overflow-hidden border-b border-zinc-800/60 px-4 pb-12 pt-[calc(6.5rem+env(safe-area-inset-top))] sm:px-6 sm:pb-16 sm:pt-32 lg:min-h-[88vh] lg:px-12">
      <div class="area-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
      <div class="absolute left-[8%] top-28 h-56 w-56 rounded-full bg-amber-400/10 blur-[100px]" aria-hidden="true"></div>
      <div class="relative mx-auto grid min-w-0 w-full max-w-7xl items-center gap-10 sm:gap-14 lg:grid-cols-[1.15fr_.85fr]">
        <div class="min-w-0">
          <p class="mb-5 max-w-full text-[11px] font-black uppercase leading-relaxed tracking-[0.18em] text-amber-400 sm:text-[11px] sm:tracking-[0.4em]">
            {copy.hero.eyebrow}
          </p>
          <h1 class="area-display-title max-w-4xl text-[clamp(2.4rem,10.8vw,3.6rem)] font-black uppercase leading-[.9] tracking-[-.04em] text-white sm:text-6xl lg:text-8xl">
            {copy.hero.title}
          </h1>
          <p class="mt-6 max-w-2xl text-[0.95rem] leading-relaxed text-zinc-300 sm:mt-7 sm:text-base lg:text-lg">
            {copy.hero.body}
          </p>
          <div class="mt-8 grid min-w-0 grid-cols-1 gap-3 sm:mt-9 sm:flex sm:flex-wrap">
            <a
              href="#area-map"
              class="inline-flex min-h-[48px] w-full min-w-0 items-center justify-center bg-amber-400 px-4 py-3 text-center text-[11px] font-black uppercase leading-snug tracking-[.15em] text-black transition-colors hover:bg-amber-300 sm:w-auto sm:px-6 sm:text-xs sm:tracking-widest"
            >
              {copy.hero.mapCta}
            </a>
            <a
              href="#area-collection"
              class="inline-flex min-h-[48px] w-full min-w-0 items-center justify-center border border-zinc-600 px-4 py-3 text-center text-[11px] font-black uppercase leading-snug tracking-[.15em] text-zinc-100 transition-colors hover:border-amber-400 hover:text-amber-400 sm:w-auto sm:px-6 sm:text-xs sm:tracking-widest"
            >
              {modeCopy.collectionCta}
            </a>
          </div>
          <ol class="mt-7 grid max-w-2xl grid-cols-1 gap-px border border-zinc-800 bg-zinc-800 sm:grid-cols-3" aria-label={copy.steps.heading}>
            {copy.steps.items.map((item: any) => (
              <li class="flex items-center gap-3 bg-zinc-950 px-4 py-3">
                <span class="font-mono text-[11px] text-amber-400">{item.number}</span>
                <span class="text-[11px] font-black uppercase tracking-wider text-zinc-200">{item.title}</span>
              </li>
            ))}
          </ol>
          <div class="mt-8 flex min-w-0 max-w-2xl items-start gap-3 border-l-2 border-amber-400 bg-zinc-900/50 p-4 sm:mt-10">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-400 shadow-[0_0_14px_rgba(132,180,172,.8)]" aria-hidden="true"></span>
            <p class="text-xs leading-relaxed text-zinc-400 text-justify">
              <strong class="mr-2 uppercase tracking-widest text-zinc-100">{copy.hero.pilot}</strong>
              {copy.hero.pilotBody}
            </p>
          </div>
        </div>

        <div class="relative mx-auto min-w-0 w-full max-w-md">
          <div class="area-card relative min-h-[390px] w-full max-w-full overflow-hidden border border-amber-400/50 bg-zinc-900 p-5 shadow-[0_28px_90px_rgba(0,0,0,.55)] sm:aspect-[4/5] sm:min-h-0 sm:p-7">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_15%,rgba(132,180,172,.22),transparent_30%),linear-gradient(145deg,transparent_25%,rgba(132,180,172,.06),transparent_60%)]" aria-hidden="true"></div>
            <div class="absolute -right-16 top-20 h-64 w-64 rounded-full border border-amber-400/10" aria-hidden="true"></div>
            <div class="relative flex h-full flex-col">
              <div class="flex min-w-0 items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-[11px] font-black uppercase tracking-[0.28em] text-amber-400 sm:tracking-[0.35em]">{lang === "pl" ? "VIRYA // GRA" : "VIRYA // AREA"}</p>
                  <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-400">
                    {lang === "pl" ? "Karta" : "Collectible"} 001 / {String(areaDrops.length).padStart(3, "0")}
                  </p>
                </div>
                <img src="/virya.webp" alt="" width="48" height="48" class="h-12 w-12 rounded-full opacity-80" />
              </div>
              <div class="my-auto">
                <p class="font-mono text-[11px] uppercase tracking-[.35em] text-zinc-400">{lang === "pl" ? "Odkodowana transmisja" : "Decoded transmission"}</p>
                <blockquote class="mt-5 border-l-2 border-amber-400 pl-5 text-3xl font-black uppercase leading-tight tracking-tight text-white sm:text-4xl">
                  “{copy.hero.teaserLine}”
                </blockquote>
                <p class="mt-5 text-[11px] font-black uppercase tracking-[.25em] text-amber-400">{copy.hero.teaserTrack}</p>
              </div>
              <div class="grid grid-cols-3 gap-2 border-t border-zinc-800 pt-5 text-center">
                <div>
                  <p class="text-lg font-black text-white">+1</p>
                  <p class="text-[11px] uppercase tracking-widest text-zinc-400">VIRYA</p>
                </div>
                <div>
                  <p class="text-lg font-black text-white">{lang === "pl" ? "MERCH" : "ITEM"}</p>
                  <p class="text-[11px] uppercase tracking-widest text-zinc-400">{lang === "pl" ? "GRATIS" : "FREE"}</p>
                </div>
                <div>
                  <p class="text-lg font-black text-white">PL</p>
                  <p class="text-[11px] uppercase tracking-widest text-zinc-400">{lang === "pl" ? "GRA" : "AREA"}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-5 -left-5 -z-10 h-full w-full border border-zinc-800" aria-hidden="true"></div>
        </div>
      </div>
    </header>

    <section aria-label={lang === "pl" ? "Najważniejsze informacje o Grze Virya" : "VIRYA Area facts"} class="border-b border-zinc-800/60 bg-black/30 px-4 sm:px-6 lg:px-12">
      <dl class="mx-auto grid max-w-7xl grid-cols-1 divide-y divide-zinc-800/60 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        {[
          [copy.stats.value, copy.stats.valueLabel],
          [copy.stats.cities, copy.stats.citiesLabel],
          [copy.stats.tracking, copy.stats.trackingLabel],
        ].map(([value, label]) => (
          <div class="px-4 py-7 text-center">
            <dt class="text-2xl font-black uppercase text-white">{value}</dt>
            <dd class="mt-1 text-[11px] font-bold uppercase tracking-[.22em] text-zinc-400">{label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <nav aria-label={lang === "pl" ? "Tryby Gry Virya" : "VIRYA Area modes"} class="sticky top-[68px] z-20 border-y border-zinc-800/80 bg-[#070908]/95 px-4 backdrop-blur-md sm:px-6 lg:px-12">
      <div class="mx-auto flex max-w-7xl overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {[
          ["#area-map", modeCopy.hunt],
          ["#area-collection", modeCopy.collection],
          ["#area-rewards", modeCopy.rewards],
        ].map(([href, label]) => (
          <a href={href} class="inline-flex min-h-12 shrink-0 items-center border-b-2 border-transparent px-4 text-[11px] font-black uppercase tracking-[.14em] text-zinc-400 transition-colors hover:border-amber-400 hover:text-white sm:px-6">
            {label}
          </a>
        ))}
      </div>
    </nav>

    <section id="area-map" class="scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20 lg:px-12 lg:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <p class="mb-3 text-[11px] font-black uppercase tracking-[.35em] text-amber-400">{copy.map.eyebrow}</p>
          <h2 class="area-section-title text-[clamp(2rem,9.5vw,2.75rem)] font-black uppercase leading-[.95] tracking-tight text-white sm:text-4xl lg:text-6xl">{copy.map.heading}</h2>
          <p class="mt-5 text-sm leading-relaxed text-zinc-400 text-justify mobile-justify lg:text-base">{copy.map.body}</p>
        </div>

        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(320px,.65fr)]">
          <div class="min-w-0 overflow-hidden border border-zinc-800 bg-zinc-900/30 p-2 sm:p-7">
            <div class="area-map relative mx-auto aspect-[1.1/1] w-full min-w-0 max-w-2xl" role="group" aria-label={copy.map.mapLabel}>
              <svg viewBox="0 0 600 540" class="absolute inset-0 h-full w-full" aria-hidden="true">
                <defs>
                  <linearGradient id={`area-fill-${lang}`} x1="0" x2="1" y1="0" y2="1">
                    <stop offset="0" stop-color="#27272a"></stop>
                    <stop offset="1" stop-color="#18181b"></stop>
                  </linearGradient>
                  <pattern id={`area-lines-${lang}`} width="28" height="28" patternUnits="userSpaceOnUse">
                    <path d="M28 0H0V28" fill="none" stroke="#84b4ac" stroke-opacity=".07" stroke-width="1"></path>
                  </pattern>
                </defs>
                <path d="M112 112L180 77L254 82L315 57L388 72L460 62L516 116L492 171L526 224L503 279L516 339L463 375L421 442L350 462L292 438L240 469L187 432L126 414L101 357L72 302L94 244L68 184L108 153Z" fill={`url(#area-fill-${lang})`} stroke="#52525b" stroke-width="2"></path>
                <path d="M112 112L180 77L254 82L315 57L388 72L460 62L516 116L492 171L526 224L503 279L516 339L463 375L421 442L350 462L292 438L240 469L187 432L126 414L101 357L72 302L94 244L68 184L108 153Z" fill={`url(#area-lines-${lang})`}></path>
                <path d="M125 195L472 357M156 370L455 147M287 78L292 438M87 277L510 282" stroke="#71717a" stroke-opacity=".15" stroke-dasharray="4 10"></path>
              </svg>

              {areaDrops.map((drop, index) => (
                <button
                  type="button"
                  data-drop-button
                  data-drop-marker
                  data-drop-id={drop.id}
                  data-city={drop.city}
                  data-city-slug={drop.signalCitySlug}
                  data-region={drop.region}
                  data-number={drop.number}
                  data-clue={drop.clue[lang]}
                  data-lat={drop.approximateLat}
                  data-lng={drop.approximateLng}
                  data-live={activeDropIds.has(drop.id) ? "true" : "false"}
                  aria-label={`${drop.number} — ${copy.map.markerAria(drop.city)}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                  class={`area-marker absolute flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center ${index === 0 ? "is-selected" : ""}`}
                  style={`left:${drop.mapX}%;top:${drop.mapY}%`}
                >
                  <span class="absolute inset-0 rounded-full border border-amber-400/20" aria-hidden="true"></span>
                  <span class="area-marker-core relative flex h-8 w-8 items-center justify-center rounded-full border border-amber-400/70 bg-zinc-950 text-amber-400" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="2.2"></circle>
                    </svg>
                    <span class="area-marker-number absolute -bottom-2 -right-2 min-w-5 rounded-full border border-zinc-700 bg-zinc-950 px-1 py-0.5 text-center font-mono text-[7px] font-black leading-none text-zinc-200">{drop.number.slice(-2)}</span>
                  </span>
                </button>
              ))}
            </div>

            <div class="mt-5 border-t border-zinc-800 pt-5">
              <button
                type="button"
                data-nearest-button
                class="inline-flex min-h-[44px] w-full items-center justify-center border border-zinc-700 px-5 py-3 text-[11px] font-black uppercase tracking-widest text-zinc-200 transition-colors hover:border-amber-400 hover:text-amber-400 sm:w-auto"
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" class="mr-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
                {copy.map.nearest}
              </button>
              <p class="mt-3 max-w-xl text-[11px] leading-relaxed text-zinc-400 text-justify">{copy.map.nearestNote}</p>
              <div class="mt-5 grid gap-2 sm:grid-cols-3" aria-label={lang === "pl" ? "Jak działa Gra Virya" : "How Virya Area works"}>
                {[
                  lang === "pl" ? "1. Wybierz aktywne miasto" : "1. Choose a live city",
                  lang === "pl" ? "2. Otwórz punkt startowy" : "2. Open the start area",
                  lang === "pl" ? "3. Potwierdź strefę telefonem" : "3. Verify the zone",
                ].map(item => <span class="border border-zinc-800 bg-zinc-950 p-3 text-[11px] font-black uppercase leading-relaxed tracking-wider text-zinc-300">{item}</span>)}
              </div>
              <p class="mt-4 border-l-2 border-amber-400/60 pl-4 text-xs leading-relaxed text-zinc-300">{lang === "pl" ? "Nie zbierasz 12 punktów w całym kraju. Lista po załadowaniu pokazuje tylko sygnały aktywne teraz." : "You do not collect all 12 locations. After loading, the list shows only signals active now."}</p>
              <p data-location-status role="status" aria-live="polite" class="mt-3 text-xs font-semibold text-amber-400"></p>
            </div>
          </div>

          <div class="flex min-w-0 flex-col gap-6">
            <aside class="min-w-0 border border-zinc-800 bg-zinc-900/50 p-4 sm:p-6">
              <div class="flex min-w-0 flex-wrap items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-[11px] font-black uppercase tracking-[.3em] text-zinc-400">{copy.map.selected}</p>
                  <h3 data-selected-city class="mt-2 break-words text-[clamp(1.65rem,8vw,1.875rem)] font-black uppercase leading-none tracking-tight text-white">{firstDrop.city}</h3>
                  <p data-selected-region class="mt-1 text-[11px] uppercase tracking-widest text-zinc-400">{firstDrop.region}</p>
                </div>
                <span data-selected-number class="border border-amber-400/50 px-2 py-1 font-mono text-xs text-amber-400">#{firstDrop.number}</span>
              </div>
              <p data-selected-clue class="mt-7 border-l border-amber-400 pl-4 text-sm italic leading-relaxed text-zinc-300">“{firstDrop.clue[lang]}”</p>
              <div class="mt-7 flex items-center justify-between border-t border-zinc-800 pt-5">
                <span data-selected-status class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[.22em] text-zinc-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-zinc-500" aria-hidden="true"></span>
                  {copy.map.signal}
                </span>
              </div>
              <div class="mt-4">
                <p class="text-[11px] font-black uppercase tracking-widest text-zinc-400">{copy.map.coordinates}</p>
                <p data-selected-coordinates class="mt-1 break-all font-mono text-[11px] uppercase tracking-wider text-zinc-400">{copy.map.encrypted}</p>
                <a data-navigation-button hidden target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-[44px] items-center border border-amber-400/50 px-4 text-[11px] font-black uppercase tracking-widest text-amber-400 hover:bg-amber-400 hover:text-black">{lang === "pl" ? "OTWÓRZ PUNKT STARTOWY ↗" : "OPEN START AREA ↗"}</a>
              </div>
            </aside>

            <div class="grid min-w-0 grid-cols-1 gap-2 min-[360px]:grid-cols-2" aria-label={copy.map.heading}>
              {areaDrops.map((drop, index) => (
                <button
                  type="button"
                  data-drop-button
                  data-drop-list
                  data-drop-id={drop.id}
                  data-city={drop.city}
                  data-city-slug={drop.signalCitySlug}
                  data-region={drop.region}
                  data-number={drop.number}
                  data-clue={drop.clue[lang]}
                  data-lat={drop.approximateLat}
                  data-lng={drop.approximateLng}
                  data-live={activeDropIds.has(drop.id) ? "true" : "false"}
                  aria-label={`${drop.number} — ${copy.map.selectAria(drop.city)}`}
                  aria-pressed={index === 0 ? "true" : "false"}
                  class={`area-drop-list min-h-[64px] border p-3 text-left transition-colors ${index === 0 ? "is-selected" : ""}`}
                >
                  <span class="flex items-center gap-2">
                    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="2.2"></circle>
                    </svg>
                    <span class="block font-mono text-[11px] text-zinc-400">#{drop.number}</span>
                  </span>
                  <span class="mt-2 block text-[11px] font-black uppercase tracking-widest text-zinc-200">{drop.city}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <section data-claim-panel hidden class="mt-8 min-w-0 border border-amber-400/60 bg-amber-400/[.06] p-4 sm:p-6 lg:p-8">
          <div class="grid items-center gap-7 lg:grid-cols-[1fr_auto]">
            <div>
              <p class="text-[11px] font-black uppercase tracking-[.3em] text-amber-400">{copy.claim.eyebrow}</p>
              <h3 class="mt-2 text-2xl font-black uppercase text-white">{copy.claim.heading}</h3>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300 text-justify mobile-justify">{copy.claim.body}</p>
              <p class="mt-3 max-w-3xl text-[11px] leading-relaxed text-zinc-400 text-justify">{copy.claim.privacy}</p>
            </div>
            <div class="flex flex-col items-stretch gap-3 lg:w-80">
