---
const { active } = Astro.props as { active: "home" | "control" | "pair" | "qr" | "accounting" | "commerce" }
const items = [
  { key: "home", href: "/staff/", label: "Panel" },
  { key: "control", href: "/staff/control/", label: "Control center" },
  { key: "pair", href: "/staff/pair/", label: "Parowanie apki" },
  { key: "qr", href: "/staff/qr/", label: "QR i bramka" },
  { key: "accounting", href: "/staff/accounting/", label: "Bilety i księgowość" },
  { key: "commerce", href: "/staff/commerce/", label: "Merch i losowanie" },
]
---
<nav aria-label="Nawigacja panelu Virya" class="mb-6 flex flex-wrap gap-2 rounded-2xl border border-white/10 bg-black/30 p-2 backdrop-blur">
  {items.map(item => (
    <a
      href={item.href}
      aria-current={active === item.key ? "page" : undefined}
      class:list={[
        "rounded-xl px-4 py-2 text-sm font-semibold transition",
        active === item.key
          ? "bg-amber-300 text-zinc-950"
          : "text-zinc-300 hover:bg-white/10 hover:text-white",
      ]}
    >
      {item.label}
    </a>
  ))}
</nav>
