---
import type { Lang } from "../i18n/t"
import { lp } from "../i18n/t"
import { GEAR_ITEMS } from "../data/gear"
import { thomannAffiliateUrl } from "../lib/thomann"
import { getSeoTags } from "../utils/seo"
import Layout from "./Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import ScrollToTop from "./ScrollToTop.astro"

interface Props {
  lang?: Lang
}

const { lang = "en" } = Astro.props
const isPl = lang === "pl"
const { canonicalUrl, hreflangLinks } = getSeoTags("/gear/", lang)
const title = isPl ? "Sprzęt VIRYA | Gear, którego używamy" : "VIRYA Gear | What we actually use"
const description = isPl
  ? "Sprzęt używany przez VIRYA na koncertach: Quad Cortex, X32 Rack, ART S8, Shure SM58, Roland TM-2 i UMC1820. Linki afiliacyjne Thomann."
  : "The gear VIRYA actually use live: Quad Cortex, X32 Rack, ART S8, Shure SM58, Roland TM-2 and UMC1820. Thomann affiliate links."
const shopPath = "/thomann"
const gear = GEAR_ITEMS.map((item) => ({
  ...item,
  affiliateUrl: thomannAffiliateUrl(item.thomannUrl, "gear"),
}))
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((link) => <link rel={link.rel} hreflang={link.hreflang} href={link.href} />)}
  </Fragment>

  <div class="min-h-screen bg-zinc-950 text-zinc-100">
    <Navbar lang={lang} displayLinks={true} activePage="gear" />
    <ScrollToTop />

    <main id="main-content" class="pt-24">
      <section class="virya-section border-b border-zinc-800/60">
        <div class="virya-section__inner">
          <p class="virya-eyebrow">VIRYA // LIVE RIG</p>
          <h1 class="virya-heading mt-4 max-w-4xl">
            {isPl ? "Sprzęt, którego naprawdę używamy" : "Gear we actually use"}
          </h1>
          <p class="virya-copy mt-6 max-w-3xl">
            {isPl
              ? "Bez losowego katalogu i bez polecania rzeczy, których nie znamy. To elementy obecnego koncertowego setupu VIRYA oraz sprzęt zapasowy opisany w naszym riderze."
              : "No random catalogue and no recommendations for gear we do not know. These are pieces from the current VIRYA live setup and the fallback equipment listed in our rider."}
          </p>

          <div class="mt-8 grid gap-5 border border-cyan-400/35 bg-cyan-400/[0.04] p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.3em] text-cyan-300">
                {isPl ? "Robisz zakupy w Thomannie?" : "Shopping at Thomann?"}
              </p>
              <h2 class="mt-2 text-2xl font-black uppercase tracking-tight text-white sm:text-3xl">
                {isPl ? "Zacznij przez VIRYA" : "Start through VIRYA"}
              </h2>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
                {isPl
                  ? "Kliknij raz, potem normalnie przeglądaj Thomanna i skompletuj dowolny koszyk. Jeśli zakup zostanie zakwalifikowany przez program afiliacyjny, VIRYA może otrzymać prowizję."
                  : "Click once, then browse Thomann normally and build any basket you want. If the purchase qualifies under the affiliate programme, VIRYA may receive a commission."}
              </p>
              <p class="mt-3 font-mono text-xs text-cyan-300/80">virya.music/thomann</p>
            </div>
            <a
              href={shopPath}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="inline-flex min-h-12 items-center justify-center gap-3 border border-cyan-300/70 bg-cyan-300 px-6 text-[11px] font-black uppercase tracking-widest text-zinc-950 transition hover:bg-cyan-200"
            >
              {isPl ? "Kupuj w Thomann" : "Shop at Thomann"}
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <p class="mt-4 text-xs leading-relaxed text-zinc-500">
            {isPl
              ? "Link afiliacyjny: cena w sklepie nie jest ustalana przez VIRYA. Możemy otrzymać prowizję od kwalifikującego się zakupu."
              : "Affiliate link: VIRYA does not set the store price. We may receive a commission from a qualifying purchase."}
          </p>
        </div>
      </section>

      <section class="virya-section">
        <div class="virya-section__inner">
          <div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="virya-eyebrow">VIRYA // GEAR</p>
              <h2 class="virya-heading mt-4">{isPl ? "Koncertowy setup" : "Live setup"}</h2>
            </div>
            <a
              href="/techrider.pdf"
              class="inline-flex min-h-11 w-fit items-center text-[10px] font-bold uppercase tracking-widest text-zinc-400 transition hover:text-amber-400"
            >
              {isPl ? "Rider techniczny →" : "Technical rider →"}
            </a>
          </div>

          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {gear.map((item, index) => (
              <article class={`group relative flex min-h-[280px] flex-col overflow-hidden border p-6 transition-all duration-300 ${item.featured ? "border-amber-400/45 bg-amber-400/[0.04]" : "border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-700"}`}>
                <div class="absolute right-5 top-5 text-5xl font-black tabular-nums text-white/[0.035]" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </div>
                <div class="relative flex flex-1 flex-col">
                  <p class={`text-[10px] font-black uppercase tracking-[0.28em] ${item.featured ? "text-amber-400" : "text-zinc-500"}`}>
                    {item.category[lang]}
                  </p>
                  <h3 class="mt-4 pr-8 text-xl font-black uppercase tracking-tight text-white sm:text-2xl">
                    {item.name}
                  </h3>
                  <p class="mt-4 flex-1 text-sm leading-relaxed text-zinc-400">
                    {item.description[lang]}
                  </p>
                  <a
                    href={item.affiliateUrl}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    class="mt-7 inline-flex min-h-11 w-fit items-center gap-3 border border-zinc-700 px-4 text-[10px] font-black uppercase tracking-widest text-zinc-200 transition group-hover:border-amber-400/60 hover:bg-amber-400 hover:text-black"
                    aria-label={`${isPl ? "Sprawdź w Thomann" : "View at Thomann"}: ${item.name}`}
                  >
                    {isPl ? "Sprawdź w Thomann" : "View at Thomann"}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="virya-section border-t border-zinc-800/60">
        <div class="virya-section__inner">
          <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
            <div>
              <p class="virya-eyebrow">VIRYA // THOMANN</p>
              <h2 class="virya-heading mt-4">{isPl ? "Nie widzisz swojej rzeczy?" : "Looking for something else?"}</h2>
              <p class="virya-copy mt-5">
                {isPl
                  ? "Nie musi być na tej liście. Użyj wejścia VIRYA do Thomanna, a potem wyszukaj i kup dokładnie to, czego potrzebujesz."
                  : "It does not need to be on this list. Use the VIRYA entry to Thomann, then search for and buy exactly what you need."}
              </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
              <a
                href={shopPath}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class="virya-button virya-button--primary justify-center"
              >
                {isPl ? "Otwórz Thomann" : "Open Thomann"} ↗
              </a>
              <a href={lp(lang, "/#endorsements")} class="virya-button virya-button--secondary justify-center">
                {isPl ? "Partnerzy VIRYA" : "VIRYA partners"}
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
