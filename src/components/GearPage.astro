---
import type { Lang } from "../i18n/t"
import { lp } from "../i18n/t"
import { GEAR_ITEMS } from "../data/gear"
import { thomannAffiliateUrl } from "../lib/thomann"
import { getSeoTags } from "../utils/seo"
import Layout from "./Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import ScrollToTop from "./ScrollToTop.astro"

interface Props {
  lang?: Lang
}

const { lang = "en" } = Astro.props
const isPl = lang === "pl"
const { canonicalUrl, hreflangLinks } = getSeoTags("/gear/", lang)
const title = isPl ? "Sprzęt VIRYA | Gear, którego używamy" : "VIRYA Gear | What we actually use"
const description = isPl
  ? "Sprzęt używany przez VIRYA na koncertach: Quad Cortex, X32 Rack, ART S8, Shure SM58, Roland TM-2 i UMC1820. Linki afiliacyjne Thomann."
  : "The gear VIRYA actually use live: Quad Cortex, X32 Rack, ART S8, Shure SM58, Roland TM-2 and UMC1820. Thomann affiliate links."
const shopPath = "/thomann"
const gear = GEAR_ITEMS.map((item) => ({
  ...item,
  affiliateUrl: thomannAffiliateUrl(item.thomannUrl, "gear"),
}))
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((link) => <link rel={link.rel} hreflang={link.hreflang} href={link.href} />)}
  </Fragment>

  <div class="min-h-screen bg-zinc-950 text-zinc-100">
    <Navbar lang={lang} displayLinks={true} activePage="gear" />
    <ScrollToTop />

    <main id="main-content" class="pt-24">
      <section class="virya-section border-b border-zinc-800/60">
        <div class="virya-section__inner">
          <p class="virya-eyebrow">VIRYA // LIVE RIG</p>
          <h1 class="virya-heading mt-4 max-w-4xl">
            {isPl ? "Sprzęt, którego naprawdę używamy" : "Gear we actually use"}
          </h1>
          <p class="virya-copy mt-6 max-w-3xl">
            {isPl
              ? "Bez losowego katalogu i bez polecania rzeczy, których nie znamy. To elementy obecnego koncertowego setupu VIRYA oraz sprzęt zapasowy opisany w naszym riderze."
              : "No random catalogue and no recommendations for gear we do not know. These are pieces from the current VIRYA live setup and the fallback equipment listed in our rider."}
          </p>

        </div>
      </section>

      <section class="virya-section">
        <div class="virya-section__inner">
          <div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="virya-eyebrow">VIRYA // GEAR</p>
              <h2 class="virya-heading mt-4">{isPl ? "Koncertowy setup" : "Live setup"}</h2>
            </div>
            <a
              href="/techrider.pdf"
              class="inline-flex min-h-11 w-fit items-center text-[11px] font-bold uppercase tracking-widest text-zinc-400 transition hover:text-amber-400"
            >
              {isPl ? "Rider techniczny →" : "Technical rider →"}
            </a>
          </div>

          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {gear.map((item, index) => (
              <article class={`group relative flex min-h-[280px] flex-col overflow-hidden border p-6 transition-all duration-300 ${item.featured ? "border-amber-400/45 bg-amber-400/[0.04]" : "border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-700"}`}>
                <div class="absolute right-5 top-5 text-5xl font-black tabular-nums text-white/[0.035]" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </div>
                <div class="relative flex flex-1 flex-col">
                  <p class={`text-[11px] font-black uppercase tracking-[0.28em] ${item.featured ? "text-amber-400" : "text-zinc-500"}`}>
                    {item.category[lang]}
                  </p>
                  <h3 class="mt-4 pr-8 text-xl font-black uppercase tracking-tight text-white sm:text-2xl">
                    {item.name}
                  </h3>
                  <p class="mt-4 flex-1 text-sm leading-relaxed text-zinc-400">
                    {item.description[lang]}
                  </p>
                  <a
                    href={item.affiliateUrl}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    class="mt-7 inline-flex min-h-11 w-fit items-center gap-3 border border-zinc-700 px-4 text-[11px] font-black uppercase tracking-widest text-zinc-200 transition group-hover:border-amber-400/60 hover:bg-amber-400 hover:text-black"
                    aria-label={`${isPl ? "Sprawdź w Thomann" : "View at Thomann"}: ${item.name}`}
                  >
                    {isPl ? "Sprawdź w Thomann" : "View at Thomann"}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <aside class="mt-12 grid gap-6 border-y border-amber-400/25 bg-amber-400/[.035] px-5 py-7 sm:px-7 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <p class="virya-eyebrow">VIRYA // THOMANN</p>
              <h2 class="mt-3 text-2xl font-black uppercase tracking-tight text-white sm:text-3xl">{isPl ? "I tak kupujesz w Thomannie?" : "Shopping at Thomann anyway?"}</h2>
              <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-400">
                {isPl ? "Zacznij przez VIRYA, a potem przeglądaj sklep normalnie. Kwalifikujący się zakup może przynieść zespołowi prowizję bez zmiany ceny w sklepie." : "Start through VIRYA, then browse normally. A qualifying purchase may support the band without changing the store price."}
              </p>
              <p class="mt-3 text-xs text-zinc-500">{isPl ? "Link afiliacyjny · VIRYA nie ustala cen sklepu." : "Affiliate link · VIRYA does not set store prices."}</p>
            </div>
            <a href={shopPath} target="_blank" rel="sponsored noopener noreferrer" class="virya-button virya-button--primary">
              {isPl ? "Otwórz Thomann" : "Open Thomann"} <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </section>


    </main>

    <Footer lang={lang} />
  </div>
</Layout>
