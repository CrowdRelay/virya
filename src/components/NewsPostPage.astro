---
import Layout from "./Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import ScrollToTop from "./ScrollToTop.astro"
import { lp, t } from "../i18n/t"
import { formatNewsDate, type NewsLang, type NewsPost } from "../data/news"
import { getSeoTags } from "../utils/seo"
import { VIRYA_SITE_ORIGIN } from "../config"

interface Props {
  lang: NewsLang
  post: NewsPost
}

const { lang, post } = Astro.props
const { canonicalUrl, hreflangLinks } = getSeoTags(`/news/${post.slug}/`, lang)
const ogImage = new URL(post.image, VIRYA_SITE_ORIGIN).toString()
---

<Layout
  title={`${post.title[lang]} | Virya`}
  description={post.excerpt[lang]}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={post.imageAlt[lang]}
  ogType="article"
  lang={lang}
>
  <Fragment slot="head">
    {hreflangLinks.map(link => <link rel={link.rel} hreflang={link.hreflang} href={link.href} />)}
    <meta property="article:published_time" content={`${post.publishedAt}T12:00:00Z`} />
  </Fragment>

  <div class="flex min-h-screen flex-col bg-zinc-950">
    <Navbar lang={lang} displayLinks={true} activePage="news" />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-20">
      <article class="mx-auto max-w-5xl px-6 pb-20 pt-8 lg:px-12">
        <a href={lp(lang, "/news/")} class="inline-flex min-h-11 items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-zinc-500 transition-colors hover:text-amber-400">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          {t(lang, "news.back")}
        </a>

        <header class="mt-5 max-w-4xl">
          <div class="flex flex-wrap items-center gap-3">
            <span class="border border-amber-400/40 px-2 py-1 text-[9px] font-bold uppercase tracking-widest text-amber-400">{post.tag[lang]}</span>
            <time datetime={post.publishedAt} class="text-[10px] uppercase tracking-widest text-zinc-500">{formatNewsDate(post.publishedAt, lang)}</time>
          </div>
          <h1 class="mt-5 text-4xl font-black uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">{post.title[lang]}</h1>
          <p class="mt-6 max-w-3xl text-base leading-7 text-zinc-300 sm:text-lg">{post.excerpt[lang]}</p>
        </header>

        <figure class="mt-10 overflow-hidden border border-zinc-800 bg-zinc-900">
          {/* Square frame anchored to the top edge: portrait press shots are the
              norm here, and a centred crop of one pushes the subject's face out
              of frame. */}
          <img src={post.image} alt={post.imageAlt[lang]} class="aspect-square w-full object-cover object-top" fetchpriority="high" />
        </figure>

        <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px]">
          <div class="space-y-6 text-base leading-8 text-zinc-300">
            {post.body[lang].map(paragraph => <p>{paragraph}</p>)}
          </div>

          <aside class="h-fit border border-amber-400/30 bg-amber-400/[0.04] p-5">
            <p class="text-[10px] font-black uppercase tracking-[0.22em] text-amber-400">Virya Signal · {lang === "pl" ? "Latarnik" : "Beacon"}</p>
            <p class="mt-3 text-sm leading-6 text-zinc-400">{post.latarnikContext[lang]}</p>
            <a href={lp(lang, "/latarnik/")} class="mt-5 inline-flex min-h-10 items-center border border-zinc-700 px-4 text-[10px] font-black uppercase tracking-wider text-zinc-200 transition-colors hover:border-amber-400 hover:text-amber-400">
              {lang === "pl" ? "Otwórz Latarnika" : "Open Beacon"}
            </a>
          </aside>
        </div>
      </article>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
