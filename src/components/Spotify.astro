---
import { t, type Lang } from "../i18n/t"

const ARTIST_ID = "6bbW0jOKAWJWm3h6CTWaAS"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props
---

<div class="pb-16 lg:px-8">
  <div class="mx-4">
    <div class="flex items-center gap-4 mb-6">
      <p class="text-zinc-400 text-xs uppercase tracking-widest whitespace-nowrap">
        {t(lang, "music.streamSpotify")}
      </p>
      <div class="flex-1 h-px bg-zinc-800/60" />
      <a
        href={`https://open.spotify.com/artist/${ARTIST_ID}`}
        target="_blank"
        rel="noreferrer"
        aria-label={t(lang, "music.openSpotify")}
        class="flex-shrink-0 text-zinc-400 hover:text-amber-400 transition-colors duration-200"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
        </svg>
      </a>
    </div>
    <div class="relative overflow-hidden" id="spotify-root">
      <div id="spotify-skeleton" class="w-full h-[450px] bg-zinc-900/30 p-4 flex flex-col gap-3">
        <div class="flex items-center gap-3 pb-3 border-b border-zinc-800/40">
          <div class="w-12 h-12 bg-zinc-700/50 animate-pulse flex-shrink-0" />
          <div class="flex-1 flex flex-col gap-2">
            <div class="h-3 w-1/3 bg-zinc-700/50 animate-pulse" />
            <div class="h-2 w-1/4 bg-zinc-800/50 animate-pulse" />
          </div>
        </div>
        {[65, 55, 70, 50, 60].map((w) => (
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-zinc-700/50 animate-pulse flex-shrink-0" />
            <div class="flex-1 flex flex-col gap-1.5">
              <div class="h-3 bg-zinc-700/50 animate-pulse" style={`width:${w}%`} />
              <div class="h-2 w-1/4 bg-zinc-800/50 animate-pulse" />
            </div>
            <div class="h-2 w-7 bg-zinc-800/50 animate-pulse flex-shrink-0" />
          </div>
        ))}
      </div>
      <div id="spotify-embed" data-artist={ARTIST_ID} class="w-full" />
    </div>
  </div>
</div>

<script>
  let controller = new AbortController()
  document.addEventListener("astro:before-swap", () => { controller.abort(); controller = new AbortController() })

  function init() {
    const root = document.getElementById("spotify-root")
    const skeleton = document.getElementById("spotify-skeleton")
    const embed = document.getElementById("spotify-embed")
    if (!root || !skeleton || !embed) return
    const artistId = embed.dataset.artist
    if (!artistId) return

    let done = false
    const { signal } = controller

    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting || done) return
      done = true
      io.disconnect()
      const iframe = document.createElement("iframe")
      iframe.title = "Virya on Spotify"
      iframe.src = `https://open.spotify.com/embed/artist/${artistId}?utm_source=generator`
      iframe.width = "100%"
      iframe.height = "450"
      iframe.setAttribute("frameborder", "0")
      iframe.setAttribute("allow", "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture")
      iframe.className = "opacity-0 absolute inset-0 rounded-2xl outline-none border-0"
      iframe.addEventListener("load", () => {
        skeleton.remove()
        iframe.classList.remove("opacity-0", "absolute", "inset-0")
      }, { once: true, signal })
      embed.appendChild(iframe)
    }, { rootMargin: "300px" })
    io.observe(root)
  }

  document.addEventListener("astro:page-load", init)
</script>
