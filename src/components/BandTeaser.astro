---
import { t, lp, type Lang } from "../i18n/t"
import ChevronRight from "./ChevronRight.astro"
import BlurImage from "./BlurImage.astro"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props
---

<div class="virya-section border-t border-zinc-800/60">
  <div class="virya-section__inner">
    <p class="virya-eyebrow">VIRYA // BAND</p>
    <h2 class="virya-heading mt-4">{t(lang, "band.heading")}</h2>
    <p class="virya-copy mt-5 mb-10">{t(lang, "band.sub")}</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="overflow-hidden border border-zinc-800/60">
        <BlurImage
          src="/images/band.webp"
          alt="Virya — modern metalcore band from Poland"
          title="Virya"
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
          sizes="(max-width: 1023px) calc(100vw - 2rem), 600px"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="border-l-4 border-amber-400 pl-6 lg:pl-8 py-2">
        <p class="lg:text-base text-sm text-zinc-300 text-justify mobile-justify leading-relaxed">
          {t(lang, "band.teaser")}
        </p>
        <p class="mt-4 text-sm text-zinc-400 leading-relaxed text-justify mobile-justify">
          {t(lang, "band.noPain")}
        </p>
        <a
          href={lp(lang, "/about")}
          class="virya-button virya-button--accent-outline group mt-6 gap-2"
        >
          {t(lang, "band.readStory")}
          <ChevronRight class="w-3.5 h-3.5 shrink-0 transition-transform group-hover:translate-x-0.5" />
        </a>

        <div class="mt-8 pt-6 border-t border-zinc-800/60">
          <p class="text-zinc-400 text-[10px] uppercase tracking-widest mb-4">{t(lang, "band.follow")}</p>
          <div class="flex flex-wrap items-center gap-2 [&_a]:inline-flex [&_a]:min-h-[44px] [&_a]:min-w-[44px] [&_a]:items-center [&_a]:justify-center">
            <a href="https://www.instagram.com/virya.official" title="Instagram" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="instagram">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913a5.885 5.885 0 0 0 1.384 2.126A5.868 5.868 0 0 0 4.14 23.37c.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558a5.898 5.898 0 0 0 2.126-1.384 5.86 5.86 0 0 0 1.384-2.126c.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913a5.89 5.89 0 0 0-1.384-2.126A5.847 5.847 0 0 0 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227a3.81 3.81 0 0 1-.899 1.382 3.744 3.744 0 0 1-1.38.896c-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421a3.716 3.716 0 0 1-1.379-.899 3.644 3.644 0 0 1-.9-1.38c-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 1 0 0-12.324zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 0 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/></svg>
            </a>
            <a href="https://youtube.com/@ViryaOfficial?sub_confirmation=1" title="YouTube" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="youtube">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://www.facebook.com/ViryaBand" title="Facebook" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="facebook">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22.676 0H1.324C.593 0 0 .593 0 1.324v21.352C0 23.408.593 24 1.324 24h11.494v-9.294H9.689v-3.621h3.129V8.41c0-3.099 1.894-4.785 4.659-4.785 1.325 0 2.464.097 2.796.141v3.24h-1.921c-1.5 0-1.792.721-1.792 1.771v2.311h3.584l-.465 3.63H16.56V24h6.115c.733 0 1.325-.592 1.325-1.324V1.324C24 .593 23.408 0 22.676 0"/></svg>
            </a>
            <a href="https://open.spotify.com/artist/6bbW0jOKAWJWm3h6CTWaAS" title="Spotify" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="spotify">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
            </a>
            <a href="https://virya.bandcamp.com" title="Bandcamp" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="bandcamp">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 97.75 97.75"><path d="M48.875 0C21.882 0 0 21.882 0 48.875S21.882 97.75 48.875 97.75 97.75 75.868 97.75 48.875 75.868 0 48.875 0zm15.96 70.857H12.593l20.32-43.965h52.244z"/></svg>
            </a>
            <a href="https://soundcloud.com/viryaofficial" title="SoundCloud" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="soundcloud">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7 17.939h-1v-8.068c.308-.231.639-.429 1-.566v8.634zm3 0h1v-9.224c-.229.265-.443.548-.621.857l-.379-.184v8.551zm-2 0h1v-8.848c-.508-.079-.623-.05-1-.01v8.858zm-4 0h1v-7.02c-.312.458-.555.971-.692 1.535l-.308-.182v5.667zm-3-5.25c-.606.547-1 1.354-1 2.268 0 .914.394 1.721 1 2.268v-4.536zm18.879-.671c-.204-2.837-2.404-5.079-5.117-5.079-1.022 0-1.964.328-2.762.877v10.123h9.089c1.607 0 2.911-1.393 2.911-3.106 0-2.233-2.168-3.772-4.121-2.815zm-16.879-.027c-.302-.024-.526-.03-1 .122v5.689c.446.143.636.138 1 .138v-5.949z"/></svg>
            </a>
            <a href="https://x.com/viryaofficial" title="Twitter" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="twitter">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
            </a>
            <a href="https://artists.bandsintown.com/artists/15587796" title="Bandsintown" rel="noreferrer" target="_blank" class="text-zinc-400 hover:text-amber-400 transition-colors" aria-label="bandsintown">
              <svg aria-hidden="true" class="fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30"><polygon points="5.7,0 5.7,24.2 23,24.2 23,22.3 7.7,22.3 7.7,16.5 28.7,16.5 28.7,30 0,30 0,0 "/><rect x="23" width="5.7" height="14.5"/><rect x="15.3" y="6.8" width="5.7" height="7.7"/><rect x="7.7" y="6.8" width="5.7" height="7.7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
