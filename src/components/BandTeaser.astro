---
import { t, lp, type Lang } from "../i18n/t"
import ChevronRight from "./ChevronRight.astro"
import BlurImage from "./BlurImage.astro"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props
---

<div class="py-16 lg:px-8 border-t border-zinc-800/60">
  <div class="mx-4">
    <div class="flex items-center gap-4 mb-2">
      <p class="text-3xl font-black uppercase tracking-widest whitespace-nowrap text-white">
        {t(lang, "band.heading")}
      </p>
      <div class="flex-1 h-px bg-zinc-800" />
    </div>
    <p class="text-zinc-400 text-xs uppercase tracking-widest mb-8">
      {t(lang, "band.sub")}
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <div class="overflow-hidden border border-zinc-800/60">
        <BlurImage
          src="/images/band.webp"
          alt="Virya — modern metalcore band from Poland"
          title="Virya"
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="border-l-4 border-amber-400 pl-6 lg:pl-8 py-2">
        <p class="lg:text-base text-sm text-zinc-300 text-justify leading-relaxed">
          {t(lang, "band.teaser")}
        </p>
        <p class="mt-4 text-sm text-zinc-400 leading-relaxed">
          {t(lang, "band.noPain")}
        </p>
        <a
          href={lp(lang, "/about")}
          class="group inline-flex items-center gap-2 mt-6 text-xs font-bold uppercase tracking-widest text-amber-400 hover:text-amber-200 transition-colors"
        >
          {t(lang, "band.readStory")}
          <ChevronRight class="w-3.5 h-3.5 shrink-0 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </div>
</div>
