---
// One source for /gallery/ and /pl/gallery/ — previously two near-identical
// route files whose headers had already drifted apart.
import Layout from "./Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import ScrollToTop from "./ScrollToTop.astro"
import GalleryGrid from "./GalleryGrid.astro"
import { t } from "../i18n/t"
import { getSeoTags } from "../utils/seo"

const { lang = "en" } = Astro.props as { lang?: "en" | "pl" }
const { canonicalUrl, hreflangLinks } = getSeoTags("/gallery/", lang)
const title = lang === "pl" ? "Galeria | Virya" : "Gallery | Virya"
const description = lang === "pl"
  ? "Galeria zdjęć — oficjalne zdjęcia prasowe i materiały koncertowe z Virya, nowoczesny metalcore z Polski."
  : "Photo gallery — official press photos and live shots from Virya, modern metalcore from Poland."
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} activePage="gallery" />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-[var(--virya-nav-offset)]">
      <div class="px-6 lg:px-12 pt-8 pb-12 max-w-7xl mx-auto">

        <div class="mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <p class="virya-eyebrow mb-3">{t(lang, "gallery.eyebrow")}</p>
            <h1 class="text-4xl lg:text-5xl font-black uppercase tracking-tight text-white mb-2">{t(lang, "gallery.heading")}</h1>
            <p class="text-sm text-zinc-400">{t(lang, "gallery.sub")}</p>
          </div>
        </div>

        <GalleryGrid lang={lang} />

      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
