---
import ClientRouter from "astro/components/ClientRouter.astro"
import "../styles/global.css"
import { t, type Lang } from "../i18n/t"

interface Props {
  title: string
  description?: string
  canonical?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: string
  lang?: Lang
  head?: string
}

const {
  title,
  description,
  canonical,
  ogImage = "https://www.virya.music/poster.webp",
  ogImageAlt = title,
  ogType = "website",
  lang = "en",
  head,
} = Astro.props

const LANG_REDIRECT = `(function(){try{var p=location.pathname;if(p==='/pl'||p.indexOf('/pl/')===0)return;var pref=localStorage.getItem('virya-lang');if(pref!=='pl'&&pref!=='en'){pref=(navigator.language||'').toLowerCase().indexOf('pl')===0?'pl':'en';}if(pref==='pl'){location.replace('/pl'+p+location.search+location.hash);}}catch(e){}})();`
---

<!doctype html>
<html lang={lang} class="bg-zinc-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <meta name="author" content="Virya" />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Virya" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@viryaofficial" />
    <meta name="twitter:creator" content="@viryaofficial" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/virya.webp" />
    <title>{title}</title>
    <slot name="head" />
    <!-- Installs before Astro navigation and all hydrated islands. -->
    <script is:inline src="/runtime-guard.js"></script>
    <ClientRouter />
    {lang === "en" && <script is:inline set:html={LANG_REDIRECT} />}
    <script is:inline>
      (function() {
        if (window.__viryaNavProgressInstalled) return;
        window.__viryaNavProgressInstalled = true;
        var hideTimer;
        var resetTimer;
        function clearTimers() { clearTimeout(hideTimer); clearTimeout(resetTimer); }
        function getBar() {
          var bar = document.getElementById('nav-progress');
          if (!bar) {
            bar = document.createElement('div');
            bar.id = 'nav-progress';
            bar.setAttribute('aria-hidden', 'true');
            bar.style.cssText = 'position:fixed;top:0;left:0;z-index:9999;height:2px;width:0;background:#fbbf24;transition:none;pointer-events:none;opacity:0;';
            document.documentElement.appendChild(bar);
          }
          return bar;
        }
        document.addEventListener('astro:before-preparation', function() {
          clearTimers();
          var bar = getBar();
          bar.style.transition = 'none'; bar.style.width = '0'; bar.style.opacity = '1';
          bar.getBoundingClientRect();
          bar.style.transition = 'width 0.8s ease'; bar.style.width = '85%';
        });
        document.addEventListener('astro:page-load', function() {
          clearTimers();
          var bar = getBar();
          bar.style.transition = 'width 0.1s ease'; bar.style.width = '100%';
          hideTimer = setTimeout(function() {
            bar.style.transition = 'opacity 0.3s ease'; bar.style.opacity = '0';
            resetTimer = setTimeout(function() { bar.style.transition = 'none'; bar.style.width = '0'; }, 350);
          }, 150);
        });
        getBar();
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator && !window.__viryaServiceWorkerScheduled) {
        window.__viryaServiceWorkerScheduled = true;
        window.addEventListener('load', function() {
          var register = function() {
            navigator.serviceWorker.register('/sw.js').catch(function(error) {
              window.__VIRYA_REPORT__?.report?.('service-worker-registration', error, { visible: false });
            });
          };
          if ('requestIdleCallback' in window) window.requestIdleCallback(register, { timeout: 3000 });
          else setTimeout(register, 1000);
        }, { once: true });
      }
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[10000] focus:inline-flex focus:min-h-[44px] focus:items-center focus:bg-amber-400 focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:uppercase focus:tracking-widest focus:text-black"
    >
      {t(lang, "nav.skip")}
    </a>
    <slot />
  </body>
</html>
