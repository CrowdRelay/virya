---
import ClientRouter from "astro/components/ClientRouter.astro"
import "../styles/global.css"
import { t, type Lang } from "../i18n/t"

interface Props {
  title: string
  description?: string
  canonical?: string
  ogImage?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
  ogType?: string
  lang?: Lang
  head?: string
  enableClientRouter?: boolean
}

const {
  title,
  description,
  canonical,
  ogImage = "https://virya.music/poster.webp",
  ogImageAlt = title,
  ogImageWidth,
  ogImageHeight,
  ogType = "website",
  lang = "en",
  head,
  enableClientRouter = true,
} = Astro.props

// Emit og:image dimensions only when they are known: the default poster is
// 1280x720, everything else must pass them explicitly. Wrong dims are worse
// than missing ones.
const resolvedOgImageWidth =
  ogImageWidth ?? (ogImage === "https://virya.music/poster.webp" ? 1280 : undefined)
const resolvedOgImageHeight =
  ogImageHeight ?? (ogImage === "https://virya.music/poster.webp" ? 720 : undefined)

const OG_IMAGE_TYPES: Record<string, string> = {
  ".webp": "image/webp",
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
}
const ogImageType = Object.entries(OG_IMAGE_TYPES).find(([ext]) =>
  ogImage.toLowerCase().split("?")[0].endsWith(ext),
)?.[1]

const LANG_REDIRECT = `(function(){try{var p=location.pathname;if(p==='/pl'||p.indexOf('/pl/')===0)return;var pref=localStorage.getItem('virya-lang');if(pref!=='pl'&&pref!=='en'){pref=(navigator.language||'').toLowerCase().indexOf('pl')===0?'pl':'en';}if(pref==='pl'){location.replace('/pl'+p+location.search+location.hash);}}catch(e){}})();`

const CROWDRELAY_API_URL = (import.meta.env.PUBLIC_CROWDRELAY_API_URL as string | undefined) ?? "https://signal-api.virya.music/v1/"
---

<!doctype html>
<html lang={lang} class="bg-zinc-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#09090b" />
    <meta name="author" content="Virya" />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Virya" />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {resolvedOgImageWidth && <meta property="og:image:width" content={String(resolvedOgImageWidth)} />}
    {resolvedOgImageHeight && <meta property="og:image:height" content={String(resolvedOgImageHeight)} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@viryaofficial" />
    <meta name="twitter:creator" content="@viryaofficial" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Warm DNS+TLS for the CrowdRelay public API. Fan islands (banner, shows
         refresh, parked check) all call this origin right after hydration. -->
    <link rel="preconnect" href={new URL(CROWDRELAY_API_URL).origin} crossorigin />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/virya-512.png" />
    <title>{title}</title>
    <slot name="head" />
    <!-- Parse HTML first; the full diagnostic guard and RUM are not on the
         critical rendering path. Load them in idle callbacks so they never
         block first paint or contribute to Total Blocking Time. -->
    <script is:inline>
      (function() {
        var ric = 'requestIdleCallback' in window ? requestIdleCallback : function(fn) { return setTimeout(fn, 1500); };
        ric(function() {
          var s = document.createElement('script');
          s.src = '/runtime-guard.js';
          s.async = true;
          document.head.appendChild(s);
        }, { timeout: 2000 });
        ric(function() {
          var s = document.createElement('script');
          s.src = '/rum.js';
          s.async = true;
          document.head.appendChild(s);
        }, { timeout: 3000 });
      })();
    </script>
    {enableClientRouter && <ClientRouter />}
    {lang === "en" && <script is:inline set:html={LANG_REDIRECT} />}
    {enableClientRouter && (
      <script is:inline>
        (function() {
          if (window.__viryaNavProgressInstalled) return;
          window.__viryaNavProgressInstalled = true;
          var hideTimer;
          var resetTimer;
          function clearTimers() { clearTimeout(hideTimer); clearTimeout(resetTimer); }
          function getBar() {
            var bar = document.getElementById('nav-progress');
            if (!bar) {
              bar = document.createElement('div');
              bar.id = 'nav-progress';
              bar.setAttribute('aria-hidden', 'true');
              bar.style.cssText = 'position:fixed;top:0;left:0;z-index:9999;height:2px;width:100%;background:#84b4ac;transform:scaleX(0);transform-origin:left center;transition:none;pointer-events:none;opacity:0;will-change:transform,opacity;';
              document.documentElement.appendChild(bar);
            }
            return bar;
          }
          document.addEventListener('astro:before-preparation', function() {
            clearTimers();
            var bar = getBar();
            bar.style.transition = 'none'; bar.style.transform = 'scaleX(0)'; bar.style.opacity = '1';
            bar.getBoundingClientRect();
            bar.style.transition = 'transform 0.8s ease'; bar.style.transform = 'scaleX(.85)';
          });
          document.addEventListener('astro:page-load', function() {
            clearTimers();
            var bar = getBar();
            bar.style.transition = 'transform 0.1s ease'; bar.style.transform = 'scaleX(1)';
            hideTimer = setTimeout(function() {
              bar.style.transition = 'opacity 0.3s ease'; bar.style.opacity = '0';
              resetTimer = setTimeout(function() { bar.style.transition = 'none'; bar.style.transform = 'scaleX(0)'; }, 350);
            }, 150);
          });
          getBar();
        })();
      </script>
    )}
    <script is:inline>
      if ('serviceWorker' in navigator && !window.__viryaServiceWorkerScheduled) {
        window.__viryaServiceWorkerScheduled = true;
        window.addEventListener('load', function() {
          var register = function() {
            navigator.serviceWorker.register('/sw.js').catch(function(error) {
              window.__VIRYA_REPORT__?.report?.('service-worker-registration', error, { visible: false });
            });
          };
          if ('requestIdleCallback' in window) window.requestIdleCallback(register, { timeout: 3000 });
          else setTimeout(register, 1000);
        }, { once: true });
      }
    </script>
    <!-- Tenant parked banner: fetches public/config from CrowdRelay in an
         idle callback and shows a banner if the tenant is parked. Fails
         silently so public pages survive a CrowdRelay outage. Cached in
         sessionStorage for 5 minutes. -->
    <script is:inline set:html={`window.__VIRYA_CROWDRELAY_API_URL__=${JSON.stringify(CROWDRELAY_API_URL)};`} />
    <script is:inline>
      (function() {
        var API_URL = (window.__VIRYA_CROWDRELAY_API_URL__ || 'https://signal-api.virya.music/v1/');
        var CACHE_KEY = 'virya-parked-cache';
        var CACHE_TTL_MS = 5 * 60 * 1000;
        function showBanner() {
          if (document.getElementById('virya-parked-banner')) return;
          var b = document.createElement('div');
          b.id = 'virya-parked-banner';
          b.setAttribute('role', 'status');
          b.style.cssText = 'position:sticky;top:0;z-index:9000;padding:10px 16px;background:#2b1919;border-bottom:2px solid #f5b942;color:#f5b942;font-size:14px;line-height:1.5;text-align:center;';
          b.textContent = 'Operations are paused. Contact support to resume.';
          document.body.insertBefore(b, document.body.firstChild);
        }
        function check() {
          try {
            var c = sessionStorage.getItem(CACHE_KEY);
            if (c) {
              var p = JSON.parse(c);
              if (Date.now() - p.ts < CACHE_TTL_MS) { if (p.parked) showBanner(); return; }
            }
          } catch (e) {}
          var ctrl = new AbortController();
          var t = setTimeout(function() { ctrl.abort(); }, 2500);
          fetch(API_URL + 'public/tenant/config', { signal: ctrl.signal, headers: { Accept: 'application/json' } })
            .then(function(r) { clearTimeout(t); return r.ok ? r.json() : null; })
            .then(function(d) {
              var parked = !!(d && d.parked);
              try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ parked: parked, ts: Date.now() })); } catch (e) {}
              if (parked) showBanner();
            })
            .catch(function() { clearTimeout(t); });
        }
        var ric = 'requestIdleCallback' in window ? requestIdleCallback : function(fn) { return setTimeout(fn, 1500); };
        ric(check, { timeout: 3000 });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[10000] focus:inline-flex focus:min-h-[44px] focus:items-center focus:bg-amber-400 focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:uppercase focus:tracking-widest focus:text-black"
    >
      {t(lang, "nav.skip")}
    </a>
    <slot />
  </body>
</html>
