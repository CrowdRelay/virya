---
type Active = "home" | "qr" | "commerce" | "accounting" | "pair" | "beacons"
const { active = "home" } = Astro.props as { active?: Active }

// The console renders its sections as tabs of /staff/, so a sidebar link is
// only "current" when both the page and the ?tab= it points at match.
const groups = [
  {
    label: "DZISIAJ",
    items: [{ key: "home", tab: "overview", href: "/staff/", label: "Dzisiaj" }],
  },
  {
    label: "LIVE",
    items: [
      { key: "qr", tab: null, href: "/staff/qr/", label: "QR i bramka" },
    ],
  },
  {
    label: "FANI",
    items: [
      { key: "home", tab: "signal", href: "/staff/?tab=signal", label: "Sygnał" },
      { key: "home", tab: "audience", href: "/staff/?tab=audience", label: "Fani" },
      { key: "home", tab: "admission", href: "/staff/?tab=admission", label: "Goście" },
      { key: "home", tab: "beacons", href: "/staff/?tab=beacons", label: "Latarnicy" },
    ],
  },
  {
    label: "SPRZEDAŻ",
    items: [
      { key: "home", tab: "ticketing", href: "/staff/?tab=ticketing", label: "Bilety" },
      { key: "commerce", tab: null, href: "/staff/commerce/", label: "Merch" },
      { key: "accounting", tab: null, href: "/staff/accounting/", label: "Rozliczenia" },
    ],
  },
  {
    label: "WIĘCEJ",
    items: [
      { key: "home", tab: "releases", href: "/staff/?tab=releases", label: "Wydania" },
      { key: "pair", tab: null, href: "/staff/pair/", label: "Urządzenia" },
    ],
  },
] as const

const consoleTabs = ["overview", "signal", "audience", "ticketing", "admission", "beacons", "releases"]
const requested = Astro.url.searchParams.get("tab")
const currentTab = requested && consoleTabs.includes(requested) ? requested : "overview"
const isCurrent = (item: { key: string; tab: string | null }) =>
  active === item.key && (item.tab === null || item.tab === currentTab)

// Sidebar language follows the control-plane console: the active section is a
// filled pill, not a border bar, and every surface name resolves to a
// --color-virya-* token instead of a bare zinc pick.
const ACTIVE_LINK = "bg-virya-high text-virya-text"
const IDLE_LINK = "text-virya-muted hover:bg-white/[.04] hover:text-virya-text"
---

<div class="min-h-screen bg-[var(--virya-bg)] text-zinc-100 lg:grid lg:grid-cols-[224px_minmax(0,1fr)]">
  <aside class="hidden border-r border-virya-edge bg-virya-bg lg:sticky lg:top-0 lg:block lg:h-screen">
    <div class="flex h-full flex-col px-3 py-6">
      <a href="/staff/" class="flex min-h-12 items-center gap-3 rounded-md px-2 transition-colors hover:bg-white/[.04]">
        <img src="/virya.webp" alt="" width="36" height="36" class="h-9 w-9 rounded-full" />
        <div>
          <p class="text-[11px] font-black uppercase tracking-[.18em] text-virya-hot">VIRYA</p>
          <p class="text-xs font-semibold text-virya-muted">Staff</p>
        </div>
      </a>
      <nav aria-label="Nawigacja panelu Virya" class="mt-7 grid gap-6" data-staff-nav>
        {groups.map(group => (
          <div>
            <p class="px-3 text-[10px] font-black uppercase tracking-[.16em] text-virya-muted">{group.label}</p>
            <div class="mt-2 grid gap-0.5">
              {group.items.map(item => (
                <a
                  href={item.href}
                  data-staff-tab={item.key === "home" ? item.tab : undefined}
                  aria-current={isCurrent(item) ? "page" : undefined}
                  class:list={[
                    "flex min-h-11 items-center rounded-md px-3 text-sm font-semibold transition-colors",
                    isCurrent(item) ? ACTIVE_LINK : IDLE_LINK,
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
      <a href="/pl/" class="mt-auto flex min-h-11 items-center rounded-md px-3 text-xs font-bold uppercase tracking-[.12em] text-virya-muted transition-colors hover:bg-white/[.04] hover:text-virya-hot">← Strona VIRYA</a>
    </div>
  </aside>

  <div class="min-w-0 pb-[calc(5.25rem+env(safe-area-inset-bottom))] lg:pb-0">
    <div class="mx-auto w-full max-w-[1440px] px-4 py-5 sm:px-6 sm:py-7 lg:px-8 lg:py-8">
      <slot />
    </div>
  </div>

  <nav aria-label="Główna nawigacja Staff" class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-5 border-t border-virya-edge bg-[var(--virya-bg)]/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden">
    <a href="/staff/" aria-current={isCurrent({ key: "home", tab: "overview" }) ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-[10px] font-semibold transition-colors", isCurrent({ key: "home", tab: "overview" }) ? "text-virya-hot" : "text-virya-muted"]}><svg data-staff-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.5V21h13V9.5"/><path d="M9.5 21v-6h5v6"/></svg>Dzisiaj</a>
    <a href="/staff/qr/" aria-current={active === "qr" ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-[10px] font-semibold transition-colors", active === "qr" ? "text-virya-hot" : "text-virya-muted"]}><svg data-staff-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h2v2h-2zM18 14h2v6h-6v-2h4z"/></svg>QR</a>
    <a href="/staff/?tab=audience" aria-current={isCurrent({ key: "home", tab: "audience" }) ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-[10px] font-semibold transition-colors", isCurrent({ key: "home", tab: "audience" }) ? "text-virya-hot" : "text-virya-muted"]}><svg data-staff-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Fani</a>
    <a href="/staff/commerce/" aria-current={active === "commerce" ? "page" : undefined} class:list={["flex min-h-16 flex-col items-center justify-center gap-1 px-1 text-[10px] font-semibold transition-colors", active === "commerce" ? "text-virya-hot" : "text-virya-muted"]}><svg data-staff-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8"><path d="M6 2 3 6v15h18V6l-3-4z"/><path d="M3 6h18M8 10a4 4 0 0 0 8 0"/></svg>Merch</a>
    <details class="group relative">
      <summary class="flex min-h-16 cursor-pointer list-none flex-col items-center justify-center gap-1 px-1 text-[10px] font-semibold text-virya-muted transition-colors marker:content-none"><svg data-staff-icon aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>Więcej</summary>
      <div class="absolute bottom-[calc(100%+.5rem)] right-2 w-48 rounded-lg border border-virya-edge bg-virya-surface p-1.5 shadow-2xl">
        <a href="/staff/?tab=ticketing" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Bilety</a>
        <a href="/staff/?tab=admission" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Goście</a>
        <a href="/staff/?tab=signal" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Sygnał</a>
        <a href="/staff/?tab=beacons" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Latarnicy</a>
        <a href="/staff/?tab=releases" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Wydania</a>
        <a href="/staff/accounting/" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Rozliczenia</a>
        <a href="/staff/pair/" class="flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-virya-text transition-colors hover:bg-white/[.04]">Urządzenia</a>
      </div>
    </details>
  </nav>
</div>

<script is:inline define:vars={{ ACTIVE_LINK, IDLE_LINK }}>
  // The console switches sections in the browser, so the sidebar has to follow
  // the tab it lands on instead of staying on whatever the server rendered.
  const nav = document.querySelector("[data-staff-nav]")
  if (nav) {
    const active = ACTIVE_LINK.split(" ")
    const idle = IDLE_LINK.split(" ")
    const paint = tab => {
      for (const link of nav.querySelectorAll("[data-staff-tab]")) {
        const current = link.dataset.staffTab === tab
        link.classList.remove(...(current ? idle : active))
        link.classList.add(...(current ? active : idle))
        if (current) link.setAttribute("aria-current", "page")
        else link.removeAttribute("aria-current")
      }
    }
    addEventListener("staff:tab", event => paint(event.detail))
  }
</script>
