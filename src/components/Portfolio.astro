---
import { t, lp, type Lang } from "../i18n/t"
import items from "./portfolio/items.json"
import BlurImage from "./BlurImage.astro"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")
---

<div class="virya-section border-t border-zinc-800/60">
  <div class="virya-section__inner">
    <p class="virya-eyebrow">VIRYA // MUSIC</p>
    <h2 class="virya-heading mt-4">{t(lang, "music.heading")}</h2>
    <p class="virya-copy mt-5 mb-10">{t(lang, "music.sub")}</p>

    <div class="grid grid-cols-1 gap-1 overflow-hidden lg:grid-cols-3">
    {items.map((item) => {
      const text = lang === "pl" && item.text_pl ? item.text_pl : item.text
      const slug = slugify(item.title)
      return (
        <div class="relative group block overflow-hidden border border-amber-400/25 hover:border-amber-400/70 transition-colors duration-300">
          <div class="z-10 absolute inset-x-0 bottom-0 bg-gradient-to-t from-black via-black/85 to-transparent translate-y-1 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 max-lg:opacity-100 max-lg:translate-y-0 transition-all duration-300 ease-out px-4 pt-12 pb-5">
            <h3 class="text-sm lg:text-base font-black uppercase tracking-wide leading-tight mb-1">
              <a href={lp(lang, `/music/${slug}`)} class="hover:text-amber-400 transition-colors">
                {item.title}
              </a>
            </h3>
            <p class="text-xs text-justify text-zinc-400 leading-snug mb-3 line-clamp-4">{text}</p>
            <div class="flex gap-2 flex-wrap">
              {item.link && (
                <a href={item.link} rel="noreferrer" target="_blank" class="virya-button virya-button--accent-outline">
                  {t(lang, "music.listen")}
                </a>
              )}
              {item.watch && (
                <a href={item.watch} rel="noreferrer" target="_blank" class="virya-button virya-button--accent-outline">
                  {t(lang, "music.watch")}
                </a>
              )}
              {item.buy && (
                <a href={item.buy} rel="noreferrer" target="_blank" class="virya-button virya-button--accent-outline">
                  {t(lang, "music.buy")}
                </a>
              )}
              {item.merch && (
                <a href={lp(lang, item.merch)} class="virya-button virya-button--primary">
                  {t(lang, "music.merch")}
                </a>
              )}
            </div>
          </div>
          <a href={lp(lang, `/music/${slug}/`)} aria-label={item.title} class="block w-full aspect-square object-cover">
            <BlurImage
              src={`/covers/${item.src}`}
              alt={item.alt}
              loading="lazy"
              decoding="async"
              width="760"
              height="760"
              sizes="(max-width: 1023px) calc(100vw - 2rem), 400px"
              class="block w-full aspect-square object-cover rounded-sm transition-opacity duration-200 group-hover:opacity-80"
            />
          </a>
        </div>
      )
    })}
    </div>
  </div>
</div>
