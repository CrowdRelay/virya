---
import { t, lp, type Lang } from "../i18n/t"
import items from "./portfolio/items.json"
import BlurImage from "./BlurImage.astro"
import SectionHeading from "./SectionHeading.astro"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")
---

<div class="virya-section border-t border-zinc-800/60">
  <div class="virya-section__inner">
    <SectionHeading eyebrow="VIRYA // MUSIC" sub={t(lang, "music.sub")} class="mb-10">
      {t(lang, "music.heading")}
    </SectionHeading>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => {
        const text = lang === "pl" && item.text_pl ? item.text_pl : item.text
        const slug = slugify(item.title)
        const detailHref = lp(lang, `/music/${slug}/`)
        return (
          <article class="group border-t border-zinc-800 pt-4">
            <a href={detailHref} aria-label={item.title} class="block aspect-square overflow-hidden bg-zinc-900/40">
              <BlurImage
                src={`/covers/${item.src}`}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                width="760"
                height="760"
                sizes="(max-width: 639px) calc(100vw - 2.5rem), (max-width: 1023px) calc((100vw - 4rem) / 2), 400px"
                class="h-full w-full object-cover transition-[filter,transform] duration-200 group-hover:brightness-110 lg:group-hover:scale-[1.01]"
              />
            </a>

            <div class="pt-4">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <h3 class="text-base font-black leading-tight tracking-tight text-white">
                    <a href={detailHref} class="transition-colors hover:text-amber-300">
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-2 line-clamp-3 text-sm leading-6 text-zinc-400">{text}</p>
                </div>
                <a
                  href={detailHref}
                  class="flex min-h-11 min-w-11 shrink-0 items-center justify-center text-amber-300 transition-transform group-hover:translate-x-0.5"
                  aria-label={`${item.title}: ${lang === "pl" ? "szczegóły" : "details"}`}
                >
                  →
                </a>
              </div>

              {item.link && (
                <a
                  href={item.link}
                  rel="noreferrer"
                  target="_blank"
                  aria-label={`${t(lang, "music.listen")}: ${item.title}`}
                  class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-zinc-300 transition-colors hover:text-amber-300"
                >
                  {t(lang, "music.listen")} ↗
                </a>
              )}
            </div>
          </article>
        )
      })}
    </div>
  </div>
</div>
