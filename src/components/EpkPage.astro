---
import Layout from "./Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import ScrollToTop from "./ScrollToTop.astro"
import BlurImage from "./BlurImage.astro"
import ManagerEcosystem from "./ManagerEcosystem.astro"
import { t, lp, type Lang } from "../i18n/t"
import { getSeoTags } from "../utils/seo"
import items from "./portfolio/items.json"
import { THOMANN_HOME_URL, thomannAffiliateUrl } from "../lib/thomann"

interface Props { lang: Lang }
const { lang } = Astro.props
const { canonicalUrl, hreflangLinks } = getSeoTags("/epk/", lang)
const title = `${t(lang, "epk.heading")} | Virya`
const description = t(lang, "epk.bio1").slice(0, 155) + "…"
const thomannEpkUrl = thomannAffiliateUrl(THOMANN_HOME_URL, "epk")
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")
const members = [
  ["Wojciech Bator", "band.roles.guitar"],
  ["Marcin Janusiński", "band.roles.vocals"],
  ["Jakub Dąbrowski", "band.roles.drums"],
  ["Lubomyr Kosakovsky", "band.roles.bass"],
]
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map(l => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
  </Fragment>

  <div class="min-h-screen bg-zinc-950">
    <Navbar lang={lang} displayLinks={true} activePage="epk" />
    <ScrollToTop />

    <main id="main-content" class="pt-20">
      <section class="virya-section pb-12">
        <div class="virya-section__inner grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(360px,.7fr)] lg:items-end">
          <header>
            <p class="virya-eyebrow">VIRYA // EPK</p>
            <h1 class="virya-display mt-5">{t(lang, "epk.heading")}</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-300">{t(lang, "epk.bio2")}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="mailto:virya.crew@gmail.com?subject=Booking%20VIRYA" class="virya-button virya-button--primary">
                {lang === "pl" ? "Booking VIRYA" : "Book VIRYA"} <span aria-hidden="true">→</span>
              </a>
              <a href="/techrider.pdf" download class="virya-button virya-button--secondary">
                {t(lang, "epk.riderDownload")}
              </a>
            </div>
          </header>

          <a href="https://www.youtube.com/@ViryaOfficial/videos" target="_blank" rel="noreferrer" class="group relative block overflow-hidden">
            <BlurImage
              src="/showcase-poster.webp"
              alt={lang === "pl" ? "VIRYA — zobacz live video" : "VIRYA — watch live video"}
              width="800"
              height="800"
              loading="eager"
              decoding="async"
              sizes="(max-width: 1023px) calc(100vw - 2.5rem), 520px"
              class="aspect-square w-full object-cover transition-[filter,transform] duration-300 group-hover:brightness-110 lg:group-hover:scale-[1.01]"
            />
            <span class="absolute bottom-0 left-0 bg-[#07100e]/90 px-4 py-3 text-[11px] font-black uppercase tracking-[.12em] text-amber-200">
              {lang === "pl" ? "Zobacz VIRYA live ↗" : "Watch VIRYA live ↗"}
            </span>
          </a>
        </div>
      </section>

      <section class="virya-section virya-surface">
        <div class="virya-section__inner grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
          <div class="space-y-14">
            <section>
              <p class="virya-eyebrow text-zinc-500">{t(lang, "epk.bioHeading")}</p>
              <div class="mt-5 max-w-3xl space-y-5 text-base leading-8 text-zinc-300">
                <p>{t(lang, "epk.bio1")}</p>
                <p>{t(lang, "epk.bio2")}</p>
              </div>
            </section>

            <section class="grid gap-px border-y border-zinc-800 bg-zinc-800 sm:grid-cols-2">
              <div class="bg-zinc-950 p-5 sm:p-6">
                <p class="virya-eyebrow text-zinc-500">{t(lang, "epk.ffoLabel")}</p>
                <p class="mt-3 text-sm leading-6 text-zinc-200">{t(lang, "epk.ffo")}</p>
              </div>
              <div class="bg-zinc-950 p-5 sm:p-6">
                <p class="virya-eyebrow text-zinc-500">{t(lang, "epk.styleLabel")}</p>
                <p class="mt-3 text-sm leading-6 text-zinc-200">{t(lang, "epk.style")}</p>
              </div>
            </section>

            <ManagerEcosystem lang={lang} />

            <section>
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                  <p class="virya-eyebrow text-zinc-500">VIRYA // DISCOGRAPHY</p>
                  <h2 class="mt-3 text-3xl font-black uppercase tracking-tight text-white">{t(lang, "epk.releases")}</h2>
                </div>
              </div>
              <ul class="mt-6 divide-y divide-zinc-800/70 border-y border-zinc-800/70">
                {items.map(item => (
                  <li class="grid grid-cols-[64px_1fr_auto] items-center gap-4 py-4">
                    <img src={`/covers/${item.src}`} alt={item.alt} width="64" height="64" loading="lazy" class="h-16 w-16 object-cover" />
                    <div class="min-w-0">
                      <a href={lp(lang, `/music/${slugify(item.title)}/`)} class="font-bold text-zinc-100 transition-colors hover:text-amber-300">{item.title}</a>
                    </div>
                    <div class="hidden gap-3 text-[11px] font-bold uppercase tracking-[.08em] text-zinc-500 sm:flex">
                      {item.link && <a href={item.link} target="_blank" rel="noreferrer" class="hover:text-amber-300">Spotify</a>}
                      {item.watch && <a href={item.watch} target="_blank" rel="noreferrer" class="hover:text-amber-300">Video</a>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          </div>

          <aside class="space-y-10">
            <section>
              <p class="virya-eyebrow text-zinc-500">{t(lang, "epk.lineup")}</p>
              <ul class="mt-5 border-y border-zinc-800/80">
                {members.map(([name, roleKey]) => (
                  <li class="border-b border-zinc-800/70 py-4 last:border-0">
                    <p class="text-sm font-bold text-zinc-100">{name}</p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-[.09em] text-zinc-500">{t(lang, roleKey)}</p>
                  </li>
                ))}
              </ul>
            </section>

            <section>
              <p class="virya-eyebrow text-zinc-500">{lang === "pl" ? "Produkcja" : "Production"}</p>
              <p class="mt-4 text-sm leading-6 text-zinc-400">{t(lang, "epk.riderText")}</p>
              <a href="/techrider.pdf" download class="virya-button virya-button--secondary mt-5 w-full">{t(lang, "epk.riderDownload")}</a>
            </section>

            <section>
              <p class="virya-eyebrow text-zinc-500">{lang === "pl" ? "Partnerzy" : "Partners"}</p>
              <div class="mt-4 divide-y divide-zinc-800/60 border-y border-zinc-800/60 text-sm">
                <a href="https://www.davidlaboga.com/cables.html" target="_blank" rel="noopener noreferrer" class="flex min-h-12 items-center text-zinc-300 hover:text-amber-300">Laboga Cables <span class="ml-auto">↗</span></a>
                <a href={thomannEpkUrl} target="_blank" rel="sponsored noopener noreferrer" class="flex min-h-12 items-center text-zinc-300 hover:text-amber-300">Thomann <span class="ml-auto">↗</span></a>
                <a href={lp(lang, "/gear/")} class="flex min-h-12 items-center text-zinc-300 hover:text-amber-300">{lang === "pl" ? "Sprzęt VIRYA" : "VIRYA gear"} <span class="ml-auto">→</span></a>
              </div>
            </section>

            <section>
              <p class="virya-eyebrow text-zinc-500">{t(lang, "epk.contact")}</p>
              <div class="mt-4 border-y border-zinc-800/70 py-4">
                <a href="mailto:virya.crew@gmail.com" class="block text-sm font-bold text-amber-200">virya.crew@gmail.com</a>
                <a href="tel:+48574090338" class="mt-2 block text-sm text-zinc-400">+48 574 090 338 · Jakub</a>
              </div>
            </section>

            <a href="https://drive.google.com/drive/folders/1M4pgB9goigGUm9tudcQIzORTgILgSABH?usp=drive_link" target="_blank" rel="noreferrer" class="virya-button virya-button--secondary w-full">
              Press pack ↗
            </a>
          </aside>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
