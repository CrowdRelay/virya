---
import Layout from "./Layout.astro"
import Navbar from "./Navbar.astro"
import Footer from "./Footer.astro"
import ScrollToTop from "./ScrollToTop.astro"
import SignalHub from "./preact/signal/SignalHub"
import SynesthesiaLeaderboard from "./SynesthesiaLeaderboard.astro"
import SignalCampaignIntro from "./preact/signal/SignalCampaignIntro"
import SectionHeading from "./SectionHeading.astro"
import { SIGNAL_COPY } from "../data/signalCopy"
import { VIRYA_GROUP_REF } from "../data/viryaIdentity"
import { getSeoTags } from "../utils/seo"
import { lp, type Lang } from "../i18n/t"

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props
const copy = SIGNAL_COPY[lang]
const benefits = lang === "pl"
  ? [
      {
        number: "01",
        title: "Koncerty blisko Ciebie",
        body: "Wybierasz miasto i widzisz najważniejsze koncerty VIRYA bez przekopywania sociali.",
      },
      {
        number: "02",
        title: "Twoje rzeczy w jednym miejscu",
        body: "Obserwowane koncerty, polecenia i nagrody zostają przy Twoim prywatnym Sygnałe.",
      },
      {
        number: "03",
        title: "Bliżej VIRYA, bez spamu",
        body: "Dostajesz tylko rzeczy, które mają znaczenie: koncert, premiera albo aktywna akcja zespołu.",
      },
    ]
  : [
      {
        number: "01",
        title: "Shows near you",
        body: "Choose your city and see the VIRYA shows that matter without digging through social feeds.",
      },
      {
        number: "02",
        title: "Your stuff in one place",
        body: "Followed shows, referrals and rewards stay attached to your private Signal.",
      },
      {
        number: "03",
        title: "Closer to VIRYA, without spam",
        body: "Get only meaningful updates: a show, a release or an active band action.",
      },
    ]

const { canonicalUrl, hreflangLinks } = getSeoTags("/signal/", lang)
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: lang === "pl" ? "Sygnał Virya" : "Virya Signal",
  url: canonicalUrl,
  description: copy.meta.description,
  applicationCategory: "EntertainmentApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  inLanguage: lang,
  creator: VIRYA_GROUP_REF,
}
---

<Layout
  title={copy.meta.title}
  description={copy.meta.description}
  canonical={canonicalUrl}
  lang={lang}
  ogImage="https://virya.music/poster.webp"
>
  <Fragment slot="head">
    {hreflangLinks.map(link => <link rel={link.rel} hreflang={link.hreflang} href={link.href} />)}
    <link rel="dns-prefetch" href="https://signal-api.virya.music" />
    <link rel="preconnect" href="https://signal-api.virya.music" crossorigin="anonymous" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
  </Fragment>

  <div class="flex min-h-screen flex-col bg-zinc-950">
    <Navbar lang={lang} displayLinks={true} activePage="signal" />
    <ScrollToTop />

    <main id="main-content" class="flex-1">
      <header class="relative overflow-hidden border-b border-zinc-800/60 px-5 pb-16 pt-[calc(8rem+env(safe-area-inset-top))] sm:px-8 sm:pb-20 lg:px-12 lg:pb-28 lg:pt-40">
        <div class="signal-hero-grid absolute inset-0 opacity-60" aria-hidden="true"></div>
        <div class="absolute left-[6%] top-32 h-72 w-72 rounded-full bg-amber-400/[.08] blur-[120px]" aria-hidden="true"></div>
        <SignalCampaignIntro client:load lang={lang} />
      </header>

      <SignalHub client:load lang={lang} />

      <section class="virya-section virya-surface" aria-labelledby="signal-benefits-heading">
        <div class="virya-section__inner">
          <SectionHeading
            eyebrow={lang === "pl" ? "Po co Sygnał" : "Why Signal"}
            headingId="signal-benefits-heading"
            class="max-w-4xl"
          >
            {lang === "pl" ? "Jedna prosta relacja z zespołem" : "One simple connection to the band"}
          </SectionHeading>
          <div class="mt-10 grid gap-px border-y border-zinc-800 bg-zinc-800 md:grid-cols-3">
            {benefits.map(item => (
              <article class="bg-zinc-950 px-5 py-7 sm:px-7 sm:py-8">
                <span class="font-mono text-[11px] font-black text-amber-300">{item.number}</span>
                <h3 class="mt-8 text-xl font-black uppercase leading-tight text-white">{item.title}</h3>
                <p class="mt-4 text-sm leading-7 text-zinc-400">{item.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <SynesthesiaLeaderboard compact lang={lang} />

      <section class="virya-section signal-deferred border-t border-zinc-800/60">
        <div class="virya-section__inner grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <SectionHeading eyebrow={copy.area.eyebrow} sub={copy.area.body} subClass="text-zinc-300" class="max-w-4xl">
            {copy.area.heading}
          </SectionHeading>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href={lp(lang, "/area/")} class="virya-button virya-button--primary">{copy.area.cta}</a>
            <a href={lp(lang, "/merch/")} class="virya-button virya-button--secondary">{copy.area.merch}</a>
          </div>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .signal-hero-grid {
    background-image:
      linear-gradient(rgb(132 180 172 / .045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(132 180 172 / .045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }

  @supports (content-visibility: auto) {
    .signal-deferred {
      content-visibility: auto;
      contain-intrinsic-size: 760px;
    }
  }
</style>
