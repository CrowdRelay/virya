---
import { t, type Lang } from "../i18n/t"
import BlurImage from "./BlurImage.astro"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props
---

<div class="py-16 lg:px-8 border-t border-zinc-800/60">
  <div class="mx-4">
    <div class="flex items-center gap-4 mb-2">
      <p class="text-3xl font-black uppercase tracking-widest whitespace-nowrap text-white">
        {t(lang, "showcase.heading")}
      </p>
      <div class="flex-1 h-px bg-zinc-800" />
    </div>
    <p class="text-zinc-400 text-xs uppercase tracking-widest mb-8">
      {t(lang, "showcase.sub")}
    </p>

    <div class="relative max-w-2xl mx-auto aspect-square overflow-hidden border border-zinc-800/60 bg-zinc-950" id="showcase-container">
      <BlurImage
        src="/showcase-poster.webp"
        alt={t(lang, "showcase.play")}
        width="672"
        height="672"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-80"
        id="showcase-poster"
      />
      <video
        id="showcase-video"
        class="absolute inset-0 w-full h-full object-cover hidden"
        src="/showcase-web.mp4"
        poster="/showcase-poster.webp"
        controls
        playsinline
        preload="none"
        aria-label={t(lang, "showcase.play")}
      />
      <button
        id="showcase-btn"
        aria-label={t(lang, "showcase.play")}
        class="group block absolute inset-0 w-full h-full cursor-pointer"
        type="button"
      >
        <span
          id="showcase-play-icon"
          class="absolute inset-0 flex items-center justify-center"
          aria-hidden="true"
        >
          <span class="flex items-center justify-center w-16 h-16 rounded-full bg-amber-400 text-black shadow-lg shadow-black/40 transition-transform duration-200 group-hover:scale-110">
            <svg class="w-6 h-6 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("showcase-btn")
    const video = document.getElementById("showcase-video") as HTMLVideoElement | null
    const poster = document.getElementById("showcase-poster")
    const icon = document.getElementById("showcase-play-icon")
    if (!btn || !video || !poster) return

    let playing = false

    btn.addEventListener("click", () => {
      playing = !playing
      if (playing) {
        poster.classList.add("hidden")
        video.classList.remove("hidden")
        video.play().catch(() => {})
        if (icon) {
          icon.innerHTML = `<svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 text-black"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>`
        }
      } else {
        video.pause()
        video.classList.add("hidden")
        poster.classList.remove("hidden")
        if (icon) {
          icon.innerHTML = `<svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 text-black ml-1"><path d="M8 5v14l11-7z"/></svg>`
        }
      }
    })
  })
</script>
