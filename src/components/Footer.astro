---
import SocialLinks from "./SocialLinks.astro"
import { t, lp, type Lang } from "../i18n/t"
import { THOMANN_HOME_URL, thomannAffiliateUrl } from "../lib/thomann"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props
const thomannFooterUrl = thomannAffiliateUrl(THOMANN_HOME_URL, "footer")
---

<footer class="bg-zinc-950 border-t border-zinc-800/50 py-8">
  <div class="virya-section__inner px-6 lg:px-12">
    <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 items-center">
    <div class="justify-self-center lg:justify-self-start flex flex-col gap-2">
      <p class="text-zinc-400 text-xs uppercase tracking-widest mb-0">&copy; Virya</p>
      <div class="flex flex-wrap justify-center lg:justify-start gap-x-4 gap-y-1">
        <a href={lp(lang, "/legal/terms")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.terms")}</a>
        <a href={lp(lang, "/legal/returns")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.returns")}</a>
        <a href={lp(lang, "/legal/privacy")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.privacy")}</a>
        <a href={lp(lang, "/legal/data-deletion")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.dataDeletion")}</a>
        <a href={lp(lang, "/epk")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.press")}</a>
        <a href={lp(lang, "/videos/")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.videos")}</a>
        <a href={lp(lang, "/gallery/")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.gallery")}</a>
        <a href={lp(lang, "/news/")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.news")}</a>
        <a href={lp(lang, "/signal/")} class="inline-flex items-center min-h-12 text-amber-400/80 hover:text-amber-300 transition-colors text-[10px] font-bold uppercase tracking-widest">{t(lang, "footer.signal")}</a>
        <a href={lp(lang, "/area/")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "footer.area")}</a>
        <a href={lp(lang, "/latarnik/")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{t(lang, "nav.latarnik")}</a>
        <a href={lp(lang, "/gear/")} class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">{lang === "pl" ? "Sprzęt" : "Gear"}</a>
        <a href={thomannFooterUrl} target="_blank" rel="sponsored noopener noreferrer" class="inline-flex items-center min-h-12 text-amber-300/80 hover:text-amber-200 transition-colors text-[10px] font-bold uppercase tracking-widest">{lang === "pl" ? "Kupuj w Thomann ↗" : "Shop Thomann ↗"}</a>
        <a href="https://www.wojciechbator.me" rel="author noreferrer" target="_blank" class="inline-flex items-center min-h-12 text-zinc-400 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest">Built by Wojciech Bator</a>
      </div>
    </div>

    <SocialLinks />
    </div>
  </div>
</footer>
