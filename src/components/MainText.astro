---
import { t, lp, type Lang } from "../i18n/t"

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props
---

<div class="relative z-10 my-auto flex w-full flex-col px-5 pb-12 pt-28 sm:px-8 lg:px-12">
  <div class="virya-container--wide">
    <div class="max-w-5xl border-l border-amber-400/70 pl-5 sm:pl-7 lg:pl-9">
      <p class="virya-eyebrow mb-5 [text-shadow:0_1px_12px_rgba(0,0,0,.85)]">
        {t(lang, "hero.eyebrow")}
      </p>
      <h1 class="m-0 [text-shadow:0_3px_28px_rgba(0,0,0,.88)]">
        <span class="virya-display block max-w-5xl">
          {t(lang, "hero.title")}
        </span>
        <span class="mt-3 block max-w-3xl text-base font-semibold leading-snug tracking-[.01em] text-zinc-200 sm:text-xl lg:text-2xl">
          {t(lang, "hero.subtitle")}
        </span>
      </h1>
      <p class="mt-7 max-w-2xl text-[15px] leading-7 text-zinc-200 [text-shadow:0_1px_10px_rgba(0,0,0,.9)] sm:text-base">
        {t(lang, "hero.body")}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#shows" class="virya-button virya-button--primary">
          {lang === "pl" ? "Koncerty" : "Live"} <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://youtube.com/@ViryaOfficial/videos"
          target="_blank"
          rel="noreferrer"
          aria-label={lang === "pl" ? "Oglądaj kanał VIRYA na YouTube" : "Watch VIRYA on YouTube"}
          class="virya-button virya-button--secondary"
        >
          {t(lang, "hero.watch")} <span aria-hidden="true">↗</span>
        </a>
        <a href="#music" class="inline-flex min-h-12 items-center px-2 text-[11px] font-black uppercase tracking-[.12em] text-zinc-300 transition-colors hover:text-amber-300">
          {t(lang, "hero.listen")} →
        </a>
      </div>

      <p class="mt-6 text-xs text-zinc-400 [text-shadow:0_1px_8px_rgba(0,0,0,.9)]">
        {t(lang, "hero.bookingQ")} {" "}
        <a href="#contact" class="text-amber-300 underline underline-offset-4 transition-colors hover:text-amber-200">
          {t(lang, "hero.getInTouch")}
        </a>.
      </p>
      <p class="mt-3 text-xs text-zinc-400 [text-shadow:0_1px_8px_rgba(0,0,0,.9)]">
        {lang === "pl"
          ? "Koncerty i alerty w Twoim mieście — "
          : "Show alerts in your city — "}
        <a href={lp(lang, "/signal/")} class="text-amber-300 underline underline-offset-4 transition-colors hover:text-amber-200">
          {lang === "pl" ? "Dołącz do Sygnału" : "Join Signal"}
        </a>.
      </p>
    </div>
  </div>
</div>
