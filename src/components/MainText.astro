---
import { t, lp, type Lang } from "../i18n/t"

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props
---

<div class="relative z-10 my-auto flex w-full flex-col px-5 pb-12 pt-28 sm:px-8 lg:px-12">
  <div class="virya-container--wide">
    <div class="max-w-5xl">
      <p class="virya-eyebrow mb-5">
        {t(lang, "hero.eyebrow")}
      </p>

      <h1 class="m-0">
        <span class="virya-display block max-w-5xl">
          {t(lang, "hero.title")}
        </span>
        <span class="mt-3 block max-w-3xl text-base font-semibold leading-snug tracking-[.01em] text-zinc-200 sm:text-xl lg:text-2xl">
          {t(lang, "hero.subtitle")}
        </span>
      </h1>

      <p class="mt-7 max-w-2xl text-[15px] leading-7 text-zinc-200 sm:text-base">
        {t(lang, "hero.body")}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#shows" class="virya-button virya-button--primary">
          {lang === "pl" ? "Koncerty" : "Shows"} <span aria-hidden="true">→</span>
        </a>
        <a href={lp(lang, "/signal/")} class="virya-button virya-button--secondary">
          {lang === "pl" ? "Dołącz do Sygnału" : "Join Signal"} <span aria-hidden="true">→</span>
        </a>
      </div>

      <nav
        class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-zinc-300"
        aria-label={lang === "pl" ? "Skróty VIRYA" : "VIRYA shortcuts"}
      >
        <a
          href="https://youtube.com/@ViryaOfficial/videos"
          target="_blank"
          rel="noreferrer"
          class="transition-colors hover:text-amber-300"
        >
          {t(lang, "hero.watch")} ↗
        </a>
        <a href="#music" class="transition-colors hover:text-amber-300">
          {t(lang, "hero.listen")} →
        </a>
        <a href="#contact" class="transition-colors hover:text-amber-300">
          {t(lang, "hero.getInTouch")} →
        </a>
      </nav>
    </div>
  </div>
</div>
