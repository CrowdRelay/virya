---
// Inline Google Play badge — no external image request, CSP-safe.
// Links to the Virya Signal app on Google Play by default; pass `appId` to
// point at a different app (e.g. "music.virya.synesthesia").
interface Props {
  lang?: "en" | "pl"
  size?: "sm" | "md"
  appId?: string
}
const { lang = "en", size = "md", appId = "music.virya.signal" } = Astro.props
const alt = lang === "pl" ? "Pobierz w Google Play" : "Get it on Google Play"
const height = size === "sm" ? 40 : 48
---

<a
  href={`https://play.google.com/store/apps/details?id=${appId}`}
  target="_blank"
  rel="noopener noreferrer"
  class="play-store-badge"
  aria-label={alt}
  style={`--badge-h:${height}px`}
>
  <svg viewBox="0 0 512 512" width={height * 0.85} height={height * 0.85} aria-hidden="true" fill="none">
    <path d="M328.1 256L90.3 18.2C83.2 21.1 78 28.1 78 36.3v439.4c0 8.2 5.2 15.2 12.3 18.1L328.1 256Z" fill="#EA4335"/>
    <path d="M342.3 172.4L265.8 248.9L342.3 325.4L424 256Z" fill="#FBBC04"/>
    <path d="M328.1 256L90.3 493.8c2.9 1.2 6.1 1.9 9.5 1.9 4.3 0 8.4-1.2 12-3.3l312.1-180L424 256Z" fill="#34A853"/>
    <path d="M90.3 18.2c-2.9 1.2-5.5 3.1-7.6 5.5L265.8 248.9L90.3 18.2Z" fill="#C1DAE8" opacity="0"/>
    <path d="M265.8 248.9L82.7 23.7C80.1 26.7 78 30.8 78 36.3v439.4c0 5.5 2.1 9.6 4.7 12.6L265.8 248.9Z" fill="#4285F4"/>
  </svg>
  <span class="play-store-text">
    <small>{lang === "pl" ? "Pobierz w" : "Get it on"}</small>
    <strong>Google Play</strong>
  </span>
</a>

<style>
  .play-store-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    height: var(--badge-h);
    padding-inline: 0.875rem;
    border: 1px solid rgb(63 63 70);
    border-radius: 0.375rem;
    background: #000;
    transition: border-color 150ms ease, transform 150ms ease;
    text-decoration: none;
  }
  .play-store-badge:hover {
    border-color: var(--virya-signal, #84b4ac);
  }
  .play-store-badge:active {
    transform: translateY(1px);
  }
  .play-store-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    color: #fff;
  }
  .play-store-text small {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgb(161 161 170);
  }
  .play-store-text strong {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
</style>
