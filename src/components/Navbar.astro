---
import { t, lp, type Lang } from "../i18n/t"
import BlurImage from "./BlurImage.astro"

interface Props {
  lang?: Lang
  displayLinks?: boolean
  activePage?: string
}

const { lang = "en", displayLinks = false, activePage = "" } = Astro.props

const homeSectionHref = (section: string) => activePage === "home" ? `#${section}` : lp(lang, `/#${section}`)

const primary = [
  { key: "live", href: homeSectionHref("shows"), label: t(lang, "nav.shows"), section: "shows" },
  { key: "music", href: homeSectionHref("music"), label: t(lang, "nav.music"), section: "music" },
  { key: "signal", href: lp(lang, "/signal/"), label: t(lang, "nav.signal"), section: undefined },
  { key: "merch", href: lp(lang, "/merch/"), label: t(lang, "nav.merch"), section: undefined },
  { key: "about", href: lp(lang, "/about/"), label: t(lang, "nav.band"), section: undefined },
]

const more = [
  { key: "videos", href: lp(lang, "/videos/"), label: t(lang, "nav.videos"), section: undefined },
  { key: "gallery", href: lp(lang, "/gallery/"), label: t(lang, "nav.gallery"), section: undefined },
  { key: "lyrics", href: lp(lang, "/lyrics/"), label: t(lang, "lyrics.heading"), section: undefined },
  { key: "gear", href: lp(lang, "/gear/"), label: lang === "pl" ? "Sprzęt" : "Gear", section: undefined },
  { key: "epk", href: lp(lang, "/epk/"), label: t(lang, "nav.epk"), section: undefined },
  { key: "contact", href: homeSectionHref("contact"), label: t(lang, "nav.contact"), section: "contact" },
]

const moreActive = more.some(item => item.key === activePage)
---

<nav
  id="main-nav"
  aria-label={lang === "pl" ? "Główna nawigacja" : "Main navigation"}
  class="fixed inset-x-0 top-0 z-40 border-b border-[#27322f]/80 bg-[#070908]/95 px-4 py-2 transition-[background-color,border-color,transform] duration-200 sm:px-6 lg:px-8"
>
  <div class="virya-container--wide flex min-h-[64px] items-center gap-5">
    <a
      title={t(lang, "nav.home")}
      class="logo-link group flex min-h-12 min-w-12 shrink-0 items-center justify-center"
      href={lp(lang, "/")}
      aria-label={t(lang, "nav.home")}
    >
      <BlurImage
        src="/virya.webp"
        title="Virya"
        loading="eager"
        alt="Virya"
        width="46"
        height="46"
        sizes="46px"
        class:list={[
          "logo-ring h-[46px] w-[46px] rounded-full ring-1 ring-offset-2 ring-offset-black/80 transition-[filter,box-shadow,transform] duration-200 group-hover:brightness-110",
          activePage === "home" ? "ring-amber-300" : "ring-amber-400/45",
        ]}
      />
    </a>

    {displayLinks && (
      <div class="hidden min-w-0 flex-1 items-center justify-center lg:flex">
        <div class="flex items-center gap-0.5">
          {primary.map(item => (
            <a
              href={item.href}
              data-section={item.section}
              aria-current={activePage === item.key ? "page" : undefined}
              class:list={[
                "nav-link inline-flex min-h-12 items-center px-3 text-[11px] font-extrabold uppercase tracking-[.14em] transition-colors xl:px-4",
                activePage === item.key
                  ? "text-amber-300"
                  : "text-zinc-300 hover:text-amber-300",
              ]}
            >
              {item.label}
            </a>
          ))}

          <details class="group/more relative">
            <summary
              class:list={[
                "inline-flex min-h-12 cursor-pointer list-none items-center gap-2 px-3 text-[11px] font-extrabold uppercase tracking-[.14em] transition-colors marker:content-none xl:px-4",
                moreActive ? "text-amber-300" : "text-zinc-300 hover:text-amber-300",
              ]}
            >
              {lang === "pl" ? "Więcej" : "More"}
              <span aria-hidden="true" class="text-[10px] transition-transform group-open/more:rotate-180">▾</span>
            </summary>
            <div class="absolute right-0 top-[calc(100%+.5rem)] min-w-52 border border-zinc-800/90 bg-[#0b100f]/98 p-2 shadow-2xl shadow-black/50">
              {more.map(item => (
                <a
                  href={item.href}
                  data-section={item.section}
                  aria-current={activePage === item.key ? "page" : undefined}
                  class:list={[
                    "nav-link flex min-h-12 items-center border-b border-white/[.045] px-3 text-[11px] font-bold uppercase tracking-[.13em] transition-colors last:border-0",
                    activePage === item.key
                      ? "text-amber-300"
                      : "text-zinc-300 hover:bg-white/[.035] hover:text-amber-300",
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </div>
      </div>
    )}

    <div class="ml-auto flex shrink-0 items-center gap-1">
      <div class="flex items-center text-[10px] font-extrabold uppercase tracking-[.14em]" aria-label={t(lang, "nav.language")}>
        <button
          data-lang-switch="en"
          class:list={[
            "inline-flex min-h-12 min-w-12 items-center justify-center transition-colors",
            lang === "en" ? "text-amber-300" : "text-zinc-400 hover:text-zinc-100",
          ]}
          aria-label="EN — Switch to English"
          aria-current={lang === "en" ? "true" : undefined}
        >EN</button>
        <span class="text-zinc-700" aria-hidden="true">/</span>
        <button
          data-lang-switch="pl"
          class:list={[
            "inline-flex min-h-12 min-w-12 items-center justify-center transition-colors",
            lang === "pl" ? "text-amber-300" : "text-zinc-400 hover:text-zinc-100",
          ]}
          aria-label="PL — Przełącz na polski"
          aria-current={lang === "pl" ? "true" : undefined}
        >PL</button>
      </div>

      {displayLinks && (
        <button
          id="mobile-menu-btn"
          class="inline-flex min-h-12 min-w-12 items-center justify-center text-zinc-200 transition-colors hover:text-amber-300 lg:hidden"
          aria-label={t(lang, "nav.openMenu")}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-hamburger" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      )}
    </div>
  </div>

  {displayLinks && (
    <div
      id="mobile-menu"
      hidden
      class="virya-container--wide max-h-[calc(100svh-5.75rem)] overflow-y-auto border-t border-white/10 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3 lg:hidden"
    >
      <div class="grid">
        {primary.map(item => (
          <a
            href={item.href}
            data-section={item.section}
            aria-current={activePage === item.key ? "page" : undefined}
            class:list={[
              "mobile-nav-link nav-link flex min-h-[56px] items-center border-b border-white/[.055] py-3 text-lg font-black uppercase tracking-[-.015em] transition-colors",
              activePage === item.key ? "text-amber-300" : "text-zinc-100 hover:text-amber-300",
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="grid grid-cols-2 gap-x-5 pt-5">
        {more.map(item => (
          <a
            href={item.href}
            data-section={item.section}
            aria-current={activePage === item.key ? "page" : undefined}
            class:list={[
              "mobile-nav-link nav-link flex min-h-12 items-center border-b border-white/[.04] text-[11px] font-bold uppercase tracking-[.12em] transition-colors",
              activePage === item.key ? "text-amber-300" : "text-zinc-400 hover:text-amber-300",
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  )}
</nav>

<style>
  #main-nav.is-scrolled,
  #main-nav:has(#mobile-menu:not([hidden])) {
    border-bottom-color: rgb(39 50 47 / .86);
    background: rgb(7 9 8 / .98);
  }

  :global([data-area-experience] nav[aria-label="VIRYA Area modes"]) {
    top: 0;
    border-color: transparent;
    background: transparent;
    backdrop-filter: none;
  }

  :global([data-area-experience] nav[aria-label="VIRYA Area modes"] > div) {
    position: relative;
    isolation: isolate;
    transform: translateY(81px);
    transition: transform 200ms ease;
  }

  :global([data-area-experience] nav[aria-label="VIRYA Area modes"] > div::before) {
    content: "";
    position: absolute;
    inset: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    border-block: 1px solid rgb(39 39 42 / .8);
    background: rgb(7 9 8 / .95);
    backdrop-filter: blur(12px);
    z-index: -1;
  }
</style>

<script>
  function initNav() {
    window.__viryaNavController?.abort()
    const controller = new AbortController()
    window.__viryaNavController = controller
    const { signal } = controller
    const nav = document.getElementById("main-nav")
    if (!nav) return

    document.addEventListener("astro:before-preparation", () => controller.abort(), { once: true, signal })

    const areaNav = document.querySelector<HTMLElement>('[data-area-experience] nav[aria-label="VIRYA Area modes"] > div')
    const syncAreaToMainNav = () => {
      if (!areaNav) return
      const transform = nav.style.transform || getComputedStyle(nav).transform
      areaNav.style.transform = transform.includes("-100%")
        ? "translateY(0)"
        : "translateY(81px)"
    }
    const navObserver = new MutationObserver(syncAreaToMainNav)
    navObserver.observe(nav, { attributes: true, attributeFilter: ["style"] })
    syncAreaToMainNav()

    let lastY = window.scrollY
    let ticking = false
    const updateScrollState = () => {
      const y = window.scrollY
      nav.classList.toggle("is-scrolled", y > 18)
      if (document.body.style.position !== "fixed") {
        if (y < 18 || y < lastY) {
          nav.style.transform = "translateY(0)"
        } else if (y > lastY + 4) {
          nav.style.transform = "translateY(-100%)"
          closeMenu()
        }
      }
      lastY = y
      ticking = false
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(updateScrollState)
    }
    updateScrollState()
    window.addEventListener("scroll", onScroll, { passive: true, signal })

    function closeMenu() {
      const menu = document.getElementById("mobile-menu")
      const btn = document.getElementById("mobile-menu-btn")
      if (!menu || menu.hidden) return
      menu.hidden = true
      btn?.setAttribute("aria-expanded", "false")
      document.getElementById("icon-hamburger")?.classList.remove("hidden")
      document.getElementById("icon-close")?.classList.add("hidden")
    }

    const btn = document.getElementById("mobile-menu-btn")
    btn?.addEventListener("click", () => {
      const menu = document.getElementById("mobile-menu")
      if (!menu) return
      const opening = menu.hidden
      menu.hidden = !opening
      btn.setAttribute("aria-expanded", String(opening))
      document.getElementById("icon-hamburger")?.classList.toggle("hidden", opening)
      document.getElementById("icon-close")?.classList.toggle("hidden", !opening)
      if (opening) nav.style.transform = "translateY(0)"
    }, { signal })

    nav.querySelectorAll<HTMLElement>(".mobile-nav-link").forEach(link => {
      link.addEventListener("click", closeMenu, { signal })
    })

    const moreMenu = nav.querySelector<HTMLDetailsElement>("details")
    document.addEventListener("click", event => {
      const target = event.target
      if (moreMenu?.open && target instanceof Node && !moreMenu.contains(target)) moreMenu.open = false
    }, { signal })
    moreMenu?.addEventListener("keydown", event => {
      if (event.key !== "Escape") return
      moreMenu.open = false
      moreMenu.querySelector<HTMLElement>("summary")?.focus()
    }, { signal })

    nav.querySelectorAll<HTMLAnchorElement>("a[href*='#']").forEach(link => {
      link.addEventListener("click", event => {
        if (!link.hash) return
        const target = document.querySelector(link.hash)
        if (!target) return
        event.preventDefault()
        target.scrollIntoView({ behavior: "smooth" })
        closeMenu()
      }, { signal })
    })

    const logo = nav.querySelector<HTMLAnchorElement>("a.logo-link")
    logo?.addEventListener("click", event => {
      const path = window.location.pathname
      if (path !== "/" && path !== "/pl/" && path !== "/pl") return
      event.preventDefault()
      window.scrollTo({ top: 0, behavior: "smooth" })
    }, { signal })

    nav.querySelectorAll<HTMLElement>("[data-lang-switch]").forEach(element => {
      element.addEventListener("click", () => {
        const target = element.dataset.langSwitch ?? "en"
        try { localStorage.setItem("virya-lang", target) } catch {}
        const path = location.pathname
        const base = path.replace(/^(\/pl)+(?=\/|$)/, "") || "/"
        location.href =
          (target === "pl" ? (base === "/" ? "/pl/" : `/pl${base}`) : base) +
          location.search + location.hash
      }, { signal })
    })
  }

  if (!window.__viryaNavLifecycleInstalled) {
    window.__viryaNavLifecycleInstalled = true
    document.addEventListener("astro:page-load", initNav)
  }
  initNav()
</script>
