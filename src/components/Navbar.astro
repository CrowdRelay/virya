---
import { t, lp, type Lang } from "../i18n/t"
import BlurImage from "./BlurImage.astro"

interface Props {
  lang?: Lang
  displayLinks?: boolean
  activePage?: string
}
const { lang = "en", displayLinks = false, activePage = "" } = Astro.props
---

<nav
  id="main-nav"
  aria-label={lang === "pl" ? "Główna nawigacja" : "Main navigation"}
  class="fixed top-0 right-0 left-0 p-3 z-20 backdrop-blur-md bg-black/70 border-b border-white/5 transition-all duration-200"
>
  <div>
    <div class="container mx-auto flex items-center">
      <div class="flex flex-1 items-center">
        <a title={t(lang, "nav.home")} class={`group flex my-2 cursor-pointer logo-link`} href={lp(lang, "/")}>
          <BlurImage
            src="/virya.webp"
            title="Virya"
            loading="eager"
            alt="Virya logo"
            width="50"
            height="50"
            sizes="50px"
            class={`w-[50px] h-[50px] rounded-full ring-2 ring-offset-2 ring-offset-black transition-all duration-300 group-hover:ring-amber-400 group-hover:scale-110 group-hover:brightness-125 group-hover:shadow-[0_0_12px_rgba(251,191,36,0.5)] logo-ring ${activePage === "home" ? "ring-amber-400" : "ring-amber-400/40"}`}
          />
        </a>
      </div>

      <div class="hidden lg:flex items-center">
        {displayLinks && <a href={lp(lang, "/about")} aria-current={activePage === "about" ? "page" : undefined} class={`cursor-pointer lg:px-4 px-3 py-3 lg:py-2 text-xs font-semibold uppercase tracking-widest transition duration-300 ease-in-out ${activePage === "about" ? "text-amber-400" : "text-zinc-400 hover:text-amber-400"}`}>{t(lang, "nav.band")}</a>}
        {displayLinks && <a href={lp(lang, "/merch")} aria-current={activePage === "merch" ? "page" : undefined} class={`cursor-pointer lg:px-4 px-3 py-3 lg:py-2 text-xs font-semibold uppercase tracking-widest transition duration-300 ease-in-out ${activePage === "merch" ? "text-amber-400" : "text-zinc-400 hover:text-amber-400"}`}>{t(lang, "nav.merch")}</a>}
        {displayLinks && <a href={lp(lang, "/area/")} aria-current={activePage === "area" ? "page" : undefined} class={`cursor-pointer lg:px-4 px-3 py-3 lg:py-2 text-xs font-black uppercase tracking-widest transition duration-300 ease-in-out ${activePage === "area" ? "text-amber-400" : "text-amber-400/80 hover:text-amber-300"}`}>{t(lang, "nav.area")}</a>}
        {displayLinks && (
          <details class="group/media relative">
            <summary class={`inline-flex min-h-[44px] cursor-pointer list-none items-center gap-1 px-4 text-xs font-semibold uppercase tracking-widest transition-colors marker:content-none ${["videos", "gallery", "lyrics"].includes(activePage) ? "text-amber-400" : "text-zinc-400 hover:text-amber-400"}`}>
              {t(lang, "nav.media")} <span aria-hidden="true" class="text-[9px] transition-transform group-open/media:rotate-180">▾</span>
            </summary>
            <div class="absolute right-0 top-full min-w-44 border border-zinc-800 bg-zinc-950/98 p-2 shadow-2xl">
              <a href={lp(lang, "/videos/")} aria-current={activePage === "videos" ? "page" : undefined} class={`flex min-h-[44px] items-center px-3 text-xs font-semibold uppercase tracking-widest transition-colors ${activePage === "videos" ? "text-amber-400" : "text-zinc-300 hover:text-amber-400"}`}>{t(lang, "nav.videos")}</a>
              <a href={lp(lang, "/gallery/")} aria-current={activePage === "gallery" ? "page" : undefined} class={`flex min-h-[44px] items-center px-3 text-xs font-semibold uppercase tracking-widest transition-colors ${activePage === "gallery" ? "text-amber-400" : "text-zinc-300 hover:text-amber-400"}`}>{t(lang, "nav.gallery")}</a>
              <a href={lp(lang, "/lyrics/")} aria-current={activePage === "lyrics" ? "page" : undefined} class={`flex min-h-[44px] items-center px-3 text-xs font-semibold uppercase tracking-widest transition-colors ${activePage === "lyrics" ? "text-amber-400" : "text-zinc-300 hover:text-amber-400"}`}>{t(lang, "lyrics.heading")}</a>
            </div>
          </details>
        )}
        {displayLinks && activePage === "home" && (
          <>
            <a href={lp(lang, "/#music")} data-section="music" class="nav-link cursor-pointer lg:px-4 px-2 py-2 text-xs font-semibold uppercase tracking-widest transition duration-300 ease-in-out text-zinc-400 hover:text-amber-400">{t(lang, "nav.music")}</a>
            <a href={lp(lang, "/#shows")} data-section="shows" class="nav-link cursor-pointer lg:px-4 px-2 py-2 text-xs font-semibold uppercase tracking-widest transition duration-300 ease-in-out text-zinc-400 hover:text-amber-400">{t(lang, "nav.shows")}</a>
            <a href={lp(lang, "/#contact")} data-section="contact" class="nav-link cursor-pointer lg:px-4 px-2 py-2 text-xs font-semibold uppercase tracking-widest transition duration-300 ease-in-out text-zinc-400 hover:text-amber-400">{t(lang, "nav.contact")}</a>
          </>
        )}
        <div class="flex items-center gap-1 ml-4 pl-4 border-l border-white/10 text-xs font-bold uppercase tracking-widest" aria-label={t(lang, "nav.language")}>
          <button data-lang-switch="en" class={`inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1.5 py-1 transition-colors cursor-pointer ${lang === "en" ? "text-amber-400" : "text-zinc-400 hover:text-zinc-100"}`} aria-label="EN — Switch to English" aria-current={lang === "en" ? "true" : undefined}>EN</button>
          <span class="text-zinc-700">/</span>
          <button data-lang-switch="pl" class={`inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1.5 py-1 transition-colors cursor-pointer ${lang === "pl" ? "text-amber-400" : "text-zinc-400 hover:text-zinc-100"}`} aria-label="PL — Przełącz na polski" aria-current={lang === "pl" ? "true" : undefined}>PL</button>
        </div>
      </div>

      <div class="flex lg:hidden items-center gap-2">
        <div class="flex items-center gap-1 mr-1 text-xs font-bold uppercase tracking-widest">
          <button data-lang-switch="en" class={`inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1.5 py-1 transition-colors cursor-pointer ${lang === "en" ? "text-amber-400" : "text-zinc-400 hover:text-zinc-100"}`} aria-label="EN — Switch to English">EN</button>
          <span class="text-zinc-700">/</span>
          <button data-lang-switch="pl" class={`inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1.5 py-1 transition-colors cursor-pointer ${lang === "pl" ? "text-amber-400" : "text-zinc-400 hover:text-zinc-100"}`} aria-label="PL — Przełącz na polski">PL</button>
        </div>
        {displayLinks && activePage === "home" && (
          <a href={lp(lang, "/merch")} aria-label={t(lang, "nav.toMerch")} class="inline-flex items-center min-h-[44px] px-3 text-xs font-bold uppercase tracking-widest text-amber-400 border border-amber-400/50 hover:bg-amber-400 hover:text-black transition-colors">
            {t(lang, "nav.merch")}
          </a>
        )}
        {displayLinks && (
          <button
            id="mobile-menu-btn"
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center p-2 text-zinc-300 hover:text-amber-400 transition-colors"
            aria-label={t(lang, "nav.openMenu")}
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg id="icon-hamburger" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        )}
      </div>
    </div>

    {displayLinks && (
      <div id="mobile-menu" hidden class="lg:hidden container mx-auto mt-3 pt-1 border-t border-white/10 flex flex-col">
        <a href={lp(lang, "/about")} aria-current={activePage === "about" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-400 ${activePage === "about" ? "text-amber-400" : "text-zinc-300"}`}>{t(lang, "nav.band")}</a>
        <a href={lp(lang, "/merch")} aria-current={activePage === "merch" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-400 ${activePage === "merch" ? "text-amber-400" : "text-zinc-300"}`}>{t(lang, "nav.merch")}</a>
        <a href={lp(lang, "/area/")} aria-current={activePage === "area" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-black uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-300 ${activePage === "area" ? "text-amber-400" : "text-amber-400/80"}`}>{t(lang, "nav.area")}</a>
        <a href={lp(lang, "/videos/")} aria-current={activePage === "videos" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-400 ${activePage === "videos" ? "text-amber-400" : "text-zinc-300"}`}>{t(lang, "nav.videos")}</a>
        <a href={lp(lang, "/gallery/")} aria-current={activePage === "gallery" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-400 ${activePage === "gallery" ? "text-amber-400" : "text-zinc-300"}`}>{t(lang, "nav.gallery")}</a>
        <a href={lp(lang, "/lyrics/")} aria-current={activePage === "lyrics" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-400 ${activePage === "lyrics" ? "text-amber-400" : "text-zinc-300"}`}>{t(lang, "lyrics.heading")}</a>
        <a href={lp(lang, "/epk")} aria-current={activePage === "epk" ? "page" : undefined} class={`mobile-nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors hover:text-amber-400 ${activePage === "epk" ? "text-amber-400" : "text-zinc-300"}`}>{t(lang, "nav.epk")}</a>
        {activePage === "home" && (
          <>
            <a href={lp(lang, "/#music")} data-section="music" class="mobile-nav-link nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors text-zinc-300 hover:text-amber-400">{t(lang, "nav.music")}</a>
            <a href={lp(lang, "/#shows")} data-section="shows" class="mobile-nav-link nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors text-zinc-300 hover:text-amber-400">{t(lang, "nav.shows")}</a>
            <a href={lp(lang, "/#contact")} data-section="contact" class="mobile-nav-link nav-link w-full text-left px-2 py-4 text-sm font-semibold uppercase tracking-widest border-b border-white/5 transition-colors text-zinc-300 hover:text-amber-400">{t(lang, "nav.contact")}</a>
          </>
        )}
      </div>
    )}
  </div>
</nav>

<script>
  function initNav() {
    const nav = document.getElementById("main-nav")
    if (!nav) return

    // Scroll hide/show
    let lastY = window.scrollY
    let ticking = false
    window.addEventListener("scroll", () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        if (document.body.style.position === "fixed") { ticking = false; return }
        const y = window.scrollY
        if (y < 10 || y < lastY) {
          nav.style.transform = "translateY(0)"
        } else {
          nav.style.transform = "translateY(-100%)"
          const menu = document.getElementById("mobile-menu")
          if (menu && !menu.hidden) {
            menu.hidden = true
            document.getElementById("mobile-menu-btn")?.setAttribute("aria-expanded", "false")
            document.getElementById("icon-hamburger")?.classList.remove("hidden")
            document.getElementById("icon-close")?.classList.add("hidden")
          }
        }
        lastY = y
        ticking = false
      })
    }, { passive: true })

    // Active section via IntersectionObserver
    const navLinks = nav.querySelectorAll<HTMLElement>("[data-section]")
    const logoRing = nav.querySelector<HTMLElement>(".logo-ring")
    if (navLinks.length > 0) {
      const idByEl = new Map()
      const visible = new Set()

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const id = idByEl.get(e.target)
            if (!id) return
            if (e.isIntersecting) {
              visible.add(id)
            } else {
              visible.delete(id)
            }
          })
          // Find the topmost visible section
          let activeId = null
          for (const link of navLinks) {
            const id = link.dataset.section
            if (id && visible.has(id)) {
              activeId = id
              break
            }
          }
          // Update all links
          navLinks.forEach((l) => {
            // mobile menu links sit at zinc-300 (same as band/shop/epk); desktop at zinc-400
            const idle = l.classList.contains("mobile-nav-link") ? "text-zinc-300" : "text-zinc-400"
            if (l.dataset.section === activeId) {
              l.classList.add("text-amber-400")
              l.classList.remove(idle)
            } else {
              l.classList.remove("text-amber-400")
              l.classList.add(idle)
            }
          })
          // Update logo: highlight when no section is active
          if (logoRing) {
            if (activeId) {
              logoRing.classList.remove("ring-amber-400")
              logoRing.classList.add("ring-amber-400/40")
            } else {
              logoRing.classList.add("ring-amber-400")
              logoRing.classList.remove("ring-amber-400/40")
            }
          }
        },
        { rootMargin: "-150px 0px -50% 0px", threshold: 0 }
      )
      navLinks.forEach((link) => {
        const id = link.dataset.section
        if (id) {
          const el = document.getElementById(id)
          if (el) {
            idByEl.set(el, id)
            io.observe(el)
          }
        }
      })
    }

    // Mobile menu toggle — fully self-contained, no closure variable deps
    function closeMenu() {
      const menu = document.getElementById("mobile-menu")
      if (!menu || menu.hidden) return
      menu.hidden = true
      document.getElementById("mobile-menu-btn")?.setAttribute("aria-expanded", "false")
      document.getElementById("icon-hamburger")?.classList.remove("hidden")
      document.getElementById("icon-close")?.classList.add("hidden")
    }

    const btn = document.getElementById("mobile-menu-btn")
    btn?.addEventListener("click", () => {
      const menu = document.getElementById("mobile-menu")
      if (!menu) return
      const opening = menu.hidden
      menu.hidden = !opening
      btn.setAttribute("aria-expanded", String(opening))
      document.getElementById("icon-hamburger")?.classList.toggle("hidden", opening)
      document.getElementById("icon-close")?.classList.toggle("hidden", !opening)
    })

    // Bind outside-click once on document; query nav fresh each time so SPA
    // swaps don't leave a stale (detached) nav ref that closes menu instantly.
    if (!(window as any).__viryaOutsideClickBound) {
      (window as any).__viryaOutsideClickBound = true
      document.addEventListener("click", (e) => {
        const currentNav = document.getElementById("main-nav")
        const menu = document.getElementById("mobile-menu")
        const currentBtn = document.getElementById("mobile-menu-btn")
        if (!menu || menu.hidden) return
        const target = e.target as Node
        if (currentBtn?.contains(target)) return
        if (currentNav && !currentNav.contains(target)) {
          menu.hidden = true
          currentBtn?.setAttribute("aria-expanded", "false")
          document.getElementById("icon-hamburger")?.classList.remove("hidden")
          document.getElementById("icon-close")?.classList.add("hidden")
        }
      })
    }

    nav.querySelectorAll(".mobile-nav-link").forEach((link) =>
      link.addEventListener("click", closeMenu)
    )

    const mediaMenu = nav.querySelector<HTMLDetailsElement>("details.group\\/media")
    const mediaMenuController = new AbortController()
    document.addEventListener("astro:before-preparation", () => mediaMenuController.abort(), { once: true })
    document.addEventListener("click", (event) => {
      if (mediaMenu?.open && !mediaMenu.contains(event.target as Node)) mediaMenu.open = false
    }, { signal: mediaMenuController.signal })
    mediaMenu?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        mediaMenu.open = false
        mediaMenu.querySelector<HTMLElement>("summary")?.focus()
      }
    })

    // Smooth scroll for all hash anchor links (Music / Shows / Contact — desktop + mobile)
    nav.querySelectorAll<HTMLAnchorElement>("a[href*='#']").forEach((link) => {
      link.addEventListener("click", (e) => {
        const hash = link.hash
        if (!hash) return
        const target = document.querySelector(hash)
        if (target) {
          e.preventDefault()
          target.scrollIntoView({ behavior: "smooth" })
          closeMenu()
        }
      })
    })

    // Logo click → smooth scroll to top when already on home page
    const logo = nav.querySelector<HTMLAnchorElement>("a.group")
    logo?.addEventListener("click", (e) => {
      const p = window.location.pathname
      const isHome = p === "/" || p === "/pl/" || p === "/pl"
      if (isHome) {
        e.preventDefault()
        window.scrollTo({ top: 0, behavior: "smooth" })
      }
    })

    // Lang switch
    document.querySelectorAll<HTMLElement>("[data-lang-switch]").forEach((el) => {
      el.addEventListener("click", () => {
        const target = el.dataset.langSwitch ?? "en"
        try { localStorage.setItem("virya-lang", target) } catch {}
        const p = location.pathname
        const base = p.replace(/^(\/pl)+(?=\/|$)/, "") || "/"
        location.href = (target === "pl" ? (base === "/" ? "/pl/" : `/pl${base}`) : base) + location.search + location.hash
      })
    })
  }

  document.addEventListener("astro:page-load", initNav)
</script>
