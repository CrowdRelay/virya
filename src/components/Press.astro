---
import { t, lp, type Lang } from "../i18n/t"
import press from "../data/press.json"

interface Props {
  lang?: Lang
}
const { lang = "en" } = Astro.props
---

<section class="virya-section border-t border-zinc-800/60">
  <div class="virya-section__inner">
    <p class="virya-eyebrow">VIRYA // PRESS</p>
    <h2 class="virya-heading mt-4">{t(lang, "press.heading")}</h2>
    <p class="virya-copy mt-5 mb-10">{t(lang, "press.sub")}</p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {press.map((item) => (
        <blockquote class="flex flex-col gap-4 border-l-2 border-amber-400/60 pl-5 py-2">
          <p class="text-zinc-200 text-sm leading-relaxed font-light italic text-justify">
            &ldquo;{lang === "pl" ? item.quote_pl : item.quote}&rdquo;
          </p>
          <footer class="mt-auto">
            <div class="text-[10px] uppercase tracking-widest text-amber-400 font-bold">
              {item.publication}
            </div>
            <div class="text-[10px] uppercase tracking-widest text-zinc-400 mt-0.5">
              {item.release} · {item.year}
            </div>
            {item.url && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="virya-button virya-button--accent-outline mt-3 min-h-[44px] px-3"
              >
                {t(lang, "press.readReview")} ↗
              </a>
            )}
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
