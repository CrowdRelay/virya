---
import { SIGNAL_COPY } from "../data/signalCopy"
import { lp, type Lang } from "../i18n/t"

interface Props {
  lang?: Lang
  compact?: boolean
}

const { lang = "en", compact = false } = Astro.props
const copy = SIGNAL_COPY[lang]
---

<div class:list={["signal-ecosystem relative overflow-hidden border-t border-zinc-800/60", compact ? "py-14 px-4" : "virya-section"]}>
  <div class="signal-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 top-8 h-72 w-72 rounded-full bg-amber-400/[.08] blur-[110px]" aria-hidden="true"></div>

  <div class="virya-section__inner relative">
    <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-4xl">
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <p class="virya-eyebrow">{copy.teaser.eyebrow}</p>
          <span class="inline-flex items-center gap-2 border border-amber-400/25 bg-amber-400/[.05] px-3 py-1 text-[8px] font-black uppercase tracking-[.22em] text-zinc-300">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shadow-[0_0_12px_rgba(251,191,36,.9)]" aria-hidden="true"></span>
            {lang === "pl" ? "aktywny ekosystem" : "live ecosystem"}
          </span>
        </div>
        <h2 class="virya-heading max-w-4xl">
          {copy.teaser.heading}
        </h2>
        <p class="virya-copy mt-6 max-w-3xl text-zinc-300">
          {copy.teaser.body}
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a
          href={lp(lang, "/signal/")}
          class="virya-button virya-button--primary min-h-[48px] px-6"
        >
          {copy.teaser.primary}
          <span class="ml-3" aria-hidden="true">→</span>
        </a>
        <a
          href={lp(lang, "/area/")}
          class="virya-button virya-button--secondary min-h-[48px] px-6"
        >
          {copy.teaser.area}
        </a>
      </div>
    </div>

    <div class="mt-10 grid gap-px border border-zinc-800 bg-zinc-800 sm:grid-cols-2 lg:grid-cols-4">
      {copy.promise.steps.map((step) => (
        <a
          href={step.href.startsWith("/") ? (lang === "pl" && !step.href.startsWith("/pl/") ? `/pl${step.href}` : step.href) : step.href}
          class="group relative min-h-52 overflow-hidden bg-zinc-950 p-5 transition-colors hover:bg-zinc-900/80 sm:p-6"
        >
          <span class="font-mono text-[9px] font-black tracking-[.2em] text-amber-400">{step.number}</span>
          <h3 class="mt-8 text-xl font-black uppercase leading-none tracking-tight text-white">{step.title}</h3>
          <p class="mt-4 text-xs leading-relaxed text-zinc-400">{step.body}</p>
          <span class="absolute bottom-5 right-5 text-xl text-zinc-600 transition-all group-hover:translate-x-1 group-hover:text-amber-400" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <div class="mt-8 grid gap-px border border-zinc-800 bg-zinc-800 lg:grid-cols-3" aria-label={lang === "pl" ? "Ekosystem Viryi" : "Virya ecosystem"}>
      <div class="bg-zinc-950 p-5 sm:p-6">
        <p class="text-[9px] font-black uppercase tracking-[.24em] text-amber-400">{lang === "pl" ? "01 // GRA" : "01 // AREA"}</p>
        <h3 class="mt-3 text-lg font-black uppercase text-white">{lang === "pl" ? "Odkryj sygnał" : "Discover the signal"}</h3>
        <p class="mt-3 text-xs leading-relaxed text-zinc-400">{lang === "pl" ? "Terenowe punkty budują kolekcję i odblokowują korzyści, które przechodzą bezpośrednio do sklepu." : "Location drops build a collection and unlock benefits that move directly into the store."}</p>
      </div>
      <div class="bg-zinc-950 p-5 sm:p-6">
        <p class="text-[9px] font-black uppercase tracking-[.24em] text-amber-400">02 // LIVE QR</p>
        <h3 class="mt-3 text-lg font-black uppercase text-white">{lang === "pl" ? "Przyjdź i wygraj" : "Show up and win"}</h3>
        <p class="mt-3 text-xs leading-relaxed text-zinc-400">{lang === "pl" ? "Wybrane koncerty mogą mieć osobne, audytowalne pule wejściówek. QR na miejscu potwierdza obecność i dodaje los do jednej globalnej puli trzech fizycznych płyt." : "Selected shows can have separate auditable guest-list draws. A venue QR confirms attendance and adds an entry to one global draw for three physical albums."}</p>
      </div>
      <div class="bg-zinc-950 p-5 sm:p-6">
        <p class="text-[9px] font-black uppercase tracking-[.24em] text-amber-400">03 // MERCH</p>
        <h3 class="mt-3 text-lg font-black uppercase text-white">{lang === "pl" ? "Domknij pętlę" : "Close the loop"}</h3>
        <p class="mt-3 text-xs leading-relaxed text-zinc-400">{lang === "pl" ? "Nagrody z Gry Virya, polecenia i odbiór albumu prowadzą do jednego portfela korzyści oraz mierzalnej konwersji merchowej." : "AREA rewards, referrals and album pickup lead into one benefit wallet and measurable merch conversion."}</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" aria-label={lang === "pl" ? "Funkcje Sygnału Virya" : "Virya Signal features"}>
      {copy.teaser.chips.map((chip) => (
        <span class="border border-zinc-800 bg-black/30 px-3 py-2 text-[8px] font-black uppercase tracking-[.22em] text-zinc-400">{chip}</span>
      ))}
      <a
        href={lp(lang, "/merch/")}
        class="inline-flex items-center border border-amber-400/30 bg-amber-400/[.04] px-3 py-2 text-[8px] font-black uppercase tracking-[.22em] text-amber-400 transition-colors hover:bg-amber-400 hover:text-black"
      >
        {copy.teaser.merch} <span class="ml-2" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</div>

<style>
  .signal-grid {
    background-image:
      linear-gradient(rgba(251, 191, 36, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(251, 191, 36, 0.055) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }

  @supports (content-visibility: auto) {
    .signal-ecosystem {
      content-visibility: auto;
      contain-intrinsic-size: 900px;
    }
  }
</style>
