---
// The eyebrow / heading / lede trio repeated on every public page — one
// component keeps the spacing rhythm identical instead of hand-set mt-4/mt-6
// per call site. Optional pieces own their gaps (eyebrow mb-4, sub mt-6) so
// nothing leaves a stray margin when absent. headingClass replaces the
// default wholesale; *Class hooks are for tone utilities only — two
// same-property utilities resolve by stylesheet order, not markup order.
interface Props {
  eyebrow?: string
  eyebrowClass?: string
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6"
  headingClass?: string
  headingId?: string
  sub?: string
  subClass?: string
  class?: string
}
const {
  eyebrow,
  eyebrowClass = "",
  as: Tag = "h2",
  headingClass = "virya-heading",
  headingId,
  sub,
  subClass = "",
  class: className = "",
} = Astro.props
---

<div class={className}>
  {eyebrow && <p class={`virya-eyebrow mb-4 ${eyebrowClass}`}>{eyebrow}</p>}
  <Tag id={headingId} class={headingClass}><slot /></Tag>
  {sub && <p class={`virya-copy mt-6 ${subClass}`}>{sub}</p>}
</div>
