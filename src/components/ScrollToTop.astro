---
interface Props {
  smooth?: boolean
}
const { smooth = true } = Astro.props
---

<button
  id="scroll-to-top"
  aria-label="Scroll to top"
  class="hidden fixed right-6 z-20 w-11 h-11 flex items-center justify-center bg-zinc-900/90 border border-zinc-700 hover:border-amber-400 text-zinc-400 hover:text-amber-400 backdrop-blur-sm shadow-lg transition-all duration-200"
  style="bottom: 24px;"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
    <path d="M18 15l-6-6-6 6" />
  </svg>
</button>

<script define:vars={{ smooth }}>
  let controller = new AbortController()

  document.addEventListener("astro:before-swap", () => {
    controller.abort()
    controller = new AbortController()
  })

  function init() {
    const btn = document.getElementById("scroll-to-top")
    if (!btn) return
    const { signal } = controller
    const all = document.querySelectorAll("footer")
    const footer = all[all.length - 1]
    const minBottom = footer ? footer.offsetHeight + 16 : 24
    btn.style.bottom = minBottom + "px"
    let ticking = false
    const update = () => {
      ticking = false
      const scrollable = document.documentElement.scrollHeight - window.innerHeight
      const scrolled = scrollable > 0 && document.documentElement.scrollTop / scrollable > 0.5
      btn.classList.toggle("hidden", !scrolled)
      if (footer) {
        const overlap = window.innerHeight - footer.getBoundingClientRect().top
        btn.style.bottom = Math.max(minBottom, overlap + 16) + "px"
      }
    }
    const onScroll = () => { if (ticking) return; ticking = true; requestAnimationFrame(update) }
    document.addEventListener("scroll", onScroll, { passive: true, signal })
    window.addEventListener("resize", onScroll, { passive: true, signal })
    btn.addEventListener("click", () => {
      if (smooth) window.scrollTo({ top: 0, behavior: "smooth" })
      else document.documentElement.scrollTop = 0
    }, { signal })
  }

  document.addEventListener("astro:page-load", init)
</script>
