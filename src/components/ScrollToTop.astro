---
interface Props {
  smooth?: boolean
}
const { smooth = true } = Astro.props
---

<button
  id="scroll-to-top"
  aria-label="Scroll to top"
  class="hidden fixed right-6 z-20 flex h-12 w-12 items-center justify-center border border-zinc-700 bg-zinc-900/95 text-zinc-300 shadow-lg transition-[opacity,border-color,color,transform] duration-200 cursor-pointer hover:border-amber-400 hover:text-amber-300"
  style="bottom: max(24px, calc(env(safe-area-inset-bottom) + 16px));"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
    <path d="M18 15l-6-6-6 6" />
  </svg>
</button>

<script define:vars={{ smooth }}>
  let controller = new AbortController()

  document.addEventListener("astro:before-swap", () => {
    controller.abort()
    controller = new AbortController()
  })

  function init() {
    const btn = document.getElementById("scroll-to-top")
    if (!btn || btn.dataset.viryaInitialized === "true") return
    btn.dataset.viryaInitialized = "true"
    const { signal } = controller
    let ticking = false

    const update = () => {
      ticking = false
      btn.classList.toggle("hidden", window.scrollY < window.innerHeight * 1.25)
    }
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }

    window.addEventListener("scroll", onScroll, { passive: true, signal })
    window.addEventListener("resize", onScroll, { passive: true, signal })
    btn.addEventListener("click", () => {
      if (smooth) window.scrollTo({ top: 0, behavior: "smooth" })
      else window.scrollTo(0, 0)
    }, { signal })
    update()
  }

  init()
  document.addEventListener("astro:page-load", init)
</script>
