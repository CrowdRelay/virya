---
import Layout from "../../../components/Layout.astro"
import Navbar from "../../../components/Navbar.astro"
import BlurImage from "../../../components/BlurImage.astro"
import Footer from "../../../components/Footer.astro"
import ScrollToTop from "../../../components/ScrollToTop.astro"
import ChevronLeft from "../../../components/ChevronLeft.astro"
import { t, lp } from "../../../i18n/t"
import { getSeoTags, serializeJsonLd } from "../../../utils/seo"
import items from "../../../components/portfolio/items.json"
import lyricsData from "../../../data/lyrics.json"

export const prerender = true

export function getStaticPaths() {
  const slugify = (str: string) =>
    str.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")
  return items.map((item) => ({ params: { slug: slugify(item.title) }, props: { item } }))
}

const lang = "pl"
const { item } = Astro.props
const { slug } = Astro.params

const title = `${item.title} | Virya`
const description = (item.text_pl || item.text)?.slice(0, 155) + "…"
const path = `/music/${slug}/`
const { canonicalUrl, hreflangLinks } = getSeoTags(path, lang)

const typeLabel = item.type === "album" ? t(lang, "release.albumType") : item.type === "ep" ? t(lang, "release.epType") : t(lang, "release.singleType")
const displayText = lang === "pl" && item.text_pl ? item.text_pl : item.text
const hasLyrics = (lyricsData as Array<{slug: string}>).some(l => l.slug === slug)
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang} ogImage={`https://virya.music/covers/${item.src}`}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
    <script type="application/ld+json" set:html={serializeJsonLd({
      "@context": "https://schema.org",
      "@type": item.type === "single" ? "MusicRecording" : "MusicAlbum",
      "name": item.title,
      "byArtist": { "@type": "MusicGroup", "name": "Virya" },
      "image": `https://virya.music/covers/${item.src}`,
      ...(item.link ? { "url": item.link } : {}),
    })} />
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-20">
      <div class="px-6 py-8 max-w-5xl mx-auto">
        <a href={lp(lang, "/#music")} class="group inline-flex items-center gap-3 rounded-lg border border-zinc-800 hover:border-amber-400/60 bg-zinc-900/40 hover:bg-zinc-900 px-4 py-3 transition-colors mb-10">
          <ChevronLeft class="shrink-0 w-4 h-4 text-amber-400 transition-transform group-hover:-translate-x-0.5" />
          <span class="text-sm font-semibold uppercase tracking-widest text-zinc-200 group-hover:text-amber-400 transition-colors">{t(lang, "music.heading")}</span>
        </a>

        <div class="grid lg:grid-cols-[280px_1fr] gap-10 lg:gap-14 items-start">
          <button
            id="open-lightbox"
            class="block w-full lg:w-[280px] aspect-square object-cover cursor-zoom-in group focus-visible:ring-2 focus-visible:ring-amber-400 rounded-sm"
            aria-label="View full size image"
          >
            <BlurImage
              src={`/covers/${item.src}`}
              alt={item.alt}
              width="280"
              height="280"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              sizes="(max-width: 1023px) calc(100vw - 3rem), 280px"
              class="block w-full aspect-square object-cover rounded-sm transition-opacity duration-200 group-hover:opacity-80"
            />
          </button>

          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-amber-400/80 mb-2">{typeLabel}</p>
            <h1 class="text-3xl lg:text-4xl font-black uppercase tracking-tight text-white mb-4">{item.title}</h1>
            <p class="text-zinc-400 text-sm leading-relaxed mb-8 text-justify mobile-justify">{displayText}</p>

            <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "release.listenHeading")}</h2>
            <div class="flex flex-wrap gap-3">
              {item.link && (
                <a href={item.link} target="_blank" rel="noreferrer" class="text-[11px] font-bold uppercase tracking-widest px-4 py-2 border border-amber-400/60 text-amber-400 hover:bg-amber-400 hover:text-black transition-colors">
                  {t(lang, "music.listen")}
                </a>
              )}
              {item.watch && (
                <a href={item.watch} target="_blank" rel="noreferrer" class="text-[11px] font-bold uppercase tracking-widest px-4 py-2 border border-zinc-700 text-zinc-300 hover:border-amber-400/60 hover:text-amber-400 transition-colors">
                  {t(lang, "music.watch")}
                </a>
              )}
              {item.buy && (
                <a href={item.buy} target="_blank" rel="noreferrer" class="text-[11px] font-bold uppercase tracking-widest px-4 py-2 border border-zinc-700 text-zinc-300 hover:border-amber-400/60 hover:text-amber-400 transition-colors">
                  {t(lang, "music.buy")}
                </a>
              )}
              {item.merch && (
                <a href={lp(lang, item.merch)} class="text-[11px] font-bold uppercase tracking-widest px-4 py-2 border border-zinc-700 text-zinc-300 hover:border-amber-400/60 hover:text-amber-400 transition-colors">
                  {t(lang, "nav.merch")}
                </a>
              )}
              {hasLyrics && (
                <a href={lp(lang, `/lyrics/${slug}/`)} class="text-[11px] font-bold uppercase tracking-widest px-4 py-2 border border-zinc-700 text-zinc-300 hover:border-amber-400/60 hover:text-amber-400 transition-colors">
                  {t(lang, "music.lyrics")}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/90 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
    tabindex="-1"
  >
    <button
      id="lightbox-close"
      data-dialog-initial-focus
      class="absolute top-4 right-4 p-2 text-zinc-400 hover:text-white transition-colors"
      aria-label="Close"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="w-7 h-7">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <img
      id="lightbox-img"
      src={`/covers/${item.src}`}
      alt={item.alt}
      class="max-w-[90vw] max-h-[90vh] object-contain rounded-sm shadow-2xl select-none"
    />
  </div>

  <script>
    import { createDialogFocus } from "../../../utils/dialogFocus"

    document.addEventListener("astro:page-load", () => {
      const lightbox = document.getElementById("lightbox")
      const openBtn = document.getElementById("open-lightbox")
      if (!lightbox || !openBtn || lightbox.dataset.initialized === "true") return
      lightbox.dataset.initialized = "true"

      const ac = new AbortController()
      const dialogFocus = createDialogFocus(lightbox)
      const close = () => {
        lightbox.classList.add("hidden")
        lightbox.classList.remove("flex")
        document.body.style.overflow = ""
        dialogFocus.deactivate()
      }
      const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") close() }
      const open = () => {
        lightbox.classList.remove("hidden")
        lightbox.classList.add("flex")
        document.body.style.overflow = "hidden"
        dialogFocus.activate(openBtn)
      }

      document.addEventListener("astro:before-preparation", () => { close(); ac.abort() }, { once: true })
      document.addEventListener("keydown", onKey, { signal: ac.signal })
      openBtn.addEventListener("click", open, { signal: ac.signal })
      document.getElementById("lightbox-close")?.addEventListener("click", close, { signal: ac.signal })
      lightbox.addEventListener("click", (e) => { if (e.target === lightbox) close() }, { signal: ac.signal })
    })
  </script>
</Layout>
