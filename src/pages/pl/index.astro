---
export const prerender = true

import Layout from "../../components/Layout.astro"
import Navbar from "../../components/Navbar.astro"
import Landing from "../../components/Landing.astro"
import MainText from "../../components/MainText.astro"
import BandTeaser from "../../components/BandTeaser.astro"
import Showcase from "../../components/Showcase.astro"
import SignalEcosystem from "../../components/SignalEcosystem.astro"
import AreaTeaser from "../../components/AreaTeaser.astro"
import Portfolio from "../../components/Portfolio.astro"
import Spotify from "../../components/Spotify.astro"
import MerchTeaser from "../../components/MerchTeaser.astro"
import Endorsements from "../../components/Endorsements.astro"
import Shows from "../../components/preact/Shows"
import Contact from "../../components/preact/Contact"
import Footer from "../../components/Footer.astro"
import ScrollToTop from "../../components/ScrollToTop.astro"
import { getSeoTags } from "../../utils/seo"
import { getHomepageMessages } from "../../i18n/homepageMessages"
import { serializeViryaIdentity } from "../../data/viryaIdentity"
import { loadLiveEvents } from "../../server/liveEvents"

const lang = "pl"
const messages = getHomepageMessages(lang)
const { events: initialLiveEvents } = await loadLiveEvents()
const { canonicalUrl, hreflangLinks } = getSeoTags("/", lang)
const title = "Virya — Nowoczesny Metalcore z Polski"
const description = "Oficjalna strona Virya, nowoczesnego zespołu metalcore z Polski. Słuchaj nowej muzyki, sprawdź koncerty i zamów oficjalny merch."
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
    <link rel="preload" as="image" href="/poster.webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={serializeViryaIdentity()} />
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} activePage="home" />
    <ScrollToTop />

    <main id="main-content">
      <header class="header relative flex min-h-[88svh] flex-col overflow-hidden sm:min-h-[92svh] lg:min-h-screen">
        <Landing />
        <MainText lang={lang} />
      </header>

      <div class="flex flex-col bg-zinc-950">
        <section id="shows" class="scroll-mt-20">
          <Shows client:visible lang={lang} messages={messages.shows} initialEvents={initialLiveEvents} />
        </section>

        <section id="showcase" class="scroll-mt-20">
          <Showcase lang={lang} />
        </section>

        <section id="music" class="scroll-mt-20">
          <Portfolio lang={lang} />
          <Spotify lang={lang} />
        </section>

        <section id="signal" class="scroll-mt-20">
          <SignalEcosystem lang={lang} />
        </section>

        <section id="area" class="scroll-mt-20">
          <AreaTeaser lang={lang} />
        </section>

        <MerchTeaser lang={lang} />

        <section id="about" class="scroll-mt-20">
          <BandTeaser lang={lang} />
        </section>

        <section id="endorsements" class="scroll-mt-20">
          <Endorsements lang={lang} />
        </section>

        <section id="contact" class="scroll-mt-20">
          <Contact client:visible lang={lang} messages={messages.contact} />
        </section>
      </div>
    </main>

    <Footer lang={lang} />
  </div>

</Layout>
