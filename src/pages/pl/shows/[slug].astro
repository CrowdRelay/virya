---
import Layout from "../../../components/Layout.astro"
import Navbar from "../../../components/Navbar.astro"
import BlurImage from "../../../components/BlurImage.astro"
import Footer from "../../../components/Footer.astro"
import ScrollToTop from "../../../components/ScrollToTop.astro"
import ChevronLeft from "../../../components/ChevronLeft.astro"
import { t, lp } from "../../../i18n/t"
import { getSeoTags } from "../../../utils/seo"

// Disable SSL verification for dev environment
if (import.meta.env.DEV) {
  process.env.NODE_TLS_REJECT_UNAUTHORIZED = "0"
}

const lang = "pl"
const { slug } = Astro.params

const gigId = slug?.replace(/^gig-/, "")

let gig = null
try {
  const appId = import.meta.env.BANDSINTOWN_APP_ID || ""
  if (appId && gigId) {
    const res = await fetch(
      `https://rest.bandsintown.com/artists/virya/events?app_id=${appId}&date=upcoming`
    )
    if (res.ok) {
      const data = await res.json()
      const events = Array.isArray(data) ? data : []
      gig = events.find((e: any) => String(e.id) === gigId)
    }
  }
} catch (err) {
  console.error("[Gig Subpage PL]", err)
}

if (!gig) return Astro.redirect("/pl/")

const gigDate = new Date(gig.datetime)
const locale = "pl-PL"
const dateStr = gigDate.toLocaleDateString(locale, { weekday: "long", day: "numeric", month: "long", year: "numeric" })
const timeStr = gigDate.toLocaleTimeString(locale, { hour: "2-digit", minute: "2-digit" })

const title = `${gig.venue?.name || gig.title || "Koncert"} · ${dateStr} | Virya`
const description = gig.description || `${t(lang, "shows.heading")} — Virya na żywo w ${gig.venue?.name || ""}`
const path = `/shows/${slug}/`
const { canonicalUrl, hreflangLinks } = getSeoTags(path, lang)
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-20">
      <div class="w-full px-4 lg:px-12 py-16 lg:py-24 max-w-4xl mx-auto overflow-hidden">
        <a href={lp(lang, "/#shows")} onClick={(e) => { e.preventDefault(); window.location.href = lp(lang, "/"); setTimeout(() => { const el = document.getElementById('shows'); if (el) el.scrollIntoView({ behavior: 'smooth' }) }, 100) }} class="group inline-flex items-center gap-3 rounded-lg border border-zinc-800 hover:border-amber-400/60 bg-zinc-900/40 hover:bg-zinc-900 px-4 py-3 transition-colors mb-10">
          <ChevronLeft class="shrink-0 w-4 h-4 text-amber-400 transition-transform group-hover:-translate-x-0.5" />
          <span class="text-sm font-semibold uppercase tracking-widest text-zinc-200 group-hover:text-amber-400 transition-colors">{t(lang, "shows.heading")}</span>
        </a>

        <div class="grid lg:grid-cols-[1fr_320px] gap-4 lg:gap-14 items-start">
          <div class="min-w-0 max-w-full">
            <p class="text-[9px] lg:text-[10px] font-bold uppercase tracking-widest text-amber-400/80 mb-1 lg:mb-3 break-words">{dateStr} · {timeStr}</p>
            <h1 class="text-xl lg:text-4xl font-black uppercase tracking-tight text-white mb-2 lg:mb-6 leading-tight break-words overflow-hidden">
              {gig.venue?.name || gig.title}
            </h1>

            {gig.venue?.city && (
              <p class="text-xs lg:text-sm text-zinc-400 uppercase tracking-widest mb-3 lg:mb-6 break-words">
                {gig.venue.city}{gig.venue.country ? `, ${gig.venue.country}` : ""}
              </p>
            )}

            {gig.description && <p class="text-zinc-300 leading-relaxed text-justify text-xs lg:text-base mb-4 lg:mb-8 break-words">{gig.description}</p>}

            {gig.lineup && gig.lineup.length > 0 && (
              <div class="mb-4 lg:mb-8">
                <h2 class="text-[10px] lg:text-xs font-black uppercase tracking-widest text-zinc-400 mb-2 lg:mb-4">{t(lang, "gig.lineup")}</h2>
                <ul class="space-y-1 lg:space-y-2">
                  {gig.lineup.map((act: string) => (
                    <li class="text-xs lg:text-sm text-zinc-200 border-l-2 border-amber-400/30 pl-3 break-words">{act}</li>
                  ))}
                </ul>
              </div>
            )}

            <div class="flex flex-wrap gap-2 lg:gap-3">
              {gig.url && (
                <a href={gig.url} target="_blank" rel="noreferrer" class="text-[10px] lg:text-[11px] font-bold uppercase tracking-widest px-4 lg:px-5 py-2 lg:py-3 border border-zinc-700 text-zinc-200 hover:border-amber-400/60 hover:text-amber-400 transition-colors">
                  {t(lang, "shows.event")}
                </a>
              )}
              {gig.offers?.[0]?.url && (
                <a href={gig.offers[0].url} target="_blank" rel="noreferrer" class="text-[10px] lg:text-[11px] font-bold uppercase tracking-widest px-4 lg:px-5 py-2 lg:py-3 bg-amber-400 text-black hover:bg-amber-300 transition-colors">
                  {t(lang, "gig.getTickets")}
                </a>
              )}
            </div>
          </div>

          <div>
            <BlurImage
              src="/images/rise.webp"
              alt="Virya"
              width="320"
              height="240"
              loading="lazy"
              decoding="async"
              class="w-full aspect-square object-cover lg:aspect-auto lg:max-w-none lg:max-h-none"
            />
          </div>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
