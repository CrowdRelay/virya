---
export const prerender = false

import Layout from "../../../components/Layout.astro"
import Navbar from "../../../components/Navbar.astro"
import BlurImage from "../../../components/BlurImage.astro"
import Footer from "../../../components/Footer.astro"
import ScrollToTop from "../../../components/ScrollToTop.astro"
import ChevronLeft from "../../../components/ChevronLeft.astro"
import { t, lp } from "../../../i18n/t"
import { getSeoTags } from "../../../utils/seo"

const ARTIST = "virya"
const DEFAULT_APP_ID = "virya-website"
const REQUEST_TIMEOUT_MS = 8_000

interface Gig {
  id?: string | number
  datetime?: string
  starts_at?: string
  title?: string
  description?: string
  lineup?: unknown
  url?: string
  offers?: Array<{ type?: string; url?: string; status?: string }>
  venue?: {
    name?: string
    city?: string
    region?: string
    country?: string
    street_address?: string
    postal_code?: string
  }
}

const safeHttpUrl = (value: unknown) => {
  if (typeof value !== "string") return null
  try {
    const url = new URL(value)
    return url.protocol === "https:" || url.protocol === "http:" ? url.toString() : null
  } catch {
    return null
  }
}

const serializeJsonLd = (value: unknown) =>
  JSON.stringify(value)
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029")

const lang = "pl"
const slug = Astro.params.slug ?? ""
const gigId = /^gig-(\d+)$/.exec(slug)?.[1] ?? null

let gig: Gig | null = null
let upstreamFailed = false

if (gigId) {
  try {
    const appId = import.meta.env.BANDSINTOWN_APP_ID || DEFAULT_APP_ID
    const url = new URL(`https://rest.bandsintown.com/artists/${encodeURIComponent(ARTIST)}/events`)
    url.searchParams.set("app_id", appId)
    url.searchParams.set("date", "all")

    const res = await fetch(
      url,
      {
        headers: { Accept: "application/json" },
        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
      }
    )

    if (res.ok) {
      const data = await res.json()
      if (Array.isArray(data)) {
        gig = data.find((event: Gig) => String(event.id) === gigId)
      } else {
        upstreamFailed = true
        console.error("[Gig Subpage PL] Bandsintown returned an invalid payload")
      }
    } else {
      upstreamFailed = true
      console.error(`[Gig Subpage PL] Bandsintown returned ${res.status}`)
    }
  } catch (err) {
    upstreamFailed = true
    console.error("[Gig Subpage PL]", err)
  }
}

if (!gig) {
  Astro.response.status = upstreamFailed ? 503 : 404
  Astro.response.headers.set("Cache-Control", "no-store")
  if (upstreamFailed) Astro.response.headers.set("Retry-After", "60")
} else {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=1800, stale-while-revalidate=3600"
  )
}

const eventDateValue = gig?.datetime || gig?.starts_at || ""
const parsedGigDate = eventDateValue ? new Date(eventDateValue) : null
const gigDate = parsedGigDate && !Number.isNaN(parsedGigDate.getTime()) ? parsedGigDate : null
const locale = "pl-PL"
const dateStr = gigDate
  ? gigDate.toLocaleDateString(locale, { weekday: "long", day: "numeric", month: "long", year: "numeric" })
  : "Data zostanie ogłoszona"
const timeStr = gigDate
  ? gigDate.toLocaleTimeString(locale, { hour: "2-digit", minute: "2-digit" })
  : null
const isPast = gigDate ? gigDate.getTime() < Date.now() : false
const statusLabel = isPast ? "Koncert archiwalny" : "Nadchodzący koncert"

const venueName = typeof gig?.venue?.name === "string" ? gig.venue.name : ""
const gigTitle = typeof gig?.title === "string" ? gig.title : ""
const gigDescription = typeof gig?.description === "string" ? gig.description : ""
const lineup = Array.isArray(gig?.lineup)
  ? gig.lineup.filter((act): act is string => typeof act === "string" && act.trim().length > 0)
  : []
const eventUrl = safeHttpUrl(gig?.url)
const ticketUrl = isPast
  ? null
  : safeHttpUrl(gig?.offers?.find((offer) => offer?.url && offer.status !== "unavailable")?.url)

const title = gig
  ? `${venueName || gigTitle || "Koncert"} · ${dateStr} | Virya`
  : upstreamFailed
    ? "Koncerty chwilowo niedostępne | Virya"
    : "404 | Virya"
const description = gig
  ? gigDescription || `${t(lang, "shows.heading")} — Virya na żywo w ${venueName}`
  : undefined
const path = `/shows/${slug}/`
const seo = getSeoTags(path, lang)
const canonicalUrl = gig ? seo.canonicalUrl : undefined
const hreflangLinks = gig ? seo.hreflangLinks : []

const jsonLd = gig && gigDate && eventDateValue
  ? serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "MusicEvent",
      "name": gigTitle || `Virya w ${venueName}`,
      "startDate": eventDateValue,
      "url": canonicalUrl,
      ...(eventUrl ? { "sameAs": eventUrl } : {}),
      ...(ticketUrl
        ? {
            "offers": {
              "@type": "Offer",
              "url": ticketUrl,
              "availability": "https://schema.org/InStock",
            },
          }
        : {}),
      "location": {
        "@type": "Place",
        "name": venueName,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": gig.venue?.street_address,
          "postalCode": gig.venue?.postal_code,
          "addressLocality": gig.venue?.city,
          "addressRegion": gig.venue?.region,
          "addressCountry": gig.venue?.country,
        },
      },
      "performer": { "@type": "MusicGroup", "name": "Virya" },
    })
  : null
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
    {!gig && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-20">
      {!gig ? (
        <div class="min-h-[70vh] flex flex-col items-center justify-center px-6 text-center">
          <p class="text-[10px] font-bold uppercase tracking-[0.4em] text-amber-400 mb-6">
            {upstreamFailed ? "503" : "404"}
          </p>
          <h1 class="text-3xl lg:text-5xl font-black uppercase tracking-tight text-white mb-8">
            {upstreamFailed ? "Koncerty chwilowo niedostępne" : t(lang, "notFound.title")}
          </h1>
          <a
            href={lp(lang, "/")}
            class="text-xs font-bold uppercase tracking-widest px-6 py-3 border border-amber-400/60 text-amber-400 hover:bg-amber-400 hover:text-black transition-colors"
          >
            {t(lang, "notFound.back")}
          </a>
        </div>
      ) : (
      <div class="w-full px-4 lg:px-12 py-8 max-w-4xl mx-auto overflow-hidden">
        <a href={lp(lang, "/#shows")} onClick={(e) => { e.preventDefault(); window.location.href = lp(lang, "/"); setTimeout(() => { const el = document.getElementById('shows'); if (el) el.scrollIntoView({ behavior: 'smooth' }) }, 100) }} class="group inline-flex items-center gap-3 rounded-lg border border-zinc-800 hover:border-amber-400/60 bg-zinc-900/40 hover:bg-zinc-900 px-4 py-3 transition-colors mb-10">
          <ChevronLeft class="shrink-0 w-4 h-4 text-amber-400 transition-transform group-hover:-translate-x-0.5" />
          <span class="text-sm font-semibold uppercase tracking-widest text-zinc-200 group-hover:text-amber-400 transition-colors">{t(lang, "shows.heading")}</span>
        </a>

        <div class="grid lg:grid-cols-[1fr_320px] gap-4 lg:gap-14 items-start">
          <div class="min-w-0 max-w-full">
            <p class="text-[9px] lg:text-[10px] font-bold uppercase tracking-widest text-amber-400/80 mb-1 lg:mb-3 break-words">
              {statusLabel} · {dateStr}{timeStr ? ` · ${timeStr}` : ""}
            </p>
            <h1 class="text-xl lg:text-4xl font-black uppercase tracking-tight text-white mb-2 lg:mb-6 leading-tight break-words overflow-hidden">
              {venueName || gigTitle}
            </h1>

            {gig.venue?.city && (
              <p class="text-xs lg:text-sm text-zinc-400 uppercase tracking-widest mb-3 lg:mb-6 break-words">
                {gig.venue.city}{gig.venue.country ? `, ${gig.venue.country}` : ""}
              </p>
            )}

            {gigDescription && <p class="text-zinc-300 leading-relaxed text-justify text-xs lg:text-base mb-4 lg:mb-8 break-words">{gigDescription}</p>}

            {lineup.length > 0 && (
              <div class="mb-4 lg:mb-8">
                <h2 class="text-[10px] lg:text-xs font-black uppercase tracking-widest text-zinc-400 mb-2 lg:mb-4">{t(lang, "gig.lineup")}</h2>
                <ul class="space-y-1 lg:space-y-2">
                  {lineup.map((act) => (
                    <li class="text-xs lg:text-sm text-zinc-200 border-l-2 border-amber-400/30 pl-3 break-words">{act}</li>
                  ))}
                </ul>
              </div>
            )}

            <div class="flex flex-wrap gap-2 lg:gap-3">
              {eventUrl && (
                <a href={eventUrl} target="_blank" rel="noreferrer" class="text-[10px] lg:text-[11px] font-bold uppercase tracking-widest px-4 lg:px-5 py-2 lg:py-3 border border-zinc-700 text-zinc-200 hover:border-amber-400/60 hover:text-amber-400 transition-colors">
                  {t(lang, "shows.event")}
                </a>
              )}
              {ticketUrl && (
                <a href={ticketUrl} target="_blank" rel="noreferrer" class="text-[10px] lg:text-[11px] font-bold uppercase tracking-widest px-4 lg:px-5 py-2 lg:py-3 bg-amber-400 text-black hover:bg-amber-300 transition-colors">
                  {t(lang, "gig.getTickets")}
                </a>
              )}
            </div>
          </div>

          <div>
            <BlurImage
              src="/images/rise.webp"
              alt="Virya"
              width="320"
              height="240"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 1023px) calc(100vw - 2rem), 320px"
              class="w-full aspect-square object-cover lg:aspect-auto lg:max-w-none lg:max-h-none"
            />
          </div>
        </div>
      </div>
      )}
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
