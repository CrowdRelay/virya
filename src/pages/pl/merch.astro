---
export const prerender = true

import Layout from "../../components/Layout.astro"
import Navbar from "../../components/Navbar.astro"
import Footer from "../../components/Footer.astro"
import ScrollToTop from "../../components/ScrollToTop.astro"
import MerchClient from "../../components/preact/merch/MerchClient"
import { getSeoTags } from "../../utils/seo"
import { t, lp } from "../../i18n/t"
import ChevronLeft from "../../components/ChevronLeft.astro"

const lang = "pl"
const { canonicalUrl, hreflangLinks } = getSeoTags("/merch/", lang)
const title = "Sklep | Virya"
const description = "Oficjalny sklep Virya. Albumy, koszulki, torby — wszystko wysyłane do Paczkomatu InPost, z darmowymi naklejkami do każdego zamówienia."
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
    <link rel="dns-prefetch" href="https://geowidget.inpost.pl" />
    <link rel="preload" as="image" href="/images/merch/echoes.webp" />
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} activePage="merch" />
    <ScrollToTop />

    <div class="px-6 pt-5">
      <a href={lp(lang, "/")} class="group inline-flex items-center gap-3 rounded-lg border border-zinc-800 hover:border-amber-400/60 bg-zinc-900/40 hover:bg-zinc-900 px-4 py-3 transition-colors">
        <ChevronLeft class="shrink-0 w-4 h-4 text-amber-400 transition-transform group-hover:-translate-x-0.5" />
        <span class="text-sm font-semibold uppercase tracking-widest text-zinc-200 group-hover:text-amber-400 transition-colors">{t(lang, "nav.home")}</span>
      </a>
    </div>
    <MerchClient client:idle lang={lang} />

    <Footer lang={lang} />
  </div>
</Layout>
