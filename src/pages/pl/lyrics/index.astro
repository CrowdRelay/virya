---
export const prerender = true

import Layout from "../../../components/Layout.astro"
import Navbar from "../../../components/Navbar.astro"
import Footer from "../../../components/Footer.astro"
import ScrollToTop from "../../../components/ScrollToTop.astro"
import ChevronLeft from "../../../components/ChevronLeft.astro"
import BlurImage from "../../../components/BlurImage.astro"
import { t, lp } from "../../../i18n/t"
import { getSeoTags } from "../../../utils/seo"
import lyrics from "../../../data/lyrics.json"

const lang = "pl"
const { canonicalUrl, hreflangLinks } = getSeoTags("/lyrics/", lang)
const title = "Teksty | Virya"
const description = "Teksty piosenek ze wszystkich wydawnictw Virya — Echoes Of The Modern Mind, From The Ashes EP i więcej."
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} activePage="lyrics" />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-20">
      <div class="px-6 lg:px-12 py-12 max-w-5xl mx-auto">

        <div class="mb-2">
          <a href={lp(lang, "/")} class="group inline-flex items-center gap-2 text-zinc-500 hover:text-amber-400 transition-colors text-[10px] uppercase tracking-widest mb-6">
            <ChevronLeft class="w-3 h-3" />
            {t(lang, "nav.home")}
          </a>
        </div>

        <div class="mb-12">
          <p class="text-xs font-bold uppercase tracking-[0.4em] text-amber-400 mb-3">{t(lang, "lyrics.eyebrow")}</p>
          <h1 class="text-4xl lg:text-5xl font-black uppercase tracking-tight text-white mb-2">{t(lang, "lyrics.heading")}</h1>
          <p class="text-sm text-zinc-400">{t(lang, "lyrics.sub")}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {lyrics.map((item) => {
            const typeLabel =
              item.type === "album" ? t(lang, "lyrics.albumType") :
              item.type === "ep" ? t(lang, "lyrics.epType") :
              t(lang, "lyrics.singleType")
            return (
              <a
                href={lp(lang, `/lyrics/${item.slug}/`)}
                class="group flex gap-4 items-start p-4 border border-zinc-800/60 hover:border-amber-400/40 bg-zinc-900/20 hover:bg-zinc-900/60 transition-all duration-200"
              >
                <BlurImage
                  src={`/covers/${item.cover}`}
                  alt={item.title}
                  width="72"
                  height="72"
                  class="w-[72px] h-[72px] shrink-0 object-cover"
                />
                <div class="min-w-0 pt-0.5">
                  <p class="text-[9px] font-bold uppercase tracking-widest text-amber-400 mb-1">{typeLabel} · {item.year}</p>
                  <h2 class="text-sm font-black uppercase tracking-tight text-zinc-100 group-hover:text-amber-400 transition-colors leading-snug">{item.title}</h2>
                  <p class="text-[10px] text-zinc-500 mt-1.5 uppercase tracking-widest">
                    {item.tracks.length} {t(lang, "release.tracksLabel")}
                  </p>
                </div>
              </a>
            )
          })}
        </div>

      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
