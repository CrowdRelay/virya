---
export const prerender = false
import Layout from "../../components/Layout.astro"
import StaffNavigation from "../../components/StaffNavigation.astro"
import AdminConsole from "../../components/preact/staff/AdminConsole"
---
<Layout title="Virya Control Center" description="Prywatny panel administracyjny Virya i CrowdRelay." lang="pl">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <main id="main-content" class="min-h-screen w-full overflow-x-hidden bg-zinc-950 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-7xl">
      <StaffNavigation active="control" />
      <AdminConsole client:load />
    </div>
  </main>
</Layout>
