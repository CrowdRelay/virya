---
export const prerender = false
import Layout from "../../components/Layout.astro"
import StaffShell from "../../components/StaffShell.astro"
import AdminConsole from "../../components/preact/staff/AdminConsole"
---
<Layout title="Virya Staff" description="Prywatny panel operacyjny VIRYA." lang="pl">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <main id="main-content">
    <StaffShell active="home">
      <AdminConsole client:load />
    </StaffShell>
  </main>
</Layout>
