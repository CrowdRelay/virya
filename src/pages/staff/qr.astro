---
export const prerender = false

import Layout from "../../components/Layout.astro"
import ConcertQrManager from "../../components/preact/staff/ConcertQrManager"
---

<Layout
  title="Virya Staff — koncertowe QR"
  description="Prywatny generator koncertowych kodów QR Virya."
  lang="pl"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </Fragment>
  <main id="main-content" class="min-h-screen w-full max-w-full overflow-x-hidden bg-zinc-950 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto w-full min-w-0 max-w-7xl">
      <ConcertQrManager client:load />
    </div>
  </main>
</Layout>
