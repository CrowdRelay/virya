---
export const prerender = false
import Layout from "../../components/Layout.astro"
import StaffShell from "../../components/StaffShell.astro"
import StaffPairingManager from "../../components/preact/staff/StaffPairingManager"
---
<Layout title="Virya Staff — urządzenia" description="Prywatny panel operacyjny VIRYA." lang="pl">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <main id="main-content">
    <StaffShell active="pair">
      <StaffPairingManager client:load />
    </StaffShell>
  </main>
</Layout>
