---
export const prerender = false

import Layout from "../../components/Layout.astro"
import StaffNavigation from "../../components/StaffNavigation.astro"
import StaffPairingManager from "../../components/preact/staff/StaffPairingManager"
---

<Layout
  title="Virya Staff — parowanie Virya Signal"
  description="Prywatny generator kodów parowania staff dla aplikacji Virya Signal."
  lang="pl"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
  </Fragment>
  <main id="main-content" class="min-h-screen w-full max-w-full overflow-x-hidden bg-zinc-950 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto w-full min-w-0 max-w-7xl">
      <StaffNavigation active="pair" />
      <StaffPairingManager client:load />
    </div>
  </main>
</Layout>
