---
export const prerender = false
import Layout from "../../components/Layout.astro"
import StaffShell from "../../components/StaffShell.astro"
import StaffCommerceManager from "../../components/preact/staff/StaffCommerceManager"
---
<Layout title="Virya Staff — merch" description="Prywatny panel operacyjny VIRYA." lang="pl">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <style is:global>
      .input { width: 100%; border-radius: .375rem; border: 1px solid rgb(255 255 255 / .1); background: #09090b; padding: .75rem 1rem; color: white; outline: none; }
      .input:focus { border-color: #84b4ac; }
    </style>
  </Fragment>
  <main id="main-content">
    <StaffShell active="commerce">
      <StaffCommerceManager client:load />
    </StaffShell>
  </main>
</Layout>
