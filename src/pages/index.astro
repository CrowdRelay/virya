---
import Layout from "../components/Layout.astro"
import Navbar from "../components/Navbar.astro"
import Landing from "../components/Landing.astro"
import MainText from "../components/MainText.astro"
import BandTeaser from "../components/BandTeaser.astro"
import Showcase from "../components/Showcase.astro"
import Portfolio from "../components/Portfolio.astro"
import Spotify from "../components/Spotify.astro"
import Shows from "../components/preact/Shows"
import Newsletter from "../components/preact/Newsletter"
import Contact from "../components/preact/Contact"
import Footer from "../components/Footer.astro"
import ScrollToTop from "../components/ScrollToTop.astro"
import { getSeoTags } from "../utils/seo"

const lang = "en"
const { canonicalUrl, hreflangLinks } = getSeoTags("/", lang)
const title = "Virya — Modern Metalcore from Poland"
const description = "Official website of Virya, a modern metalcore band from Poland. Listen to new music, see upcoming shows, and shop official merch."
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
    <link rel="preload" as="image" href="/poster.webp" />
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} activePage="home" />
    <ScrollToTop />

    <main id="main-content">
      <header class="header relative lg:overflow-hidden min-h-screen flex flex-col">
        <Landing />
        <MainText lang={lang} />
        <button
          id="scroll-arrow-btn"
          aria-label="Scroll to content"
          class="arrows"
        >
          <svg aria-hidden="true" viewBox="0 0 60 72" class="w-full h-full overflow-visible">
            <path class="a1" d="M0 0 L30 32 L60 0"></path>
            <path class="a2" d="M0 20 L30 52 L60 20"></path>
            <path class="a3" d="M0 40 L30 72 L60 40"></path>
          </svg>
        </button>
      </header>

      <div class="lg:container lg:mx-auto bg-zinc-950 flex flex-col">
        <section id="about" class="scroll-mt-20">
          <BandTeaser lang={lang} />
        </section>

        <section id="showcase" class="scroll-mt-20">
          <Showcase lang={lang} />
        </section>

        <section id="music" class="scroll-mt-20">
          <Portfolio lang={lang} />
          <Spotify lang={lang} />
        </section>

        <section id="shows" class="scroll-mt-20">
          <Shows client:visible lang={lang} />
        </section>

        <section id="newsletter" class="scroll-mt-20">
          <Newsletter client:idle lang={lang} />
        </section>

        <section id="contact" class="scroll-mt-20">
          <Contact client:idle lang={lang} />
        </section>
      </div>
    </main>

    <Footer lang={lang} />
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const btn = document.getElementById("scroll-arrow-btn")
      const about = document.getElementById("about")
      if (btn && about) {
        btn.addEventListener("click", () => about.scrollIntoView({ behavior: "smooth" }))
      }
    })
  </script>
</Layout>
