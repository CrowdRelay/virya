---
export const prerender = true
import Layout from "../components/Layout.astro"
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import ScrollToTop from "../components/ScrollToTop.astro"
import ManagerEcosystem from "../components/ManagerEcosystem.astro"
import { t, lp } from "../i18n/t"
import { getSeoTags } from "../utils/seo"
import items from "../components/portfolio/items.json"
import { THOMANN_HOME_URL, thomannAffiliateUrl } from "../lib/thomann"

const lang = "en"
const { canonicalUrl, hreflangLinks } = getSeoTags("/epk/", lang)
const title = `${t(lang, "epk.heading")} | Virya`
const description = t(lang, "epk.bio1").slice(0, 155) + "…"
const thomannEpkUrl = thomannAffiliateUrl(THOMANN_HOME_URL, "epk")

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")

const members = [
  { name: "Wojciech Bator", roleKey: "band.roles.guitar" },
  { name: "Marek Bienias", roleKey: "band.roles.vocals" },
  { name: "Jakub Dąbrowski", roleKey: "band.roles.drums" },
  { name: "Lubomyr Kosakovsky", roleKey: "band.roles.bass" },
]
---

<Layout title={title} description={description} canonical={canonicalUrl} lang={lang}>
  <Fragment slot="head">
    {hreflangLinks.map((l) => <link rel={l.rel} hreflang={l.hreflang} href={l.href} />)}
  </Fragment>

  <div class="bg-zinc-950 min-h-screen flex flex-col">
    <Navbar lang={lang} displayLinks={true} activePage="epk" />
    <ScrollToTop />

    <main id="main-content" class="flex-1 pt-20">
      <div class="px-6 lg:px-12 pt-8 pb-16 lg:pb-24 max-w-5xl mx-auto">
        <header class="mb-12 pb-8 border-b border-zinc-800/60">
          <p class="text-xs font-bold uppercase tracking-[0.4em] text-amber-400 mb-3">{t(lang, "epk.sub")}</p>
          <h1 class="text-4xl lg:text-5xl font-black uppercase tracking-tight text-white">{t(lang, "epk.heading")}</h1>
        </header>

        <div class="grid lg:grid-cols-[1fr_280px] gap-12">
          <div class="space-y-10">
            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "epk.bioHeading")}</h2>
              <p class="text-zinc-300 leading-relaxed text-justify mobile-justify mb-4">{t(lang, "epk.bio1")}</p>
              <p class="text-zinc-300 leading-relaxed text-justify mobile-justify">{t(lang, "epk.bio2")}</p>
            </section>

            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">Quick facts</h2>
              <dl class="space-y-3 text-sm">
                <div class="flex gap-4">
                  <dt class="text-zinc-400 w-24 shrink-0">{t(lang, "epk.ffoLabel")}</dt>
                  <dd class="text-zinc-200">{t(lang, "epk.ffo")}</dd>
                </div>
                <div class="flex gap-4">
                  <dt class="text-zinc-400 w-24 shrink-0">{t(lang, "epk.styleLabel")}</dt>
                  <dd class="text-zinc-200">{t(lang, "epk.style")}</dd>
                </div>
              </dl>
            </section>

            <ManagerEcosystem lang={lang} />

            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "epk.releases")}</h2>
              <ul class="space-y-5">
                {items.map((item) => (
                  <li class="flex items-start gap-4">
                    <img src={`/covers/${item.src}`} alt={item.alt} width="48" height="48" loading="lazy" class="w-12 h-12 object-cover shrink-0" />
                    <div>
                      <a href={lp(lang, `/music/${slugify(item.title)}/`)} class="text-sm font-bold text-zinc-100 hover:text-amber-400 transition-colors">
                        {item.title}
                      </a>
                      <div class="flex gap-3 mt-1">
                        {item.link && <a href={item.link} target="_blank" rel="noreferrer" class="text-[10px] uppercase tracking-widest text-zinc-400 hover:text-amber-400 transition-colors">Spotify</a>}
                        {item.watch && <a href={item.watch} target="_blank" rel="noreferrer" class="text-[10px] uppercase tracking-widest text-zinc-400 hover:text-amber-400 transition-colors">YouTube</a>}
                        {item.buy && <a href={item.buy} target="_blank" rel="noreferrer" class="text-[10px] uppercase tracking-widest text-zinc-400 hover:text-amber-400 transition-colors">Bandcamp</a>}
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </section>

            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "epk.riderHeading")}</h2>
              <p class="text-sm text-zinc-400 mb-4">{t(lang, "epk.riderText")}</p>
              <a
                href="/techrider.pdf"
                download
                class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-2.5 border border-zinc-700 text-zinc-200 hover:border-amber-400/60 hover:text-amber-400 transition-colors"
              >
                {t(lang, "epk.riderDownload")}
              </a>
            </section>
          </div>

          <aside class="space-y-8">
            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "epk.lineup")}</h2>
              <ul class="space-y-3">
                {members.map(({ name, roleKey }) => (
                  <li class="border-l-2 border-amber-400/30 pl-3">
                    <p class="text-sm font-bold text-zinc-100">{name}</p>
                    <p class="text-[10px] uppercase tracking-widest text-zinc-400">{t(lang, roleKey)}</p>
                  </li>
                ))}
              </ul>
            </section>

            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">Partners</h2>
              <div class="space-y-3">
                <a href="https://www.davidlaboga.com/cables.html" target="_blank" rel="noopener noreferrer" class="block border-l-2 border-amber-400/40 pl-3 text-sm text-zinc-300 transition-colors hover:border-amber-400 hover:text-amber-400">
                  <strong class="block text-zinc-100">Laboga Cables</strong>
                  <span class="text-[10px] uppercase tracking-widest text-zinc-500">Cable endorsement</span>
                </a>
                <a href={thomannEpkUrl} target="_blank" rel="sponsored noopener noreferrer" class="block border-l-2 border-cyan-300/40 pl-3 text-sm text-zinc-300 transition-colors hover:border-cyan-300 hover:text-cyan-200">
                  <strong class="block text-zinc-100">Thomann</strong>
                  <span class="text-[10px] uppercase tracking-widest text-zinc-500">Premium Affiliate · pilot ↗</span>
                </a>
                <a href="/gear/" class="inline-flex min-h-11 items-center text-[10px] font-bold uppercase tracking-widest text-amber-400 transition-colors hover:text-amber-300">VIRYA gear →</a>
              </div>
            </section>

            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "epk.contact")}</h2>
              <div class="flex flex-col gap-1">
                <a href="mailto:virya.crew@gmail.com" class="text-sm text-amber-400 hover:text-amber-300 transition-colors">virya.crew@gmail.com</a>
                <a href="tel:+48574090338" class="text-sm text-zinc-400 hover:text-amber-400 transition-colors">+48 574 090 338 (Jakub)</a>
              </div>
            </section>

            <section>
              <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">{t(lang, "epk.links")}</h2>
              <div class="flex flex-col gap-2">
                <a href="https://www.instagram.com/virya.official" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  Instagram
                </a>
                <a href="https://www.youtube.com/@ViryaOfficial" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  YouTube
                </a>
                <a href="https://www.facebook.com/ViryaBand" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  Facebook
                </a>
                <a href="https://open.spotify.com/artist/6bbW0jOKAWJWm3h6CTWaAS" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  Spotify
                </a>
                <a href="https://virya.bandcamp.com" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  Bandcamp
                </a>
                <a href="https://soundcloud.com/viryaofficial" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  SoundCloud
                </a>
                <a href="https://x.com/viryaofficial" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  Twitter
                </a>
                <a href="https://drive.google.com/drive/folders/1M4pgB9goigGUm9tudcQIzORTgILgSABH?usp=drive_link" target="_blank" rel="noreferrer" class="border-l-2 border-zinc-700 hover:border-amber-400 pl-3 text-zinc-300 hover:text-amber-400 transition-colors">
                  Press Pack
                </a>
              </div>
            </section>
          </aside>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
