# Netlify security headers — applied to every response.
# https://docs.netlify.com/routing/headers/
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://i.ytimg.com; media-src 'self'; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://signal-api.virya.music; frame-src https://open.spotify.com https://js.stripe.com https://www.youtube-nocookie.com; form-action 'self'; frame-ancestors 'self'

# Merch pages — override CSP to allow InPost geowidget assets and its
# internal data:application/javascript, module pattern (web-component init).
/merch*
  Permissions-Policy: geolocation=(self "https://geowidget.inpost.pl"), camera=(), microphone=(), payment=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://i.ytimg.com https://*.inpost.pl; media-src 'self'; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' data: https://geowidget.inpost.pl; style-src 'self' 'unsafe-inline' https://geowidget.inpost.pl; connect-src 'self' https://*.inpost.pl https://signal-api.virya.music; frame-src https://open.spotify.com https://js.stripe.com https://geowidget.inpost.pl https://*.inpost.pl https://www.youtube-nocookie.com; form-action 'self'; frame-ancestors 'self'

/pl/merch*
  Permissions-Policy: geolocation=(self "https://geowidget.inpost.pl"), camera=(), microphone=(), payment=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://i.ytimg.com https://*.inpost.pl; media-src 'self'; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' data: https://geowidget.inpost.pl; style-src 'self' 'unsafe-inline' https://geowidget.inpost.pl; connect-src 'self' https://*.inpost.pl https://signal-api.virya.music; frame-src https://open.spotify.com https://js.stripe.com https://geowidget.inpost.pl https://*.inpost.pl https://www.youtube-nocookie.com; form-action 'self'; frame-ancestors 'self'

# CSP notes — sources allowed, and why:
#   img i.ytimg.com                   → video thumbnail posters (/videos)
#   img *.inpost.pl (merch only)      → geowidget picker imagery
#   script/style geowidget.inpost.pl  → InPost Paczkomat picker (merch only)
#   data: in script-src (merch only)  → geowidget web-component init creates data: module
#   connect *.inpost.pl               → geowidget API calls (merch only)
#   Bandsintown fetches are server-side only; no browser connect-src is required.
#   connect signal-api.virya.music    → lazy Virya Signal / CrowdRelay islands
#   frame geowidget/*.inpost.pl       → Paczkomat picker map iframe (merch only)
#   frame open.spotify.com            → artist embed player
#   frame js.stripe.com               → Stripe (checkout itself is a top-level redirect)
#   frame youtube-nocookie.com        → video embeds on /videos page
#   'unsafe-inline' script/style      → Astro inlines its runtime + critical CSS
# If a third party breaks, check the browser console for the blocked URL and add
# its origin to the matching directive.

# Private ticket capability pages: never cache or leak their URL as a referrer.
/tickets/*
  Cache-Control: no-store, private
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive

/pl/tickets/*
  Cache-Control: no-store, private
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive

/win
  Cache-Control: no-store, private
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive

/pl/win
  Cache-Control: no-store, private
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow, noarchive
