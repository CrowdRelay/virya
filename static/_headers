# Netlify security headers — applied to every response.
# https://docs.netlify.com/routing/headers/
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# A Content-Security-Policy is intentionally NOT enabled yet: it must be tested
# against the third parties this site uses (Stripe Checkout redirect, the InPost
# Geowidget at geowidget.inpost.pl, the Spotify embed at open.spotify.com, the
# Bandsintown fetch, and Netlify Forms). Starting template to validate, then
# uncomment under /* above:
#
#  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; media-src 'self'; script-src 'self' 'unsafe-inline' https://geowidget.inpost.pl; style-src 'self' 'unsafe-inline' https://geowidget.inpost.pl; connect-src 'self' https://*.inpost.pl https://rest.bandsintown.com; frame-src https://open.spotify.com https://js.stripe.com; frame-ancestors 'self'
